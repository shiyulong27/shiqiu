    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .astro-modal.hidden {
    display: none !important;
  }
  .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
  }
  .modal-card {
    position: relative;
    background: #0f172a;
    border: 1px solid rgba(147, 197, 253, 0.3);
    border-radius: 20px;
    width: 100%;
    max-width: 620px;
    max-height: 85vh;
    overflow-y: auto;
    padding: 2rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
