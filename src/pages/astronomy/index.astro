  :global(.quiz-opt-btn:hover:not(:disabled)) {
    background: rgba(51, 65, 85, 0.9);
    border-color: #60a5fa;
  }
  :global(.quiz-opt-btn.correct) {
    background: rgba(16, 185, 129, 0.25) !important;
    border-color: #10b981 !important;
    color: #6ee7b7 !important;
    font-weight: 700;
  }
  :global(.quiz-opt-btn.wrong) {
