---
import Base from '../../layouts/Base.astro'
import {
  ancientAstronomyData,
  modernConstellationsData,
  solarSystemData,
  deepSpaceData,
  deepSpaceObjects,
  stellarEvolution,
  cosmicScaleLadder,
  humanExploration,
  astronomyQuiz
} from '../../data/astronomyData.js'

const base = import.meta.env.BASE_URL
const { threeEnclosures, fourSymbols, ancientInnovations } = ancientAstronomyData
const { seasonalTriangles, zodiacList } = modernConstellationsData
const { planets, moonPhases, phenomena } = solarSystemData
---

<Base title="浩瀚星空与深空天文通识长卷 · 亲子星空探索天地" wide={true}>
  <div class="astro-container">
    <!-- 顶部全景导航与导言 -->
    <header class="astro-header">
      <div class="astro-nav-bar">
        <a href={base} class="astro-back-btn">← 返回【十丘】知识总门户</a>
        <div class="astro-nav-links">
          <a href={`${base}biology/`} class="astro-sub-nav">🌿 生命之树与真实动物图鉴</a>
          <a href={`${base}geography/nature/`} class="astro-sub-nav">🏔️ 自然地理与大江大河</a>
          <a href={`${base}science/`} class="astro-sub-nav">🚀 华夏科学与大国重器</a>
          <a href={`${base}chinese/solar-terms/`} class="astro-sub-nav">🌾 二十四节气</a>
          <a href={`${base}timeline/`} class="astro-sub-nav">📜 上下五千年长卷</a>
        </div>
      </div>

      <div class="astro-hero">
        <div class="astro-title-wrap">
          <span class="astro-badge">🌌 仰望星空 · 从三垣二十八宿到韦伯深空与恒星生死演化</span>
          <h1 class="astro-main-title">浩瀚星空与天文学通识长卷</h1>
          <p class="astro-subtitle">东方古代星宿 · 现代全天 88 星座 · 太阳系八大行星 · 韦伯/哈勃超清深空画廊 · 恒星演化六阶段与宇宙尺度</p>
        </div>

        <div class="astro-top-actions">
          <button id="btn-open-stargazing-guide" class="astro-btn astro-btn-cyan">
            <span class="btn-icon">🔭</span> 四季观星指南
          </button>
          <button id="btn-open-astro-quiz" class="astro-btn astro-btn-purple">
            <span class="btn-icon">🏆</span> 天文小院士挑战
          </button>
        </div>
      </div>

      <!-- 四重视角切换控制器 -->
      <div class="astro-controls-deck">
        <div class="astro-view-switcher">
          <button id="tab-ancient" class="astro-view-tab active" data-view="ancient">
            <span class="tab-icon">🌌</span> 东方古代星宿 (三垣二十八宿)
          </button>
          <button id="tab-modern" class="astro-view-tab" data-view="modern">
            <span class="tab-icon">🌟</span> 现代四季星座 (全天星空与黄道十二座)
          </button>
          <button id="tab-solar" class="astro-view-tab" data-view="solar">
            <span class="tab-icon">🪐</span> 太阳系与行星 (八大行星与月相实验室)
          </button>
          <button id="tab-deep" class="astro-view-tab" data-view="deep">
            <span class="tab-icon">🔭</span> 韦伯与深空 (真实摄影 · 恒星演化与尺度)
          </button>
        </div>
      </div>
    </header>

    <!-- 视角一：东方古代天文学长卷 (Ancient View) -->
    <section id="view-ancient" class="astro-section view-pane active">
      <div class="section-intro-banner">
        <h2>👑 东方星官体系：三垣二十八宿之天人合一</h2>
        <p>中国古人把浩瀚星空看作人间帝国的倒影。北天中央由三垣守护，黄道与赤道四周由苍龙、玄武、白虎、朱雀四象二十八宿巡行，融合了最深厚的中华农耕文明与浪漫神话！</p>
      </div>

      <!-- 1. 三垣展台 -->
      <div class="sub-block-title">
        <span class="block-num">01</span>
        <h3>中天帝阙 · 三垣环拱</h3>
      </div>
      <div class="enclosures-grid">
        {threeEnclosures.map(enc => (
          <div class="enclosure-card" id={`enc-${enc.id}`}>
            <div class="enc-header">
              <span class="enc-icon">{enc.icon}</span>
              <div class="enc-meta">
                <span class="enc-tag">{enc.tag}</span>
                <h4 class="enc-title">{enc.name} <small>({enc.pinyin})</small></h4>
                <span class="enc-alias">{enc.alias}</span>
              </div>
            </div>
            <div class="enc-body">
              <p class="enc-role">{enc.role}</p>
              <div class="enc-stars-box">
                <div class="enc-stars-label">🌟 核心主星与星官：</div>
                <div class="enc-stars-chips">
                  {enc.coreStars.map(star => (
                    <span class="star-chip">{star}</span>
                  ))}
                </div>
              </div>
              <div class="enc-folklore">
                <span class="folklore-badge">📜 观星天机</span>
                <p>{enc.folklore}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- 2. 四象二十八宿 -->
      <div class="sub-block-title" style="margin-top: 3rem;">
        <span class="block-num">02</span>
        <h3>四象巡天 · 二十八宿全景图谱</h3>
      </div>

      <!-- 四象筛选切换按钮 -->
      <div class="symbol-nav-deck">
        {fourSymbols.map((sym, idx) => (
          <button class={`symbol-nav-btn ${idx === 0 ? 'active' : ''}`} data-symbol={sym.id} style={`--accent-color: ${sym.color}`}>
            <span class="sym-btn-icon">{sym.icon}</span>
            <span class="sym-btn-name">{sym.name}</span>
            <span class="sym-btn-elem">({sym.element})</span>
          </button>
        ))}
      </div>

      <!-- 四象宿卡片容器 -->
      <div class="symbols-content-wrap">
        {fourSymbols.map((sym, idx) => (
          <div class={`symbol-section-box ${idx === 0 ? '' : 'hidden'}`} data-symbol-id={sym.id} style={`--sym-color: ${sym.color}`}>
            <div class="symbol-banner-head">
              <div class="sym-badge-row">
                <span class="sym-main-icon">{sym.icon}</span>
                <div>
                  <h4 class="sym-title">{sym.name} · {sym.direction}</h4>
                  <p class="sym-intro">{sym.intro}</p>
                </div>
              </div>
              <div class="sym-folklore-card">
                <strong>💡 天象名言：</strong> {sym.folklore}
              </div>
            </div>

            <!-- 7 宿卡片列阵 -->
            <div class="mansions-grid">
              {sym.mansions.map(m => (
                <div class="mansion-card"
                     data-name={m.name}
                     data-modern={m.modern}
                     data-meaning={m.meaning}
                     data-role={m.role}
                     data-symbol={sym.name}>
                  <div class="mansion-top">
                    <span class="mansion-name">{m.name}</span>
                    <span class="mansion-stars-count">{m.stars} 颗星</span>
                  </div>
                  <div class="mansion-modern">现代: {m.modern}</div>
                  <div class="mansion-meaning">{m.meaning}</div>
                  <div class="mansion-role">司掌: {m.role}</div>
                  <div class="mansion-click-hint">点击查看详卷 ➔</div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- 3. 古代四大观星发明与客星记录 -->
      <div class="sub-block-title" style="margin-top: 3.5rem;">
        <span class="block-num">03</span>
        <h3>华夏观星重器与客星文献千古奇迹</h3>
      </div>
      <div class="innovations-grid">
        {ancientInnovations.map(inv => (
          <div class="innovation-card">
            <div class="inv-top">
              <span class="inv-icon">{inv.icon}</span>
              <div>
                <span class="inv-period">{inv.period}</span>
                <h4 class="inv-title">{inv.title}</h4>
              </div>
            </div>
            <p class="inv-achieve"><strong>历史成就：</strong> {inv.achievement}</p>
            <div class="inv-highlight">
              <strong>✨ 科学硬核：</strong> {inv.highlight}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 视角二：现代四季星座与星空探索 (Modern View) -->
    <section id="view-modern" class="astro-section view-pane hidden">
      <div class="section-intro-banner">
        <h2>🌟 全天 88 星座与四季寻星路标</h2>
        <p>西方天文学将全天星空划分为 88 个星座。掌握春、夏、秋、冬标志性的几何图形与寻找北极星口诀，夜晚抬头仰望，整片星空就是你专属的天文大画布！</p>
      </div>

      <!-- 四季星空向导卡片 -->
      <div class="seasons-grid">
        {seasonalTriangles.map(season => (
          <div class="season-guide-card" style={`background: ${season.bgGrad}`}>
            <div class="season-head">
              <span class="season-title">{season.season}</span>
              <span class="season-months">{season.bestMonths}</span>
            </div>
            <h3 class="season-core-shape">{season.coreShape}</h3>
            
            <div class="season-stars-list">
              <div class="season-stars-title">🌟 核心标志性亮星：</div>
              {season.coreStars.map(s => (
                <div class="core-star-row">
                  <span class="star-name">{s.name}</span>
                  <span class="star-constel">({s.constel})</span>
                  <span class="star-color-badge" style={`color: ${s.color}`}>● {s.color}</span>
                  <span class="star-note">{s.note}</span>
                </div>
              ))}
            </div>

            <div class="season-steps-box">
              <div class="steps-title">🧭 亲子寻星四步法：</div>
              <ol class="steps-ol">
                {season.guideSteps.map(step => (
                  <li>{step}</li>
                ))}
              </ol>
            </div>
          </div>
        ))}
      </div>

      <!-- 北极星寻找秘诀展示板 -->
      <div class="polaris-special-board">
        <div class="polaris-badge">🧭 永不迷路的北方灯塔</div>
        <h3>北斗七星勺口寻北极星秘诀</h3>
        <p class="polaris-p">
          在北半球夜空，找到大熊座勺子形的北斗七星。将勺口朝外的两颗星——<strong>天璇</strong>向<strong>天枢</strong>连成一条直线，朝着勺口前方延长大约 <strong>5 倍</strong>的距离，就会碰到孤单闪耀的<strong>北极星 (Polaris)</strong>！它正好位于地轴正北方向，终夜指明北方！
        </p>
        <!-- 动态 SVG 星空连线与延长线图解 -->
        <div class="polaris-svg-wrap">
          <svg class="polaris-svg-chart" viewBox="0 0 640 210" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <filter id="star-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="3" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <marker id="arrow-gold" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto">
                <path d="M0,0 L0,6 L9,3 z" fill="#facc15" />
              </marker>
            </defs>

            <!-- 背景星尘小点 -->
            <circle cx="35" cy="45" r="1" fill="#fff" opacity="0.4" />
            <circle cx="95" cy="180" r="1.2" fill="#fff" opacity="0.5" />
            <circle cx="280" cy="30" r="1.5" fill="#fff" opacity="0.4" />
            <circle cx="360" cy="160" r="1" fill="#fff" opacity="0.3" />
            <circle cx="480" cy="185" r="1.2" fill="#fff" opacity="0.4" />
            <circle cx="580" cy="120" r="1" fill="#fff" opacity="0.5" />

            <!-- 北斗七星连线 (勺柄与勺身) -->
            <line x1="70" y1="105" x2="115" y2="85" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />
            <line x1="115" y1="85" x2="165" y2="75" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />
            <line x1="165" y1="75" x2="215" y2="95" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />

            <line x1="215" y1="95" x2="195" y2="160" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />
            <line x1="195" y1="160" x2="255" y2="165" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />
            <line x1="255" y1="165" x2="275" y2="100" stroke="#facc15" stroke-width="3" stroke-linecap="round" opacity="0.95" />
            <line x1="275" y1="100" x2="215" y2="95" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />

            <!-- 天璇->天枢 指向北极星的 5 倍延长线 (金色虚线与箭头) -->
            <line x1="275" y1="100" x2="535" y2="42" stroke="#facc15" stroke-width="2.5" stroke-dasharray="6,4" marker-end="url(#arrow-gold)" opacity="0.9" />

            <!-- 延长线距离刻度与标注 -->
            <rect x="365" y="52" width="96" height="24" rx="6" fill="rgba(15,23,42,0.85)" stroke="#facc15" stroke-width="1" />
            <text x="413" y="68" fill="#fde047" font-size="11" font-weight="bold" text-anchor="middle">5倍距离延长 ➔</text>

            <!-- 北斗七星各主星点 -->
            <circle cx="70" cy="105" r="5" fill="#38bdf8" filter="url(#star-glow)" />
            <text x="70" y="125" fill="#bae6fd" font-size="11" text-anchor="middle">摇光</text>
            <circle cx="115" cy="85" r="5" fill="#38bdf8" filter="url(#star-glow)" />
            <text x="115" y="70" fill="#bae6fd" font-size="11" text-anchor="middle">开阳</text>
            <circle cx="165" cy="75" r="5.5" fill="#38bdf8" filter="url(#star-glow)" />
            <text x="165" y="60" fill="#bae6fd" font-size="11" text-anchor="middle">玉衡</text>
            <circle cx="215" cy="95" r="4.5" fill="#38bdf8" filter="url(#star-glow)" />
            <text x="200" y="90" fill="#bae6fd" font-size="11" text-anchor="middle">天权</text>
            <circle cx="195" cy="160" r="5" fill="#38bdf8" filter="url(#star-glow)" />
            <text x="195" y="180" fill="#bae6fd" font-size="11" text-anchor="middle">天玑</text>
            <circle cx="255" cy="165" r="6.5" fill="#facc15" filter="url(#star-glow)" />
            <text x="255" y="185" fill="#fde047" font-size="12" font-weight="bold" text-anchor="middle">天璇 (基点)</text>
            <circle cx="275" cy="100" r="6.5" fill="#facc15" filter="url(#star-glow)" />
            <text x="290" y="118" fill="#fde047" font-size="12" font-weight="bold" text-anchor="start">天枢 (指向)</text>

            <!-- 北极星 (终点超强辉光) -->
            <circle cx="550" cy="38" r="14" fill="rgba(250, 204, 21, 0.2)" />
            <circle cx="550" cy="38" r="8" fill="#ffffff" filter="url(#star-glow)" />
            <circle cx="550" cy="38" r="4" fill="#fef08a" />
            <line x1="550" y1="20" x2="550" y2="56" stroke="#fef08a" stroke-width="1.5" opacity="0.8" />
            <line x1="532" y1="38" x2="568" y2="38" stroke="#fef08a" stroke-width="1.5" opacity="0.8" />
            <text x="550" y="70" fill="#ffffff" font-size="13" font-weight="800" text-anchor="middle">北极星 (Polaris)</text>
            <text x="550" y="86" fill="#fde047" font-size="10" text-anchor="middle">正北方 · 小熊座α</text>
          </svg>
        </div>

        <div class="polaris-rhyme">
          💡 顺口溜：认星先从北斗来，迎头五倍北极开；一年四季星斗转，指针正北定乾坤！
        </div>
      </div>

      <!-- 黄道十二星座图谱 -->
      <div class="sub-block-title" style="margin-top: 3.5rem;">
        <span class="block-num">04</span>
        <h3>黄道十二星座星图与神话</h3>
      </div>
      <div class="zodiac-grid">
        {zodiacList.map(z => (
          <div class="zodiac-card">
            <div class="zodiac-top">
              <span class="zodiac-icon">{z.icon}</span>
              <div>
                <h4 class="zodiac-name">{z.name} <small>{z.latin}</small></h4>
                <span class="zodiac-date">{z.date} · {z.element}</span>
              </div>
            </div>
            <div class="zodiac-star">🌟 主亮星：{z.star}</div>
            <p class="zodiac-story">{z.story}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 视角三：太阳系与深空奥秘实验室 (Solar & Deep Space View) -->
    <section id="view-solar" class="astro-section view-pane hidden">
      <div class="section-intro-banner">
        <h2>🪐 太阳系八大行星全景与深空奥秘实验室</h2>
        <p>以太阳为中心，八颗性格迥异的行星在引力作用下有序公转。通过动态月相模拟器、行星比例实验室和日月食演示，一览太阳系宏大史诗！</p>
      </div>

      <!-- 1. 动态月相模拟器 (Interactive Moon Phase Simulator) -->
      <div class="moon-simulator-deck">
        <div class="sim-header-row">
          <div>
            <span class="sim-badge">🌙 互动模拟实验室</span>
            <h3 class="sim-title">月相盈亏动态演变模拟器</h3>
            <p class="sim-subtitle">拖动下方农历日期滑块，观察月亮在太阳光照下的相位圆缺变换：</p>
          </div>
          <div class="sim-day-badge" id="moon-day-display">农历 初一 (朔日)</div>
        </div>

        <div class="sim-interactive-area">
          <div class="moon-stage-display">
            <div class="moon-sphere-container">
              <div id="moon-visual-sphere" class="moon-visual-sphere"></div>
            </div>
            <div class="moon-text-info">
              <div class="phase-icon-row">
                <span id="moon-icon-display" class="moon-icon-big">🌑</span>
                <h4 id="moon-name-display" class="moon-name-big">新月（朔）</h4>
              </div>
              <p id="moon-desc-display" class="moon-desc-text">
                月球转到太阳与地球之间，黑夜完全看不到月亮，农历每月初一。
              </p>
            </div>
          </div>

          <!-- 滑动条控制 -->
          <div class="moon-slider-wrap">
            <div class="slider-marks">
              <span>初一 (新月)</span>
              <span>初七 (上弦月)</span>
              <span>十五 (满月)</span>
              <span>廿二 (下弦月)</span>
              <span>三十 (晦)</span>
            </div>
            <input type="range" id="moon-phase-slider" min="1" max="30" value="1" step="1" class="moon-range-slider" />
          </div>
        </div>
      </div>

      <!-- 2. 八大行星展台 (Eight Planets Grid) -->
      <div class="sub-block-title" style="margin-top: 3.5rem;">
        <span class="block-num">05</span>
        <h3>太阳系八大行星详细数据图鉴 (点击卡片查看详卷)</h3>
      </div>
      <div class="planets-grid">
        {planets.map(p => (
          <div class="planet-card" data-planet-id={p.id} style={`--planet-color: ${p.color}`}>
            <div class="planet-avatar-box">
              <span class="planet-icon">{p.icon}</span>
            </div>
            <div class="planet-meta">
              <span class="planet-type">{p.type}</span>
              <h4 class="planet-name">{p.name} <small>({p.en})</small></h4>
              <div class="planet-params">
                <div><span>日距:</span> {p.distFromSun}</div>
                <div><span>公转:</span> {p.orbitalPeriod}</div>
                <div><span>大小:</span> {p.diameterRatio} 地球</div>
              </div>
              <p class="planet-highlight">{p.keyFeature}</p>
              <div class="planet-rhyme-tag">💡 {p.memoryRhyme}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- 3. 日月食与流星雨大解密 -->
      <div class="sub-block-title" style="margin-top: 3.5rem;">
        <span class="block-num">06</span>
        <h3>奇妙天文天象大解密</h3>
      </div>
      <div class="phenomena-grid">
        {phenomena.map(item => (
          <div class="phenomenon-card">
            <div class="pheno-top">
              <span class="pheno-icon">{item.icon}</span>
              <h4 class="pheno-title">{item.title}</h4>
            </div>
            <p class="pheno-cause"><strong>成因机理：</strong> {item.cause}</p>
            <div class="pheno-types">
              <strong>✨ 奇趣观察：</strong> {item.types}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 视角四：韦伯与深空真实画廊、恒星演化与宇宙尺度 (Deep Space View) -->
    <section id="view-deep" class="astro-section view-pane hidden">
