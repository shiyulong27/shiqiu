<script>
  // 纯客户端极速筛选与检索
  const searchInput = document.getElementById('group-search') as HTMLInputElement | null
  const catPills = [...document.querySelectorAll('.cat-pill')] as HTMLButtonElement[]
  const cards = [...document.querySelectorAll('.group-card')] as HTMLElement[]
  const countEl = document.getElementById('result-count')
  const emptyEl = document.getElementById('empty-state')

  let currentCategory = '全部'
  let currentKeyword = ''

  function applyFilter() {
    let visibleCount = 0

    cards.forEach((card) => {
      const cat = card.dataset.category || ''
      const searchIndex = card.dataset.search || ''

      const matchesCat = currentCategory === '全部' || cat === currentCategory
      const matchesKeyword = !currentKeyword || searchIndex.includes(currentKeyword)

      const isVisible = matchesCat && matchesKeyword
      card.hidden = !isVisible

      if (isVisible) {
        visibleCount++
      }
    })

    if (countEl) {
      countEl.textContent = `展示 ${visibleCount} 组天团${currentCategory !== '全部' ? `（${currentCategory}赛道）` : ''}`
    }

    if (emptyEl) {
      emptyEl.hidden = visibleCount > 0
    }
  }

  // 赛道切换点击监听
  catPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      catPills.forEach((p) => {
        p.classList.remove('is-active')
        p.setAttribute('aria-selected', 'false')
      })
      pill.classList.add('is-active')
      pill.setAttribute('aria-selected', 'true')
      currentCategory = pill.dataset.cat || '全部'
      applyFilter()
    })
  })

  // 搜索输入监听
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentKeyword = (e.target as HTMLInputElement).value.trim().toLowerCase()
      applyFilter()
    })
  }
</script>
