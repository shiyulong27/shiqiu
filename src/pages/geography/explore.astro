  }
  .fp-item-btn.checked {
    background: #dcfce7;
    border-color: #86efac;
    color: #15803d;
    font-weight: 700;
  }

  /* 猜省挑战答题 */
  .quiz-card {
    max-width: 540px;
  }
  .quiz-question-box {
    margin: 1.25rem 0;
  }
  .quiz-q-num {
