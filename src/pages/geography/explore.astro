    padding: 0.75rem;
    margin-top: 1rem;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-size: 1.4rem;
    font-weight: 900;
    color: #059669;
  }
  .stat-lbl {
    font-size: 0.75rem;
    color: #64748b;
  }
  .footprint-provinces-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 0.5rem;
    overflow-y: auto;
    margin-top: 0.8rem;
    padding-right: 0.3rem;
  }
  .fp-item-btn {
    padding: 0.5rem;
    border: 1px solid #e2e8f0;
