            const st = params.data.stationData
            return `
              <div style="font-size:13px;line-height:1.5;">
                <strong style="color:#0284c7;font-size:14px;">🌊 ${st.name}</strong><br/>
                城市/区位：<b>${st.city}</b> · ${st.elevation}<br/>
                亮点：<b>${st.highlight}</b><br/>
                <span style="color:#ea580c;font-family:serif;">“${st.poem.quote}”</span><br/>
                <span style="font-size:11px;color:#64748b;">(点击航标展开详情长卷)</span>
              </div>
            `
          }
          if (params.data?.mountainData) {
            const m = params.data.mountainData
            return `
              <div style="font-size:13px;line-height:1.5;">
                <strong style="color:#059669;font-size:14px;">⛰️ ${m.title}</strong><br/>
                所在省份：<b>${m.province}</b> (${m.city}) · 高度：${m.altitude}<br/>
                亮点：<b>${m.highlight}</b><br/>
                <span style="color:#ea580c;font-family:serif;">“${m.poem.quote}”</span><br/>
                <span style="font-size:11px;color:#64748b;">(点击图钉展开详情长卷)</span>
              </div>
            `
          }
          const prov = chinaGeographyData.find(p => p.name === params.name || params.name.includes(p.shortName))
          if (!prov) return params.name
          return `
            <div style="font-size:13px;line-height:1.5;">
              <strong style="color:${prov.themeColor};font-size:14px;">${prov.name} (${prov.abbr})</strong><br/>
              省会/首府：<b>${prov.capital}</b> · ${prov.region}大区<br/>
              <em>“${prov.tagline}”</em><br/>
              地标：${prov.landmarks[0]?.name || ''} · 特产：${prov.specialties[0]?.name || ''}
            </div>
          `
        }
      },
      geo: {
        map: 'china',
        roam: true,
        zoom: 1.18,
        center: [104.5, 36.5],
        label: {
          show: false
        },
        itemStyle: {
          borderColor: '#ffffff',
          borderWidth: 1
        },
        regions: mapData
      },
      series: seriesList
    }

    chartInstance.setOption(option, true)
  }

  // 渲染右侧通识长卷
  function renderProvinceDetail(p: any) {
    const sealEl = document.getElementById('prov-seal')
    if (sealEl) {
      sealEl.innerText = p.abbr.split('/')[0].trim()
      sealEl.style.background = p.themeColor
    }
    const nameEl = document.getElementById('prov-name')
    if (nameEl) nameEl.innerText = p.name

    const adminEl = document.getElementById('prov-admin-type')
    if (adminEl) adminEl.innerText = `🏛️ ${p.adminType || '省'}`

    const capEl = document.getElementById('prov-capital')
    if (capEl) capEl.innerText = `${p.adminType === '直辖市' ? '核心区' : '省会/首府'}：${p.capital}`

    const regEl = document.getElementById('prov-region')
    if (regEl) regEl.innerText = `${p.region}大区`

    const statusEl = document.getElementById('prov-status-badges')
    if (statusEl) {
      statusEl.innerHTML = (p.statusBadges || []).map((b: string) => `
        <span class="status-badge-chip">${b}</span>
      `).join('')
    }

    const tagEl = document.getElementById('prov-tagline')
    if (tagEl) tagEl.innerText = p.tagline

    const originEl = document.getElementById('prov-name-origin')
    if (originEl) originEl.innerText = p.nameOrigin || '暂无溯源考据'

    const introEl = document.getElementById('prov-intro')
    if (introEl) introEl.innerText = p.intro

    // 四大硬核指标解析
    function extractMetric(raw: any, fallbackMain = '详见正文', fallbackSub = '') {
      if (!raw) return { main: fallbackMain, sub: fallbackSub }
      if (typeof raw === 'string') {
        const parenIdx = raw.indexOf('(')
        if (parenIdx !== -1) {
          return {
            main: raw.slice(0, parenIdx).trim(),
            sub: raw.slice(parenIdx + 1).replace(')', '').trim()
          }
        }
        return { main: raw.trim(), sub: fallbackSub }
      }
      return {
        main: raw.amount || raw.count || raw.main || fallbackMain,
        sub: raw.ranking || raw.summary || raw.sub || fallbackSub
      }
    }

    const popData = extractMetric(p.population, '适度体量', '常住人口')
    const popValEl = document.getElementById('prov-stat-population')
    if (popValEl) popValEl.innerText = popData.main
    const popRankEl = document.getElementById('prov-stat-pop-rank')
    if (popRankEl) popRankEl.innerText = popData.sub

    const areaData = extractMetric(p.area, '广袤辽阔', '管辖陆地面积')
    const areaValEl = document.getElementById('prov-stat-area')
    if (areaValEl) areaValEl.innerText = areaData.main
    const areaPctEl = document.getElementById('prov-stat-area-pct')
    if (areaPctEl) areaPctEl.innerText = areaData.sub

    const ethCountEl = document.getElementById('prov-stat-ethnic-count')
    if (ethCountEl) {
      ethCountEl.innerText = (typeof p.ethnicGroups === 'object' && p.ethnicGroups.count)
        ? p.ethnicGroups.count
        : (typeof p.ethnicGroups === 'string' ? p.ethnicGroups : '多民族聚居')
    }
    const ethDescEl = document.getElementById('prov-stat-ethnic-desc')
    if (ethDescEl) {
      let ethSub = '各民族交融共居'
      if (typeof p.ethnicGroups === 'object') {
        ethSub = p.ethnicGroups.summary || (p.ethnicGroups.mainGroups || []).slice(0, 3).join(' · ') || ethSub
      }
      ethDescEl.innerText = ethSub
    }

    const climTypeEl = document.getElementById('prov-stat-climate-type')
    if (climTypeEl) {
      const cType = p.climateProfile?.type || p.climate || '气候宜人'
      climTypeEl.innerText = cType.length > 20 ? cType.slice(0, 18) + '...' : cType
    }
    const climFeelEl = document.getElementById('prov-stat-climate-feel')
    if (climFeelEl) {
      climFeelEl.innerText = p.climateProfile?.realFeel || p.climate || ''
    }

    // 🌟 灵魂特征看板 (3个核心鲜明特质卡片)
    const soulGrid = document.getElementById('prov-soul-features')
    if (soulGrid) {
      soulGrid.innerHTML = (p.coreFeatures || []).map((feat: any) => `
        <div class="soul-feature-card">
          <span class="soul-feature-tag">${feat.icon || '🌟'} ${feat.title}</span>
          <h4 class="soul-feature-title">${feat.subtitle || feat.title}</h4>
          <p class="soul-feature-desc">${feat.desc}</p>
        </div>
      `).join('')
    }

    // ⚖️ 山河为界与省界溯源典故 (层次一：省份内嵌)
    const bh = p.boundaryHeritage || {}
    const bTypeEl = document.getElementById('prov-boundary-type')
    if (bTypeEl) bTypeEl.innerText = bh.divideType || '山川为界'
    const bTitleEl = document.getElementById('prov-boundary-title')
    if (bTitleEl) bTitleEl.innerText = bh.divideName || `${p.name}边界山川`

    const bChipsEl = document.getElementById('prov-boundary-chips')
    if (bChipsEl) {
      bChipsEl.innerHTML = (bh.borderRiversMountains || []).map((rm: string) => `
