    const bannerBoundaryBtn = document.getElementById('prov-banner-boundary-btn')
    if (bannerBoundaryBtn) {
      bannerBoundaryBtn.innerText = `展卷【${matchedThemeName}】专题 ➔`
    }

    ;(window as any).currentMatchedThemeKey = matchedThemeKey

    // 🌤️ 气候环境与自然地貌极值
    const climSumEl = document.getElementById('prov-climate-summary')
    if (climSumEl) climSumEl.innerText = `${p.climateProfile?.type || p.climate} · 年均温 ${p.climateProfile?.annualAvgTemp || '适宜'} · 年降水 ${p.climateProfile?.annualPrecipitation || '充沛'}`
    const climFEl = document.getElementById('prov-climate-feel')
    if (climFEl) climFEl.innerText = `🌡️ 真实体感：${p.climateProfile?.realFeel || p.climate}`
    const climDetEl = document.getElementById('prov-climate-details')
    if (climDetEl) climDetEl.innerText = p.climateProfile?.seasonalDetail || ''

    const terScaleEl = document.getElementById('prov-terrain-scale')
    if (terScaleEl) terScaleEl.innerText = `${p.terrainProfile?.ladder || '多阶梯过渡'} · 主地貌: ${p.terrainProfile?.dominant || p.terrain}`
    const peakEl = document.getElementById('prov-highest-peak')
    if (peakEl) peakEl.innerText = p.terrainProfile?.extremes?.highest || '待补充'
    const lowestEl = document.getElementById('prov-lowest-point')
    if (lowestEl) lowestEl.innerText = p.terrainProfile?.extremes?.lowest || '待补充'

    const rivEl = document.getElementById('prov-major-rivers')
    if (rivEl) {
      rivEl.innerHTML = (p.terrainProfile?.majorRivers || []).map((r: string) => `
        <span class="geo-name-chip">💧 ${r}</span>
      `).join('')
    }

    const mntEl = document.getElementById('prov-major-mountains')
    if (mntEl) {
      mntEl.innerHTML = (p.terrainProfile?.majorMountains || []).map((m: string) => `
        <span class="geo-name-chip">⛰️ ${m}</span>
      `).join('')
    }

    // 🏭 经济与大国重器
    const econGdpEl = document.getElementById('prov-econ-gdp')
    if (econGdpEl) econGdpEl.innerHTML = `<strong>GDP体量位次：</strong>${p.economicProfile?.gdpRank || '区域核心'}`

    const econIndEl = document.getElementById('prov-econ-industries')
    if (econIndEl) {
      econIndEl.innerHTML = (p.economicProfile?.pillarIndustries || []).map((ind: string) => `
        <span class="econ-chip">🏭 ${ind}</span>
      `).join('')
    }

    const econProjEl = document.getElementById('prov-econ-projects')
    if (econProjEl) {
      econProjEl.innerHTML = (p.economicProfile?.superProjects || []).map((proj: string) => `
        <div class="econ-project-item">
          🚀 <b>${proj}</b>
        </div>
      `).join('')
    }

    // 地标网格
    const lmGrid = document.getElementById('prov-landmarks-grid')
    if (lmGrid) {
      lmGrid.innerHTML = (p.landmarks || []).map((l: any) => `
        <div class="landmark-card">
          <div class="lm-icon">${l.icon || '🏯'}</div>
          <div class="lm-content">
            <div class="lm-name">${l.name}</div>
            <span class="lm-tag">${l.type}</span>
            <p class="lm-desc">${l.desc}</p>
          </div>
        </div>
      `).join('')
    }

    // 特产网格
    const spGrid = document.getElementById('prov-specialties-grid')
    if (spGrid) {
      spGrid.innerHTML = (p.specialties || []).map((s: any) => `
        <div class="specialty-card">
          <div class="sp-icon">${s.icon || '🍲'}</div>
          <div class="sp-content">
            <div class="sp-name">${s.name}</div>
            <span class="sp-tag">${s.type}</span>
            <p class="sp-desc">${s.desc}</p>
          </div>
        </div>
      `).join('')
    }

    // 文化名人
    const figWrap = document.getElementById('prov-figures-tags')
    if (figWrap) {
