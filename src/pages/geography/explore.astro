  .thematic-compare-card {
    background: #fff;
    border: 1px solid #fed7aa;
    border-radius: 1rem;
    padding: 1.25rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    min-width: 0;
    box-sizing: border-box;
