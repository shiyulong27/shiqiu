  const btnOpenFp = document.getElementById('btn-open-footprints')
  const fpModal = document.getElementById('footprints-modal')

  btnOpenFp?.addEventListener('click', () => {
    renderFootprintMatrix()
    fpModal!.style.display = 'flex'
