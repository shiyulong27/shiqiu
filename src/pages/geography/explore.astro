    flex-direction: column;
    gap: 0.85rem;
  }
  .puzzle-metaphor-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
    border: 1px solid #ddd6fe;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .puzzle-metaphor-icon {
    font-size: 2.2rem;
  }
  .puzzle-metaphor-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: #5b21b6;
  }
  .puzzle-riddle-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.6;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
  }
  .puzzle-clue-box {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 0.5rem;
