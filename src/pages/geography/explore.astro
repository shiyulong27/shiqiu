      </div>
    `
  }

  btnOpenQuiz?.addEventListener('click', () => {
    resetQuizUI()
    generateQuizQuestions()
    quizIndex = 0
    quizScore = 0
    renderCurrentQuiz()
    quizModal!.style.display = 'flex'
  })

  ;(window as any).closeQuizModal = function() {
    quizModal!.style.display = 'none'
  }

  function generateQuizQuestions() {
    const questions: any[] = []
    const shuffled = [...chinaGeographyData].sort(() => Math.random() - 0.5)

    function getDistractors(targetProv: any, count = 3) {
      return chinaGeographyData
        .filter(p => p.id !== targetProv.id)
        .sort(() => Math.random() - 0.5)
        .slice(0, count)
        .map(p => p.name)
    }

    // 题型 1: 灵魂特征 (用户核心关心的“省份特点”)
    const prov1 = shuffled[0]
    const feat = (prov1.coreFeatures && prov1.coreFeatures.length > 0)
      ? prov1.coreFeatures[Math.floor(Math.random() * prov1.coreFeatures.length)]
      : { title: prov1.tagline, desc: prov1.intro }
    const dist1 = getDistractors(prov1, 3)
    const options1 = [prov1.name, ...dist1].sort(() => Math.random() - 0.5)
    questions.push({
      question: `【${feat.title}】“${feat.desc.slice(0, 75)}...” 这是我国哪个省/市/自治区的鲜明地理特质？`,
      options: options1,
      answer: prov1.name,
      explain: `${prov1.name}（简称“${prov1.abbr}”，${prov1.adminType}）。${prov1.tagline}`
    })

    // 题型 2: 省名溯源考据与历史人文
    const prov2 = shuffled[1]
    const dist2 = getDistractors(prov2, 3)
    const options2 = [prov2.name, ...dist2].sort(() => Math.random() - 0.5)
    questions.push({
      question: `关于省名溯源：“${(prov2.nameOrigin || prov2.intro).slice(0, 80)}...”，这段历史渊源记载的是哪个行政区？`,
      options: options2,
      answer: prov2.name,
      explain: `${prov2.name}：${prov2.nameOrigin || prov2.intro}`
    })

    // 题型 3: 地形地貌极值与骨干山川水系
    const prov3 = shuffled[2]
    const dist3 = getDistractors(prov3, 3)
    const options3 = [prov3.name, ...dist3].sort(() => Math.random() - 0.5)
    const peak = prov3.terrainProfile?.extremes?.highest || '名峰'
    const ladder = prov3.terrainProfile?.ladder || '多阶梯过渡'
    const river = (prov3.terrainProfile?.majorRivers && prov3.terrainProfile.majorRivers[0]) || '干流水系'
    questions.push({
      question: `地貌处于“${ladder}”，最高峰为“${peak}”，主要干流水系包括“${river}”的是我国哪个行政区？`,
      options: options3,
      answer: prov3.name,
      explain: `${prov3.name}最高峰为${peak}，主要山脉有${prov3.terrainProfile?.majorMountains?.slice(0, 2).join('、')}，流经${river}。`
    })

    // 题型 4: 大国重器超级工程与经济支柱
    const prov4 = shuffled[3]
    const dist4 = getDistractors(prov4, 3)
    const options4 = [prov4.name, ...dist4].sort(() => Math.random() - 0.5)
    const superProj = (prov4.economicProfile?.superProjects && prov4.economicProfile.superProjects[0]) || '国家超级工程'
    const indus = (prov4.economicProfile?.pillarIndustries && prov4.economicProfile.pillarIndustries.slice(0, 2).join('、')) || '优势产业'
    questions.push({
      question: `拥有“${superProj}”等国之重器，重点支柱产业涵盖“${indus}”的是哪个行政区？`,
      options: options4,
      answer: prov4.name,
      explain: `${prov4.name}经济实力雄厚（${prov4.economicProfile?.gdpRank}），布局有${superProj}等超级重器！`
    })

    // 题型 5: 统编课本名篇与名胜地标
    const prov5 = shuffled[4]
    const dist5 = getDistractors(prov5, 3)
    const options5 = [prov5.name, ...dist5].sort(() => Math.random() - 0.5)
    const lm = (prov5.landmarks && prov5.landmarks[0]) ? prov5.landmarks[0].name : prov5.capital
    const poem = (prov5.relatedPoems && prov5.relatedPoems[0])
      ? `课本诗词名句“${prov5.relatedPoems[0].quote}”（《${prov5.relatedPoems[0].title}》）`
      : `著名风物特产“${prov5.specialties[0]?.name || '非遗名吃'}”`
    questions.push({
      question: `拥有名胜地标“${lm}”，且与${poem}紧密相连的是哪个省份？`,
      options: options5,
      answer: prov5.name,
      explain: `${prov5.name}地标有${lm}，风物特产如${prov5.specialties?.slice(0, 2).map((s: any) => s.name).join('、')}，山河锦绣！`
    })

    quizQuestions = questions
  }

  function renderCurrentQuiz() {
    const q = quizQuestions[quizIndex]
    document.getElementById('quiz-q-index')!.innerText = `第 ${quizIndex + 1} / ${quizQuestions.length} 题`
    document.getElementById('quiz-q-text')!.innerText = q.question
    document.getElementById('quiz-feedback')!.style.display = 'none'
    document.getElementById('btn-next-quiz')!.style.display = 'none'

    const optContainer = document.getElementById('quiz-options')!
    optContainer.innerHTML = q.options.map((opt: string) => `
      <button class="quiz-option-btn" onclick="window.checkQuizAnswer('${opt}')">
        ${opt}
      </button>
    `).join('')
  }

  ;(window as any).checkQuizAnswer = function(chosen: string) {
    const q = quizQuestions[quizIndex]
    const isRight = chosen === q.answer
    if (isRight) quizScore++

    document.querySelectorAll('.quiz-option-btn').forEach((btn: any) => {
      btn.disabled = true
      if (btn.innerText.trim() === q.answer) btn.classList.add('correct')
      else if (btn.innerText.trim() === chosen && !isRight) btn.classList.add('wrong')
    })

    const fb = document.getElementById('quiz-feedback')!
    fb.style.display = 'block'
    if (isRight) {
      fb.className = 'quiz-feedback-box correct'
      fb.innerHTML = `🎉 恭喜回答正确！${q.explain}`
    } else {
      fb.className = 'quiz-feedback-box wrong'
      fb.innerHTML = `💡 回答错误哦！正确答案是【${q.answer}】。${q.explain}`
    }

    const nextBtn = document.getElementById('btn-next-quiz')!
    nextBtn.style.display = 'block'
    if (quizIndex === quizQuestions.length - 1) {
      nextBtn.innerText = `查看挑战成果 🏆`
    } else {
      nextBtn.innerText = `下一题 ➔`
    }
  }

  ;(window as any).nextQuizQuestion = function() {
    quizIndex++
    if (quizIndex < quizQuestions.length) {
      renderCurrentQuiz()
    } else {
      // 挑战完成
      const container = document.getElementById('quiz-container')!
      let honorRank = '华夏地理小榜样'
      if (quizScore === 5) honorRank = '👑 华夏地理通识状元郎 (全对满分！)'
      else if (quizScore >= 4) honorRank = '🌟 华夏河山探秘小博学士'
      else if (quizScore >= 3) honorRank = '🚀 华夏地理初探先锋'

      container.innerHTML = `
        <div style="text-align:center;padding:1.5rem 0;">
          <div style="font-size:3rem;margin-bottom:0.5rem;">🎉</div>
          <h4 style="font-size:1.3rem;font-weight:900;color:#1e293b;margin:0 0 0.5rem;">挑战完成！</h4>
          <div style="display:inline-block;background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;font-size:0.85rem;font-weight:700;padding:2px 10px;border-radius:9999px;margin-bottom:0.5rem;">${honorRank}</div>
          <p style="font-size:1.05rem;color:#059669;font-weight:bold;margin:0.3rem 0;">乐乐与月亮总共答对 ${quizScore} / ${quizQuestions.length} 题！</p>
          <p style="font-size:0.85rem;color:#64748b;">34 个省区市的灵魂特征、省名溯源与地理极值已经掌握在心中啦！</p>
          <div style="display:flex;gap:0.75rem;justify-content:center;margin-top:1.25rem;">
            <button class="btn-quiz-next" style="width:auto;padding:0.6rem 1.4rem;" onclick="window.restartQuizGame()">再测一轮 🔄</button>
            <button class="btn-quiz-next" style="width:auto;padding:0.6rem 1.4rem;background:#475569;" onclick="window.closeQuizModal()">完成挑战 🇨🇳</button>
          </div>
        </div>
      `
    }
  }

  ;(window as any).restartQuizGame = function() {
    resetQuizUI()
    generateQuizQuestions()
    quizIndex = 0
    quizScore = 0
    renderCurrentQuiz()
  }

