  /* ══════════════════════════════════════════════════
     层次二：华夏地理分界与名水大泊全景专题长卷 CSS
     ══════════════════════════════════════════════════ */
  .thematic-detail-sheet {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
    max-width: 100%;
    overflow-x: hidden;
  }

  .thematic-banner {
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 2px solid #fdba74;
    border-radius: 1.25rem;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 4px 12px rgba(234, 88, 12, 0.08);
    min-width: 0;
    box-sizing: border-box;
  }
  .thematic-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .thematic-badge-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .thematic-kicker {
    display: inline-block;
    background: #ea580c;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 9999px;
