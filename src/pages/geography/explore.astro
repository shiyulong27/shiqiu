<script>
  import * as echarts from 'echarts'
  import chinaGeo from '../../../data/geography/china_geo.json'
  import { chinaGeographyData } from '../../data/chinaGeographyData.js'
  import { yangtzeData, yellowRiverData, mountainsData } from '../../data/chinaRiversMountainsData.js'
  import { boundaryThemesData, mountainBoundariesData } from '../../data/chinaGeographyBoundariesData.js'
  import { provincePuzzleCards } from '../../data/provincePuzzleData.js'

  // 注册中国矢量底图
  echarts.registerMap('china', chinaGeo as any)

  // 全局响应式状态
  let currentProvinceId = 'sichuan'
  let currentRegionFilter = '全部大区'
  let currentViewMode = 'all'
  let currentLayer = 'provinces' // 'provinces' | 'yangtze' | 'yellow' | 'mountains'
  let chartInstance: echarts.ECharts | null = null

  // 足迹持久化
  function getFootprints() {
    try {
      return JSON.parse(localStorage.getItem('shiqiu_geo_footprints') || '{}')
    } catch {
      return {}
    }
  }

  function saveFootprints(data: any) {
    try {
      localStorage.setItem('shiqiu_geo_footprints', JSON.stringify(data))
    } catch {}
  }

  // 初始化地图
  function initChart() {
    const chartDom = document.getElementById('china-explore-map')
    if (!chartDom) return

    chartInstance = echarts.init(chartDom)
    updateChart()

    chartInstance.on('click', (params: any) => {
      // 1. 如果点击的是站点或名山
      if (params.data && params.data.stationData) {
        showStationModal(params.data.stationData, currentLayer === 'yangtze' ? 'yangtze' : 'yellow')
        return
      }
      if (params.data && params.data.mountainData) {
        showMountainModal(params.data.mountainData)
        return
      }

      // 2. 如果点击的是省份地图区域
      if (params.name) {
        const found = chinaGeographyData.find(p => p.name === params.name || p.shortName === params.name || params.name.includes(p.shortName))
        if (found) {
          (window as any).switchProvince(found.id)
        }
      }
    })

    window.addEventListener('resize', () => {
      chartInstance?.resize()
    })
  }

  // 刷新地图着色
  function updateChart() {
    if (!chartInstance) return

    const regionsColorMap: Record<string, string> = {
      '华北': '#f97316',
      '东北': '#0284c7',
      '华东': '#0d9488',
      '华中': '#e11d48',
      '华南': '#10b981',
      '西南': '#8b5cf6',
      '西北': '#d97706',
      '港澳台': '#ec4899'
    }

    const currentProv = chinaGeographyData.find(p => p.id === currentProvinceId) || chinaGeographyData[0]

    // 根据当前图层决定省份区域透明度与底色
    const mapData = chinaGeographyData.map(p => {
      const isSelected = p.id === currentProvinceId
      const matchRegion = currentRegionFilter === '全部大区' || p.region === currentRegionFilter

      let areaColor = regionsColorMap[p.region] || '#cbd5e1'
      let opacity = matchRegion ? 0.75 : 0.15
      let borderColor = '#ffffff'
      let borderWidth = 1

      if (currentLayer !== 'provinces') {
        // 在江河或名山漫游图层下，采用更沉稳的水墨淡底色以衬托江河山川流光
        areaColor = '#f1f5f9'
        opacity = 0.85
        borderColor = '#cbd5e1'
        borderWidth = 0.8

        // 轻度高亮相关流经省份
        if (currentLayer === 'yangtze' && yangtzeData.provincesList.includes(p.shortName)) {
          areaColor = '#e0f2fe'
          opacity = 0.95
          borderColor = '#7dd3fc'
        } else if (currentLayer === 'yellow' && yellowRiverData.provincesList.includes(p.shortName)) {
          areaColor = '#fef3c7'
          opacity = 0.95
          borderColor = '#fcd34d'
        } else if (currentLayer === 'mountains' && mountainsData.some(m => m.provinceId === p.id)) {
          areaColor = '#ecfdf5'
          opacity = 0.95
          borderColor = '#6ee7b7'
        } else if (currentLayer === 'qinling_huaihe' && boundaryThemesData.qinling_huaihe.provincesList.includes(p.shortName)) {
          areaColor = '#ffedd5'
          opacity = 0.95
          borderColor = '#fb923c'
          borderWidth = 1.5
        } else if (currentLayer === 'lianghu_divide' && boundaryThemesData.lianghu_divide.provincesList.includes(p.shortName)) {
          areaColor = '#e0f2fe'
          opacity = 0.95
          borderColor = '#38bdf8'
          borderWidth = 1.5
        } else if (currentLayer === 'liangguang_divide' && boundaryThemesData.liangguang_divide.provincesList.includes(p.shortName)) {
          areaColor = '#ecfdf5'
          opacity = 0.95
          borderColor = '#34d399'
          borderWidth = 1.5
        } else if (currentLayer === 'major_lakes' && boundaryThemesData.major_lakes.provincesList.includes(p.shortName)) {
          areaColor = '#f0fdfa'
          opacity = 0.95
          borderColor = '#2dd4bf'
          borderWidth = 1.5
        }
      } else if (isSelected) {
        areaColor = '#dc2626'
        opacity = 1
        borderColor = '#fde047'
        borderWidth = 2.5
      }

      return {
        name: p.name,
        value: p.capital,
        itemStyle: {
          areaColor,
          opacity,
          borderColor,
          borderWidth
