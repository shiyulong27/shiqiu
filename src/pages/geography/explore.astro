  }
  .quiz-feedback-box {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .quiz-feedback-box.correct {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }
  .quiz-feedback-box.wrong {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
  .btn-quiz-next {
    margin-top: 1rem;
    padding: 0.6rem 1.25rem;
    background: #ea580c;
