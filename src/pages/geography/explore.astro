    const bDetailEl = document.getElementById('prov-boundary-detail')
    if (bDetailEl) bDetailEl.innerText = bh.heritageDetail || p.intro

    // 匹配对应的主题专题
    let matchedThemeKey = 'qinling_huaihe'
    let matchedThemeName = '南北分界'
    if (['hunan', 'hubei'].includes(p.id) || bh.divideType?.includes('两湖') || bh.divideName?.includes('两湖')) {
      matchedThemeKey = 'lianghu_divide'
      matchedThemeName = '两湖分野'
    } else if (['guangdong', 'guangxi'].includes(p.id) || bh.divideType?.includes('两广') || bh.divideName?.includes('两广')) {
      matchedThemeKey = 'liangguang_divide'
