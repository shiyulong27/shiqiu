    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .puzzle-feedback.correct {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }
  .puzzle-feedback.wrong {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
  .btn-puzzle-next {
    margin-top: 0.8rem;
    padding: 0.7rem 1.5rem;
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
