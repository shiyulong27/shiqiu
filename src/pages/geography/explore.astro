  ;(window as any).closeFootprintsModal = function() {
    fpModal!.style.display = 'none'
  }

  function renderFootprintMatrix() {
    const fps = getFootprints()
    const count = Object.keys(fps).length
    const pct = Math.round((count / 34) * 100)

    document.getElementById('stat-visited-count')!.innerText = `${count} / 34`
    document.getElementById('stat-visited-pct')!.innerText = `${pct}%`

    let badge = '华夏初探者'
    if (count >= 30) badge = '👑 华夏全通探险大宗师'
    else if (count >= 20) badge = '🌟 万里河山博学士'
    else if (count >= 10) badge = '🚀 壮游中国小达人'
    else if (count >= 5) badge = '🧭 资深小小旅行家'
    document.getElementById('stat-badge-name')!.innerText = badge

    const matrix = document.getElementById('footprint-matrix')!
    matrix.innerHTML = chinaGeographyData.map(p => {
      const isChecked = !!fps[p.id]
      return `
        <button class="fp-item-btn ${isChecked ? 'checked' : ''}" onclick="window.toggleFootprintId('${p.id}')">
          ${isChecked ? '✅' : '⬜'} ${p.shortName}
        </button>
      `
    }).join('')
  }

  ;(window as any).toggleFootprintId = function(id: string) {
    const fps = getFootprints()
    if (fps[id]) delete fps[id]
    else fps[id] = Date.now()
    saveFootprints(fps)
    renderFootprintMatrix()
    updateFootprintBtnUI(currentProvinceId)
  }

  // ── 猜省份小挑战（全 34 省通识动态题库） ──
  const btnOpenQuiz = document.getElementById('btn-open-quiz')
  const quizModal = document.getElementById('quiz-modal')
  let quizQuestions: any[] = []
  let quizIndex = 0
  let quizScore = 0

  function resetQuizUI() {
    const container = document.getElementById('quiz-container')!
    container.innerHTML = `
      <div class="quiz-question-box">
        <span class="quiz-q-num" id="quiz-q-index">第 1 / 5 题</span>
        <h4 class="quiz-q-title" id="quiz-q-text">正在生成题目...</h4>
      </div>
      <div class="quiz-options-list" id="quiz-options"></div>
