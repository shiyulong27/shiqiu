---
import Base from '../../layouts/Base.astro'
import '../../styles/learning.css'
import { chinaGeographyData, regionsList } from '../../data/chinaGeographyData.js'

const base = import.meta.env.BASE_URL
---

<Base title="中国地理通识长卷 · 华夏万里探索地图 · 34省地标特产古诗联动" wide={true}>
  <main class="learn-page geo-explore-page">
    {/* 顶部通栏面包屑与快速切换条 */}
    <header class="learn-header" style="margin-bottom: 1.25rem;">
      <div class="learn-header-top">
        <nav class="learn-breadcrumb">
          <a href={base}>🏠 知识总门户</a>
          <span>/</span>
          <a href={`${base}geography/explore/`}>🗺️ 山川地理</a>
          <span>/</span>
          <strong style="color: #d97706;">🧭 中国省份探索</strong>
        </nav>
        <div class="learn-subject-switcher">
          <a href={base} class="subject-chip chip-home">🏠 门户首页</a>
          <a href={`${base}geography/explore/`} class="subject-chip active" style="background: #fef3c7; color: #b45309; border: 1px solid #fde68a;">🧭 中国省份探索</a>
          <a href={`${base}geography/nature/`} class="subject-chip" style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">🏔️ 华夏自然地理</a>
          <a href={`${base}geography/heritage/`} class="subject-chip" style="background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa;">🏯 中华世界遗产</a>
          <a href={`${base}geography/`} class="subject-chip" style="background: #f8fafc; color: #475569; border: 1px solid #e2e8f0;">📜 历代疆域与古都</a>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
        <div>
          <h1 class="learn-title" style="margin-bottom: 0.35rem; font-family: 'Kaiti', 'STKaiti', serif; letter-spacing: 0.04em;">
            🧭 中国地理通识长卷 · 华夏万里探索地图
          </h1>
          <p class="learn-subtitle" style="margin: 0; color: #475569; font-size: 0.92rem;">
            全国34个省级行政区全覆盖 · 行政定位与省名溯源 · 人口大省与经济地位 · 核心鲜明特质 · 气候与山川极值 · 大国重器 · 课本古诗山河联动
          </p>
        </div>

        <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
          <button id="btn-open-footprints" class="geo-header-btn" title="查看乐乐与月亮的打卡足迹与徽章">
            👣 华夏足迹打卡册 <span id="header-footprint-badge" class="header-count-tag">0/34</span>
          </button>
          <button id="btn-open-quiz" class="geo-header-btn btn-quiz" title="趣味猜省份通识挑战">
            🧩 趣味地理猜省挑战
          </button>
          <button id="btn-open-puzzle" class="geo-header-btn btn-puzzle" title="华夏省份象形拼图趣味大闯关">
            🎨 象形拼图大闯关 🌟
          </button>
        </div>
      </div>
    </header>

    {/* 🌟 华夏重大分界与名水专题极速探索专区 (顶部醒目核心入口) */}
    <section class="thematic-explore-nav-card" id="thematic-top-bar">
      <div class="thematic-nav-head">
        <div class="thematic-nav-title-group">
          <span class="thematic-nav-icon">🧭</span>
          <div>
            <h2 class="thematic-nav-title">华夏重大地理分界与名水专题展卷</h2>
            <span class="thematic-nav-sub">点击卡片即刻全屏展卷深度图解、高清矢量对比图示与历史典故考证</span>
          </div>
        </div>
        <span class="thematic-nav-hint">💡 点击直接进入专属专题长卷</span>
      </div>

      <div class="thematic-nav-grid">
        <button class="theme-nav-card card-qinling" onclick="window.switchLayerFromTop('qinling_huaihe')">
          <div class="theme-nav-card-head">
            <span class="theme-nav-icon">⚖️</span>
            <span class="theme-nav-badge">南北分界大动脉</span>
          </div>
          <strong class="theme-nav-name">秦岭淮河 · 南北分界</strong>
          <span class="theme-nav-desc">800mm等降水量线 · 1月0℃等温线 · 南稻北麦与集中供暖线</span>
          <span class="theme-nav-action">展卷专题 ➔</span>
        </button>

        <button class="theme-nav-card card-lianghu" onclick="window.switchLayerFromTop('lianghu_divide')">
          <div class="theme-nav-card-head">
            <span class="theme-nav-icon">🌊</span>
            <span class="theme-nav-badge">洞庭云梦两湖溯源</span>
          </div>
          <strong class="theme-nav-name">洞庭云梦 · 两湖分野</strong>
          <span class="theme-nav-desc">湖南与湖北以洞庭湖为天堑界 · “湖广熟天下足”粮仓变迁</span>
          <span class="theme-nav-action">展卷专题 ➔</span>
        </button>

        <button class="theme-nav-card card-liangguang" onclick="window.switchLayerFromTop('liangguang_divide')">
          <div class="theme-nav-card-head">
            <span class="theme-nav-icon">🌴</span>
            <span class="theme-nav-badge">苍梧广信两广同源</span>
          </div>
          <strong class="theme-nav-name">苍梧广信 · 两广同源</strong>
          <span class="theme-nav-desc">汉武帝“广布恩信”设广信 · 广信以东广东以西广西 · 西江走廊</span>
          <span class="theme-nav-action">展卷专题 ➔</span>
        </button>

        <button class="theme-nav-card card-lakes" onclick="window.switchLayerFromTop('major_lakes')">
          <div class="theme-nav-card-head">
            <span class="theme-nav-icon">🏞️</span>
            <span class="theme-nav-badge">泽被华夏之肾</span>
          </div>
          <strong class="theme-nav-name">名湖大泊 · 五大淡水湖</strong>
          <span class="theme-nav-desc">鄱阳湖 · 洞庭湖 · 太湖 · 洪泽湖 · 巢湖 · 青海湖全景</span>
          <span class="theme-nav-action">展卷专题 ➔</span>
        </button>
      </div>
    </section>

    {/* 控制过滤栏：大区胶囊 + 主题模式切换 + 搜索框 */}
    <section class="geo-filter-bar">
      <div class="region-tabs-list" id="region-tabs">
        {regionsList.map((r, idx) => (
          <button
            class={`region-tab-pill ${idx === 0 ? 'active' : ''}`}
            data-region={r}
          >
            {r} <span class="pill-count">({r === '全部大区' ? chinaGeographyData.length : chinaGeographyData.filter(p => p.region === r).length})</span>
          </button>
        ))}
      </div>

      <div class="geo-mode-and-search">
        <div class="geo-view-modes" id="geo-view-modes">
          <button class="mode-pill active" data-mode="all">🏛️ 全貌通识</button>
          <button class="mode-pill" data-mode="boundary">⚖️ 山河分界</button>
          <button class="mode-pill" data-mode="soul">🌟 核心特质</button>
          <button class="mode-pill" data-mode="climate">🌤️ 气候山川</button>
          <button class="mode-pill" data-mode="economy">🏭 经济重器</button>
          <button class="mode-pill" data-mode="landmarks">🏯 名胜古迹</button>
          <button class="mode-pill" data-mode="specialties">🍲 风物特产</button>
          <button class="mode-pill" data-mode="poems">📜 课本诗意</button>
        </div>

        <div class="geo-search-box">
          <input
            type="text"
            id="geo-search-input"
            placeholder="🔍 搜索省份、省会、特产、古迹..."
          />
          <button id="btn-geo-search-clear" style="display:none;">✕</button>
        </div>
      </div>
    </section>

    {/* 主工作区：左侧交互中国地图 + 侧边省份目录，右侧沉浸式省份通识长卷 */}
    <div class="geo-stage-layout">
      {/* 左侧：中国地图与省份列表 */}
      <div class="geo-left-col">
        {/* 上部：ECharts 中国交互地图画布 */}
        <div class="geo-map-card">
          <div class="map-card-header">
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <span style="font-weight: bold; color: #1e293b;">🇨🇳 华夏大地交互探索图</span>
              <span style="font-size: 0.78rem; color: #64748b;">悬停探查 · 点击展卷</span>
            </div>
            <div class="map-layer-switcher" id="map-layer-switcher">
              <button class="layer-pill active" data-layer="provinces">🇨🇳 34省区</button>
              <button class="layer-pill" data-layer="qinling_huaihe">⚖️ 南北分界</button>
              <button class="layer-pill" data-layer="lianghu_divide">🌊 两湖分野</button>
              <button class="layer-pill" data-layer="liangguang_divide">🌴 两广同源</button>
              <button class="layer-pill" data-layer="major_lakes">🏞️ 名湖大泊</button>
              <button class="layer-pill" data-layer="yangtze">🌊 长江漫游</button>
              <button class="layer-pill" data-layer="yellow">🌊 黄河漫游</button>
              <button class="layer-pill" data-layer="mountains">⛰️ 三山五岳</button>
            </div>
          </div>

          {/* 漫游图层状态浮动提示栏 */}
          <div id="layer-info-strip" class="layer-info-strip" style="display: none;">
            <div class="layer-strip-content">
              <span id="layer-strip-title" class="layer-strip-title">🌊 万里长江黄金水道</span>
              <span id="layer-strip-stats" class="layer-strip-stats">全长 6,387 公里 · 流经 11 省区市</span>
              <span class="layer-strip-hint">💡 点击水系航标或名山图钉展开诗意人文</span>
            </div>
            <button id="btn-layer-reset" class="btn-layer-reset" title="返回省区默认底图">返回省区 ✕</button>
          </div>

          <div id="china-explore-map" class="map-viewport"></div>
        </div>

        {/* 下部：省份速览卡片抽屉 */}
        <div class="geo-province-drawer">
          <div class="drawer-header">
            <span style="font-weight: bold; color: #1e293b;">📜 省级行政区列表 (<span id="visible-province-count">34</span>)</span>
            <span style="font-size: 0.8rem; color: #64748b;">点击卡片即时展卷</span>
          </div>
          <div class="province-cards-grid" id="province-cards-container">
            {chinaGeographyData.map((p, idx) => (
              <div
                class={`province-mini-card ${idx === 0 ? 'active' : ''}`}
                data-id={p.id}
                data-name={p.name}
                data-adcode={p.adcode}
                data-region={p.region}
                data-search={`${p.name} ${p.shortName} ${p.abbr} ${p.capital} ${p.tagline} ${p.adminType} ${p.statusBadges?.join(' ')} ${p.landmarks.map(l => l.name).join(' ')} ${p.specialties.map(s => s.name).join(' ')} ${p.famousFigures.join(' ')} ${p.relatedPoems.map(rp => rp.title).join(' ')} ${p.boundaryHeritage?.divideType || ''} ${p.boundaryHeritage?.divideName || ''} ${p.boundaryHeritage?.borderRiversMountains?.join(' ') || ''} ${p.boundaryHeritage?.allusion || ''} ${p.boundaryHeritage?.heritageDetail || ''}`}
                onclick={`window.switchProvince('${p.id}')`}
              >
                <div class="card-seal" style={`background: ${p.themeColor};`}>{p.abbr.split('/')[0].trim()}</div>
                <div class="card-info">
                  <div class="card-name-row">
                    <strong class="card-name">{p.shortName}</strong>
                    <span class="card-cap">{p.capital}</span>
                    <span class="card-admin-pill">{p.adminType}</span>
                  </div>
                  <div class="card-tagline">{p.tagline}</div>
                </div>
                <div class="card-footprint-tag" id={`footprint-mark-${p.id}`} style="display:none;">👣</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* 右侧：沉浸式省份通识百科长卷 */}
      <section class="geo-right-col" id="province-detail-sheet">
        {/* 顶部宏大牌匾 */}
        <div class="province-banner" id="prov-banner">
          <div class="banner-top-row">
            <div class="banner-seal-box">
              <div class="seal-stamp" id="prov-seal">川</div>
              <div>
                <div class="banner-title-group">
                  <h2 class="banner-prov-name" id="prov-name">四川省</h2>
                  <span class="banner-admin-badge" id="prov-admin-type">🏛️ 省</span>
                  <span class="banner-cap-badge" id="prov-capital">省会：成都</span>
                  <span class="banner-region-badge" id="prov-region">西南大区</span>
                </div>
                <div class="banner-status-badges" id="prov-status-badges">
                  {/* 动态注入人口大省、经济大省等标签 */}
                </div>
                <div class="banner-tagline" id="prov-tagline">天府之国 · 蜀道锦绣 · 熊猫故乡 · 盆地之王</div>
              </div>
            </div>

            <div class="banner-actions">
              <button class="btn-footprint-toggle" id="btn-toggle-footprint" onclick="window.toggleCurrentFootprint()">
                👣 点亮足迹：我已去过！
              </button>
            </div>
          </div>
          
          {/* 省名溯源考据 */}
          <div class="banner-origin-strip" id="prov-origin-strip">
            <span class="origin-label">📜 省名溯源</span>
            <span class="origin-text" id="prov-name-origin">北宋置“川峡四路”...</span>
          </div>

          {/* 华夏地理分界与省界定位 */}
          <div class="banner-boundary-strip" id="prov-banner-boundary-strip">
            <span class="boundary-strip-icon">⚖️</span>
            <div class="boundary-strip-content">
              <span class="boundary-strip-label">核心地理分界定位：</span>
              <strong class="boundary-strip-val" id="prov-banner-boundary-val">南北分界核心省份 · 秦岭主脊与淮河源头</strong>
            </div>
            <button class="boundary-strip-btn" id="prov-banner-boundary-btn" onclick="window.jumpToProvinceBoundaryTheme()">
              展卷对应专题 ➔
            </button>
          </div>

          <p class="banner-intro" id="prov-intro">
            地处我国西南，西高东低，四川盆地沃野千里，自古享有“天府之国”的美誉。大熊猫故乡，麻辣川菜享誉全球。
          </p>
        </div>

        {/* 四大硬核基本面看板 */}
        <div class="core-metrics-grid" id="prov-metrics-grid">
          <div class="core-metric-card">
            <div class="metric-icon">👥</div>
            <div class="metric-info">
              <div class="metric-lbl">常住人口体量</div>
              <div class="metric-val" id="prov-stat-population">8,374 万</div>
              <div class="metric-sub" id="prov-stat-pop-rank">西南第一 · 全国第五</div>
            </div>
          </div>
          <div class="core-metric-card">
            <div class="metric-icon">📐</div>
            <div class="metric-info">
              <div class="metric-lbl">管辖土地面积</div>
              <div class="metric-val" id="prov-stat-area">48.6 万 k㎡</div>
              <div class="metric-sub" id="prov-stat-area-pct">全国第五 · 占全国 5.1%</div>
            </div>
          </div>
          <div class="core-metric-card">
            <div class="metric-icon">🤝</div>
            <div class="metric-info">
              <div class="metric-lbl">民族大家庭</div>
              <div class="metric-val" id="prov-stat-ethnic-count">56个民族齐全</div>
              <div class="metric-sub" id="prov-stat-ethnic-desc">最大彝区 · 第二大藏区</div>
            </div>
          </div>
          <div class="core-metric-card">
            <div class="metric-icon">🌤️</div>
            <div class="metric-info">
              <div class="metric-lbl">气候环境总览</div>
              <div class="metric-val" id="prov-stat-climate-type">亚热带湿润季风</div>
              <div class="metric-sub" id="prov-stat-climate-feel">冬暖春早 · 多云雾少日照</div>
            </div>
          </div>
        </div>

        {/* 🌟 核心鲜明特征看板 (灵魂基因看板) */}
        <div class="geo-section-deck deck-soul" id="deck-soul">
          <h3 class="section-deck-title">
            <span>🌟 省份核心鲜明特征（地理性格与灵魂基因）</span>
          </h3>
          <div class="soul-features-grid" id="prov-soul-features">
            {/* 动态注入 3 个鲜明特征大卡片 */}
          </div>
        </div>

        {/* ⚖️ 山河为界 · 省界溯源与地理分水岭典故 (层次一：省份内嵌) */}
        <div class="geo-section-deck deck-boundary" id="deck-boundary">
          <div class="deck-head-with-action">
            <h3 class="section-deck-title" style="margin-bottom: 0;">
              <span>⚖️ 山河为界 · 省界溯源与地理分水岭典故</span>
            </h3>
            <button id="btn-jump-theme-explore" class="btn-boundary-action" onclick="window.jumpToProvinceBoundaryTheme()">
              🌐 展开【<span id="prov-boundary-theme-name">南北分界</span>】全景专题长卷 ➔
            </button>
          </div>
          
          <div class="boundary-content-card">
            <div class="boundary-top-meta">
              <span class="boundary-badge" id="prov-boundary-type">南北过渡分水岭</span>
              <h4 class="boundary-title" id="prov-boundary-title">秦岭-淮河一线</h4>
            </div>

            <div class="boundary-rivers-mountains">
              <span class="boundary-lbl">天然边界依托：</span>
              <div class="boundary-chips-wrap" id="prov-boundary-chips">
                {/* 动态注入山川边界标签 */}
              </div>
            </div>

            <div class="boundary-allusion-box">
              <div class="allusion-head">
                <span class="allusion-icon">💡</span>
                <strong>历史地理典故</strong>
              </div>
              <p class="allusion-text" id="prov-boundary-allusion">
                “橘生淮南则为橘，生于淮北则为枳...”
              </p>
            </div>

            <div class="boundary-detail-box">
              <div class="boundary-detail-title">📜 边界溯源与地理人文考据</div>
              <p class="boundary-detail-text" id="prov-boundary-detail">
                考据正文...
              </p>
            </div>
          </div>
        </div>

        {/* 🌤️ 气候环境与自然山川水文 */}
        <div class="geo-section-deck deck-climate" id="deck-climate">
          <h3 class="section-deck-title">
            <span>🏔️ 气候环境与自然山川水文极值</span>
          </h3>
          <div class="nature-detail-grid">
            <div class="nature-sub-card">
              <div class="nature-card-head">🌤️ 气候特征与真实体感</div>
              <div class="nature-card-body">
                <p id="prov-climate-summary" style="font-weight: 700; color: #1e293b; margin-bottom: 0.4rem; font-size: 0.95rem;"></p>
                <p id="prov-climate-feel" style="color: #475569; margin-bottom: 0.4rem; font-size: 0.88rem; line-height: 1.5;"></p>
                <p id="prov-climate-details" style="font-size: 0.82rem; color: #64748b; margin: 0; line-height: 1.45;"></p>
              </div>
            </div>
            <div class="nature-sub-card">
              <div class="nature-card-head">⛰️ 地貌阶梯与极端高差极值</div>
              <div class="nature-card-body">
                <div class="nature-data-row">
                  <span class="data-tag">地貌阶梯</span>
                  <span class="data-val" id="prov-terrain-scale"></span>
                </div>
                <div class="nature-data-row">
                  <span class="data-tag tag-peak">最高峰</span>
                  <span class="data-val" id="prov-highest-peak"></span>
                </div>
                <div class="nature-data-row">
                  <span class="data-tag tag-lowest">最低点</span>
                  <span class="data-val" id="prov-lowest-point"></span>
                </div>
              </div>
            </div>
            <div class="nature-sub-card" style="grid-column: 1 / -1;">
              <div class="nature-card-head">🌊 骨干山脉与流经大江大河</div>
              <div class="nature-card-body">
                <div style="margin-bottom: 0.6rem;">
                  <strong style="font-size: 0.84rem; color: #0369a1; display: inline-block; min-width: 100px;">主要干流水系：</strong>
                  <span id="prov-major-rivers" class="river-tags-wrap"></span>
                </div>
                <div>
                  <strong style="font-size: 0.84rem; color: #047857; display: inline-block; min-width: 100px;">主要脊梁山脉：</strong>
                  <span id="prov-major-mountains" class="mountain-tags-wrap"></span>
                </div>
              </div>
            </div>
          </div>
        </div>

