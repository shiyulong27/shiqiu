      `).join('')
    }

    // 诗意山河
    const pmWrap = document.getElementById('prov-poems-wrap')
    if (pmWrap) {
      if (p.relatedPoems && p.relatedPoems.length > 0) {
        pmWrap.innerHTML = p.relatedPoems.map((rp: any) => `
          <div class="poem-link-card">
            <div class="poem-card-title-row">
              <span>《${rp.title}》</span>
              <span style="font-weight:normal;color:#64748b;">〔${rp.author}〕</span>
            </div>
            <div class="poem-card-quote">“${rp.quote}”</div>
            <a class="poem-jump-link" href="${(window as any).siteBase || '/'}chinese/poems/">🎙️ 直达古诗点读台 ➔</a>
          </div>
