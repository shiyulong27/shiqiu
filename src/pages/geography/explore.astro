  .thematic-main-title {
    font-size: 1.45rem;
    font-weight: 900;
    color: #7c2d12;
    margin: 0 0 0.45rem;
    font-family: 'Kaiti', 'STKaiti', serif;
    letter-spacing: 0.03em;
    line-height: 1.4;
  }
  .thematic-tagline {
    font-size: 0.92rem;
    font-weight: 700;
    color: #c2410c;
    margin-bottom: 0.65rem;
    line-height: 1.5;
  }
  .thematic-intro-text {
    font-size: 0.9rem;
    color: #431407;
    line-height: 1.65;
    margin: 0;
