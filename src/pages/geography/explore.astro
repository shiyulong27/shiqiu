    gap: 0.65rem;
  }
  @media (max-width: 500px) {
    .puzzle-options-grid {
      grid-template-columns: 1fr;
    }
  }
  .puzzle-option-btn {
    padding: 0.85rem 1rem;
    background: #fff;
    border: 2px solid #e2e8f0;
    border-radius: 0.75rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: #334155;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
  }
  .puzzle-option-btn:hover {
    background: #f5f3ff;
    border-color: #8b5cf6;
    color: #6d28d9;
    transform: translateY(-2px);
  }
  .puzzle-option-btn.correct {
    background: #dcfce7;
    border-color: #22c55e;
    color: #15803d;
  }
  .puzzle-option-btn.wrong {
    background: #fee2e2;
    border-color: #ef4444;
    color: #b91c1c;
  }
  .puzzle-feedback {
