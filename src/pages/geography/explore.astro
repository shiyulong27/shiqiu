</style>

<script>
  import * as echarts from 'echarts'
  import chinaGeo from '../../../data/geography/china_geo.json'
  import { chinaGeographyData } from '../../data/chinaGeographyData.js'

  // 注册中国矢量底图
  echarts.registerMap('china', chinaGeo as any)

  // 全局响应式状态
  let currentProvinceId = 'sichuan'
  let currentRegionFilter = '全部大区'
  let currentViewMode = 'all'
  let chartInstance: echarts.ECharts | null = null

  // 足迹持久化
  function getFootprints() {
    try {
      return JSON.parse(localStorage.getItem('shiqiu_geo_footprints') || '{}')
    } catch {
      return {}
    }
  }

  function saveFootprints(data: any) {
    try {
      localStorage.setItem('shiqiu_geo_footprints', JSON.stringify(data))
    } catch {}
  }

  // 初始化地图
  function initChart() {
    const chartDom = document.getElementById('china-explore-map')
    if (!chartDom) return

    chartInstance = echarts.init(chartDom)
    updateChart()

    chartInstance.on('click', (params: any) => {
      if (params.name) {
        const found = chinaGeographyData.find(p => p.name === params.name || p.shortName === params.name || params.name.includes(p.shortName))
        if (found) {
          (window as any).switchProvince(found.id)
        }
      }
    })

    window.addEventListener('resize', () => {
      chartInstance?.resize()
    })
  }

  // 刷新地图着色
  function updateChart() {
    if (!chartInstance) return

    const regionsColorMap: Record<string, string> = {
      '华北': '#f97316',
      '东北': '#0284c7',
      '华东': '#0d9488',
      '华中': '#e11d48',
      '华南': '#10b981',
      '西南': '#8b5cf6',
      '西北': '#d97706',
      '港澳台': '#ec4899'
    }

    const currentProv = chinaGeographyData.find(p => p.id === currentProvinceId) || chinaGeographyData[0]

    const mapData = chinaGeographyData.map(p => {
      const isSelected = p.id === currentProvinceId
      const matchRegion = currentRegionFilter === '全部大区' || p.region === currentRegionFilter

      let areaColor = regionsColorMap[p.region] || '#cbd5e1'
      let opacity = matchRegion ? 0.75 : 0.15
      let borderColor = '#ffffff'
      let borderWidth = 1

      if (isSelected) {
        areaColor = '#dc2626'
        opacity = 1
        borderColor = '#fde047'
        borderWidth = 2.5
      }

      return {
        name: p.name,
        value: p.capital,
        itemStyle: {
          areaColor,
          opacity,
          borderColor,
          borderWidth
        },
        emphasis: {
          itemStyle: {
            areaColor: '#f97316',
            opacity: 0.95
          },
          label: {
            show: true,
            color: '#fff',
            fontWeight: 'bold'
          }
        }
      }
    })

    const option = {
      tooltip: {
        trigger: 'item',
        formatter: (params: any) => {
          const prov = chinaGeographyData.find(p => p.name === params.name || params.name.includes(p.shortName))
          if (!prov) return params.name
          return `
            <div style="font-size:13px;line-height:1.5;">
              <strong style="color:${prov.themeColor};font-size:14px;">${prov.name} (${prov.abbr})</strong><br/>
              省会/首府：<b>${prov.capital}</b> · ${prov.region}大区<br/>
              <em>“${prov.tagline}”</em><br/>
              地标：${prov.landmarks[0]?.name || ''} · 特产：${prov.specialties[0]?.name || ''}
            </div>
          `
        }
      },
      geo: {
        map: 'china',
        roam: true,
        zoom: 1.18,
        center: [104.5, 36.5],
        label: {
          show: false
        },
        itemStyle: {
          borderColor: '#ffffff',
          borderWidth: 1
        },
        regions: mapData
      },
      series: []
    }

    chartInstance.setOption(option, true)
  }

  // 渲染右侧通识长卷
  function renderProvinceDetail(p: any) {
    document.getElementById('prov-seal')!.innerText = p.abbr.split('/')[0].trim()
    document.getElementById('prov-seal')!.style.background = p.themeColor
    document.getElementById('prov-name')!.innerText = p.name
    document.getElementById('prov-capital')!.innerText = `省会：${p.capital}`
    document.getElementById('prov-region')!.innerText = `${p.region}大区`
    document.getElementById('prov-tagline')!.innerText = p.tagline
    document.getElementById('prov-intro')!.innerText = p.intro

    document.getElementById('prov-terrain')!.innerText = p.terrain
    document.getElementById('prov-climate')!.innerText = p.climate
    document.getElementById('prov-funfact')!.innerText = p.funFact

    // 地标网格
    const lmGrid = document.getElementById('prov-landmarks-grid')!
    lmGrid.innerHTML = p.landmarks.map((l: any) => `
      <div class="landmark-card">
        <div class="lm-icon">${l.icon || '🏯'}</div>
        <div class="lm-content">
          <div class="lm-name">${l.name}</div>
          <span class="lm-tag">${l.type}</span>
          <p class="lm-desc">${l.desc}</p>
        </div>
      </div>
    `).join('')

    // 特产网格
    const spGrid = document.getElementById('prov-specialties-grid')!
    spGrid.innerHTML = p.specialties.map((s: any) => `
      <div class="specialty-card">
        <div class="sp-icon">${s.icon || '🍲'}</div>
        <div class="sp-content">
          <div class="sp-name">${s.name}</div>
          <span class="sp-tag">${s.type}</span>
          <p class="sp-desc">${s.desc}</p>
        </div>
      </div>
    `).join('')

    // 文化名人
    const figWrap = document.getElementById('prov-figures-tags')!
    figWrap.innerHTML = p.famousFigures.map((f: string) => `
      <span class="figure-tag-chip">👤 ${f}</span>
    `).join('')

    // 诗意山河
    const pmWrap = document.getElementById('prov-poems-wrap')!
    if (p.relatedPoems && p.relatedPoems.length > 0) {
      pmWrap.innerHTML = p.relatedPoems.map((rp: any) => `
        <div class="poem-link-card">
          <div class="poem-card-title-row">
            <span>《${rp.title}》</span>
            <span style="font-weight:normal;color:#64748b;">〔${rp.author}〕</span>
          </div>
          <div class="poem-card-quote">“${rp.quote}”</div>
          <a class="poem-jump-link" href="${(window as any).siteBase || '/'}chinese/poems/">🎙️ 直达古诗点读台 ➔</a>
        </div>
      `).join('')
    } else {
      pmWrap.innerHTML = '<div style="font-size:0.85rem;color:#94a3b8;">暂无关联诗词</div>'
    }

    // 足迹按钮状态
    updateFootprintBtnUI(p.id)
  }

  function updateFootprintBtnUI(id: string) {
    const fps = getFootprints()
    const btn = document.getElementById('btn-toggle-footprint')!
    if (fps[id]) {
      btn.innerText = '✅ 乐乐/月亮已打卡此省！(点击取消)'
      btn.classList.add('visited')
    } else {
      btn.innerText = '👣 点亮足迹：我已去过！'
      btn.classList.remove('visited')
    }

    // 更新各卡片上的标记
    chinaGeographyData.forEach(prov => {
      const mark = document.getElementById(`footprint-mark-${prov.id}`)
      if (mark) {
        mark.style.display = fps[prov.id] ? 'inline-block' : 'none'
      }
    })

    // 更新顶部总打卡数
    const count = Object.keys(fps).length
    const badge = document.getElementById('header-footprint-badge')
    if (badge) badge.innerText = `${count}/34`
  }

  // 切换省份
  (window as any).switchProvince = function(id: string) {
    currentProvinceId = id
    const prov = chinaGeographyData.find(p => p.id === id) || chinaGeographyData[0]

    // 高亮左侧卡片
    document.querySelectorAll('.province-mini-card').forEach(card => {
      if (card.getAttribute('data-id') === id) {
        card.classList.add('active')
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      } else {
        card.classList.remove('active')
      }
    })

    renderProvinceDetail(prov)
    updateChart()
  };

  // 足迹打卡切换
  (window as any).toggleCurrentFootprint = function() {
    const fps = getFootprints()
    if (fps[currentProvinceId]) {
      delete fps[currentProvinceId]
    } else {
      fps[currentProvinceId] = Date.now()
    }
    saveFootprints(fps)
    updateFootprintBtnUI(currentProvinceId)
  };

  // 筛选过滤省份
  function filterProvinces() {
    const searchText = (document.getElementById('geo-search-input') as HTMLInputElement).value.trim().toLowerCase()

    let visibleCount = 0
    let firstVisibleId: string | null = null

    document.querySelectorAll('.province-mini-card').forEach(card => {
      const region = card.getAttribute('data-region')
      const searchData = card.getAttribute('data-search')!.toLowerCase()
      const id = card.getAttribute('data-id')!

      const matchRegion = currentRegionFilter === '全部大区' || region === currentRegionFilter
      const matchSearch = !searchText || searchData.includes(searchText)

      if (matchRegion && matchSearch) {
        (card as HTMLElement).style.display = 'flex'
        visibleCount++
        if (!firstVisibleId) firstVisibleId = id
      } else {
        (card as HTMLElement).style.display = 'none'
      }
    })

    document.getElementById('visible-province-count')!.innerText = String(visibleCount)

    if (firstVisibleId && !document.querySelector(`.province-mini-card[data-id="${currentProvinceId}"]:not([style*="display: none"])`)) {
      (window as any).switchProvince(firstVisibleId)
    }

    updateChart()
  }

  // ── 足迹模态 ──
  const btnOpenFp = document.getElementById('btn-open-footprints')
  const fpModal = document.getElementById('footprints-modal')

  btnOpenFp?.addEventListener('click', () => {
    renderFootprintMatrix()
    fpModal!.style.display = 'flex'
  })

  ;(window as any).closeFootprintsModal = function() {
    fpModal!.style.display = 'none'
  }

  function renderFootprintMatrix() {
    const fps = getFootprints()
    const count = Object.keys(fps).length
    const pct = Math.round((count / 34) * 100)

    document.getElementById('stat-visited-count')!.innerText = `${count} / 34`
    document.getElementById('stat-visited-pct')!.innerText = `${pct}%`

    let badge = '华夏初探者'
    if (count >= 30) badge = '👑 华夏全通探险大宗师'
    else if (count >= 20) badge = '🌟 万里河山博学士'
    else if (count >= 10) badge = '🚀 壮游中国小达人'
    else if (count >= 5) badge = '🧭 资深小小旅行家'
    document.getElementById('stat-badge-name')!.innerText = badge

    const matrix = document.getElementById('footprint-matrix')!
    matrix.innerHTML = chinaGeographyData.map(p => {
      const isChecked = !!fps[p.id]
      return `
        <button class="fp-item-btn ${isChecked ? 'checked' : ''}" onclick="window.toggleFootprintId('${p.id}')">
          ${isChecked ? '✅' : '⬜'} ${p.shortName}
        </button>
      `
    }).join('')
  }

  ;(window as any).toggleFootprintId = function(id: string) {
    const fps = getFootprints()
    if (fps[id]) delete fps[id]
    else fps[id] = Date.now()
    saveFootprints(fps)
    renderFootprintMatrix()
    updateFootprintBtnUI(currentProvinceId)
  }

  // ── 猜省份小挑战 ──
  const btnOpenQuiz = document.getElementById('btn-open-quiz')
  const quizModal = document.getElementById('quiz-modal')
  let quizQuestions: any[] = []
  let quizIndex = 0
  let quizScore = 0

  btnOpenQuiz?.addEventListener('click', () => {
    generateQuizQuestions()
    quizIndex = 0
    quizScore = 0
    renderCurrentQuiz()
    quizModal!.style.display = 'flex'
  })

  ;(window as any).closeQuizModal = function() {
    quizModal!.style.display = 'none'
  }

  function generateQuizQuestions() {
    quizQuestions = [
      {
        question: '“大熊猫的故乡”、“九寨沟”与“天府之国”指的是我国哪个省份？',
        options: ['四川省', '陕西省', '云南省', '贵州省'],
        answer: '四川省',
        explain: '四川盆地土地肥沃被誉为天府之国，拥有九寨沟及全世界最多的野生大熊猫！'
      },
      {
        question: '“世界第八大奇迹”秦始皇陵兵马俑，以及西岳华山位于哪个省份？',
        options: ['河南省', '山西省', '陕西省', '甘肃省'],
        answer: '陕西省',
        explain: '陕西省简称陕或秦，省会西安是十三朝古都，兵马俑与奇险华山皆坐落于此！'
      },
      {
        question: '享有“人间天堂”美称，西湖龙井茶与钱塘江大潮所在的省份是？',
        options: ['江苏省', '浙江省', '安徽省', '福建省'],
        answer: '浙江省',
        explain: '浙江省会杭州拥有天下闻名的西湖，龙井茶与钱塘江大潮享誉海内外！'
      }
    ]
  }

  function renderCurrentQuiz() {
    const q = quizQuestions[quizIndex]
    document.getElementById('quiz-q-index')!.innerText = `第 ${quizIndex + 1} / ${quizQuestions.length} 题`
    document.getElementById('quiz-q-text')!.innerText = q.question
    document.getElementById('quiz-feedback')!.style.display = 'none'
    document.getElementById('btn-next-quiz')!.style.display = 'none'

    const optContainer = document.getElementById('quiz-options')!
    optContainer.innerHTML = q.options.map((opt: string) => `
      <button class="quiz-option-btn" onclick="window.checkQuizAnswer('${opt}')">
        ${opt}
      </button>
    `).join('')
  }

  ;(window as any).checkQuizAnswer = function(chosen: string) {
    const q = quizQuestions[quizIndex]
    const isRight = chosen === q.answer
    if (isRight) quizScore++

    document.querySelectorAll('.quiz-option-btn').forEach((btn: any) => {
      btn.disabled = true
      if (btn.innerText.trim() === q.answer) btn.classList.add('correct')
      else if (btn.innerText.trim() === chosen && !isRight) btn.classList.add('wrong')
    })

    const fb = document.getElementById('quiz-feedback')!
    fb.style.display = 'block'
    if (isRight) {
      fb.className = 'quiz-feedback-box correct'
      fb.innerHTML = `🎉 恭喜回答正确！${q.explain}`
    } else {
      fb.className = 'quiz-feedback-box wrong'
      fb.innerHTML = `💡 回答错误哦！正确答案是【${q.answer}】。${q.explain}`
    }

    const nextBtn = document.getElementById('btn-next-quiz')!
    nextBtn.style.display = 'block'
    if (quizIndex === quizQuestions.length - 1) {
      nextBtn.innerText = `查看挑战成果 🏆`
    } else {
      nextBtn.innerText = `下一题 ➔`
    }
  }

  ;(window as any).nextQuizQuestion = function() {
    quizIndex++
    if (quizIndex < quizQuestions.length) {
      renderCurrentQuiz()
    } else {
      // 挑战完成
      const container = document.getElementById('quiz-container')!
      container.innerHTML = `
        <div style="text-align:center;padding:1.5rem 0;">
          <div style="font-size:3rem;margin-bottom:0.5rem;">🎉</div>
          <h4 style="font-size:1.3rem;font-weight:900;color:#1e293b;margin:0 0 0.5rem;">挑战完成！</h4>
          <p style="font-size:1rem;color:#059669;font-weight:bold;">乐乐与月亮总共答对 ${quizScore} / ${quizQuestions.length} 题！</p>
          <p style="font-size:0.85rem;color:#64748b;">太棒了！华夏地理通识知识又进步了一大截！</p>
          <button class="btn-quiz-next" style="margin-top:1rem;" onclick="window.closeQuizModal()">完成挑战</button>
        </div>
      `
    }
  }

  // 页面启动绑定
  document.addEventListener('DOMContentLoaded', () => {
    (window as any).siteBase = import.meta.env.BASE_URL || '/'

    // 初始化 ECharts 地图
    initChart()

    // 默认渲染四川
    const defaultProv = chinaGeographyData.find(p => p.id === currentProvinceId) || chinaGeographyData[0]
    renderProvinceDetail(defaultProv)

    // 大区切换胶囊
    document.querySelectorAll('.region-tab-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.region-tab-pill').forEach(p => p.classList.remove('active'))
        pill.classList.add('active')
        currentRegionFilter = pill.getAttribute('data-region') || '全部大区'
        filterProvinces()
      })
    })

    // 搜索输入
    const searchInput = document.getElementById('geo-search-input') as HTMLInputElement
    const searchClear = document.getElementById('btn-geo-search-clear')!

    searchInput.addEventListener('input', () => {
      searchClear.style.display = searchInput.value ? 'inline-block' : 'none'
      filterProvinces()
    })

    searchClear.addEventListener('click', () => {
      searchInput.value = ''
      searchClear.style.display = 'none'
      filterProvinces()
    })

    // 视图模式切换
    document.querySelectorAll('.mode-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.mode-pill').forEach(p => p.classList.remove('active'))
        pill.classList.add('active')
        currentViewMode = pill.getAttribute('data-mode') || 'all'
      })
    })
  })
</script>
