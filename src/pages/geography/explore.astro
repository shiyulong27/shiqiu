    } else if (['jiangxi', 'qinghai'].includes(p.id) || bh.divideType?.includes('名湖') || bh.divideName?.includes('湖')) {
      matchedThemeKey = 'major_lakes'
      matchedThemeName = '名湖大泊'
    } else if (['shaanxi', 'henan', 'anhui', 'jiangsu', 'gansu'].includes(p.id) || bh.divideType?.includes('南北')) {
      matchedThemeKey = 'qinling_huaihe'
