  // ── 江河漫游与名山大川及地理分界逻辑 ──
  function switchLayer(layer: string) {
    currentLayer = layer
    const strip = document.getElementById('layer-info-strip')!
    const stripTitle = document.getElementById('layer-strip-title')!
    const stripStats = document.getElementById('layer-strip-stats')!

    const provSheet = document.getElementById('province-detail-sheet')!
    const themeSheet = document.getElementById('thematic-detail-sheet')!

    const isBoundaryTheme = ['qinling_huaihe', 'lianghu_divide', 'liangguang_divide', 'major_lakes'].includes(layer)

    if (isBoundaryTheme) {
      provSheet.style.display = 'none'
      themeSheet.style.display = 'flex'
      renderThematicDetail(layer)
    } else {
      themeSheet.style.display = 'none'
      provSheet.style.display = 'flex'
    }

    if (layer === 'qinling_huaihe') {
      strip.style.display = 'flex'
      strip.style.borderLeftColor = '#ea580c'
      strip.style.background = '#fff7ed'
      stripTitle.innerText = '⚖️ 秦岭 · 淮河 —— 华夏南北地理与人文分水岭'
      stripStats.innerText = '800mm等降水量线 · 1月0℃等温线 · 南稻北麦 · 集中供暖界线'
    } else if (layer === 'lianghu_divide') {
      strip.style.display = 'flex'
      strip.style.borderLeftColor = '#0284c7'
      strip.style.background = '#f0f9ff'
      stripTitle.innerText = '🌊 洞庭云梦 · 两湖分野 —— 湖南与湖北历史地理溯源'
      stripStats.innerText = '以洞庭湖为天堑界 · 古云梦泽变迁 · 湖广熟天下足 · 楚水生辉'
    } else if (layer === 'liangguang_divide') {
      strip.style.display = 'flex'
      strip.style.borderLeftColor = '#059669'
      strip.style.background = '#ecfdf5'
      stripTitle.innerText = '🌴 苍梧广信 · 两广同源 —— 广东与广西历史地理分野'
      stripStats.innerText = '汉武帝“广布恩信”设广信 · 广信以东为广东以西为广西 · 西江走廊 · 灵渠梅关'
    } else if (layer === 'major_lakes') {
      strip.style.display = 'flex'
      strip.style.borderLeftColor = '#0d9488'
      strip.style.background = '#f0fdfa'
      stripTitle.innerText = '🏞️ 名湖浩渺 · 泽被华夏 —— 中国五大淡水湖与青海湖全景'
      stripStats.innerText = '鄱阳湖 · 洞庭湖 · 太湖 · 洪泽湖 · 巢湖 · 青海湖 · 华夏之肾'
    } else if (layer === 'yangtze') {
      strip.style.display = 'flex'
      strip.style.borderLeftColor = '#0284c7'
      strip.style.background = '#f0f9ff'
      stripTitle.innerText = '🌊 万里长江 · 黄金水道漫游'
      stripStats.innerText = '全长 6,387 公里 · 流经 11 省区市 · 亚洲第一长河'
    } else if (layer === 'yellow') {
      strip.style.display = 'flex'
      strip.style.borderLeftColor = '#d97706'
      strip.style.background = '#fffbeb'
      stripTitle.innerText = '🌊 九曲黄河 · 华夏文明摇篮漫游'
      stripStats.innerText = '全长 5,464 公里 · 流经 9 省区市 · “几”字弯壮丽奔腾'
    } else if (layer === 'mountains') {
      strip.style.display = 'flex'
      strip.style.borderLeftColor = '#059669'
      strip.style.background = '#f0fdf4'
      stripTitle.innerText = '⛰️ 中华三山五岳与名山胜境探秘'
      stripStats.innerText = '收录东岳泰山、西岳华山等五岳及黄山、庐山、珠峰等 13 座名峰'
    } else {
      strip.style.display = 'none'
    }

    updateChart()
  }

  function showStationModal(st: any, riverType: string) {
    const modal = document.getElementById('station-detail-modal')!
    document.getElementById('station-modal-icon')!.innerText = st.icon || (currentLayer === 'mountains' ? '⛰️' : (currentLayer === 'major_lakes' ? '🏞️' : '🌊'))
    document.getElementById('station-modal-title')!.innerText = st.name
    document.getElementById('station-modal-sub')!.innerText = st.city
    document.getElementById('station-modal-elevation')!.innerText = st.elevation
    document.getElementById('station-modal-highlight')!.innerText = st.highlight
    document.getElementById('station-modal-desc')!.innerText = st.desc

    if (st.poem) {
      document.getElementById('station-modal-poem-box')!.style.display = 'block'
      document.getElementById('station-modal-poem-quote')!.innerText = `“${st.poem.quote}”`
      document.getElementById('station-modal-poem-meta')!.innerText = `—— ${st.poem.author}《${st.poem.title}》`
    } else {
      document.getElementById('station-modal-poem-box')!.style.display = 'none'
    }

    const jumpBtn = document.getElementById('station-jump-prov-btn')!
    const matchedProv = chinaGeographyData.find(p => st.city && (st.city.includes(p.name) || st.city.includes(p.shortName)))
    if (matchedProv) {
      jumpBtn.style.display = 'inline-block'
      jumpBtn.innerText = `🗺️ 展卷【${matchedProv.name}】通识百科 ➔`
      jumpBtn.onclick = () => {
        modal.style.display = 'none'
        ;(window as any).switchProvince(matchedProv.id)
      }
    } else {
      jumpBtn.style.display = 'none'
    }

    modal.style.display = 'flex'
  }

  function showMountainModal(m: any) {
    const modal = document.getElementById('station-detail-modal')!
    document.getElementById('station-modal-icon')!.innerText = m.icon || '⛰️'
    document.getElementById('station-modal-title')!.innerText = m.title
    document.getElementById('station-modal-sub')!.innerText = `${m.province} · ${m.city}`
    document.getElementById('station-modal-elevation')!.innerText = `海拔 ${m.altitude}`
    document.getElementById('station-modal-highlight')!.innerText = m.highlight
    document.getElementById('station-modal-desc')!.innerText = m.desc

    if (m.poem) {
      document.getElementById('station-modal-poem-box')!.style.display = 'block'
      document.getElementById('station-modal-poem-quote')!.innerText = `“${m.poem.quote}”`
      document.getElementById('station-modal-poem-meta')!.innerText = `—— ${m.poem.author}《${m.poem.title}》`
    } else {
      document.getElementById('station-modal-poem-box')!.style.display = 'none'
    }

    const jumpBtn = document.getElementById('station-jump-prov-btn')!
    jumpBtn.style.display = 'inline-block'
    jumpBtn.innerText = `🗺️ 展卷【${m.province}】通识百科 ➔`
    jumpBtn.onclick = () => {
      modal.style.display = 'none'
      ;(window as any).switchProvince(m.provinceId)
    }

    modal.style.display = 'flex'
  }

  ;(window as any).closeStationModal = function() {
    document.getElementById('station-detail-modal')!.style.display = 'none'
  }

  // ── 专题视图与省份视图无缝切换 ──
  ;(window as any).backToProvinceView = function() {
    document.querySelectorAll('.layer-pill').forEach(p => {
      if (p.getAttribute('data-layer') === 'provinces') p.classList.add('active')
      else p.classList.remove('active')
    })
    switchLayer('provinces')
    document.getElementById('province-detail-sheet')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  };

  ;(window as any).jumpToProvinceFromTheme = function(provId: string, provName: string) {
    let id = provId
    if (!id) {
      const found = chinaGeographyData.find(p => p.name === provName || p.shortName === provName || p.name.includes(provName))
      if (found) id = found.id
    }
    if (id) {
      (window as any).switchProvince(id)
      document.getElementById('province-detail-sheet')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    }
  };

  ;(window as any).jumpToProvinceBoundaryTheme = function() {
    const key = (window as any).currentMatchedThemeKey || 'qinling_huaihe'
    document.querySelectorAll('.layer-pill').forEach(p => {
      if (p.getAttribute('data-layer') === key) p.classList.add('active')
      else p.classList.remove('active')
    })
    switchLayer(key)
    document.getElementById('thematic-detail-sheet')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  };

  ;(window as any).switchLayerFromTop = function(layer: string) {
    document.querySelectorAll('.layer-pill').forEach(p => {
      if (p.getAttribute('data-layer') === layer) p.classList.add('active')
      else p.classList.remove('active')
    })
    switchLayer(layer)
    const targetEl = document.getElementById('thematic-detail-sheet') || document.getElementById('china-explore-map')
    targetEl?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  };

  // ── 象形拼图趣味闯关 ──
  const btnOpenPuzzle = document.getElementById('btn-open-puzzle')
  const puzzleModal = document.getElementById('puzzle-modal')
  let puzzleQuestions: any[] = []
  let puzzleIndex = 0
  let puzzleScore = 0

  btnOpenPuzzle?.addEventListener('click', () => {
    startPuzzleGame()
    puzzleModal!.style.display = 'flex'
  })

  ;(window as any).closePuzzleModal = function() {
    puzzleModal!.style.display = 'none'
  }

  function startPuzzleGame() {
    // 随机抽取 5 题，确保每一轮都有新鲜感
    const shuffled = [...provincePuzzleCards].sort(() => Math.random() - 0.5)
    puzzleQuestions = shuffled.slice(0, 5)
    puzzleIndex = 0
    puzzleScore = 0
    renderCurrentPuzzle()
  }

  function renderCurrentPuzzle() {
    const card = puzzleQuestions[puzzleIndex]
    const total = puzzleQuestions.length

    document.getElementById('puzzle-progress-fill')!.style.width = `${((puzzleIndex + 1) / total) * 100}%`
    document.getElementById('puzzle-round-txt')!.innerText = `第 ${puzzleIndex + 1} / ${total} 关`
    document.getElementById('puzzle-score-txt')!.innerText = `得分: ${puzzleScore * 20} 分`

    document.getElementById('puzzle-icon')!.innerText = card.icon
    document.getElementById('puzzle-metaphor')!.innerText = card.metaphor
    document.getElementById('puzzle-riddle')!.innerText = card.riddle
    document.getElementById('puzzle-clue')!.innerText = card.clue

    document.getElementById('puzzle-feedback')!.style.display = 'none'
    document.getElementById('btn-next-puzzle')!.style.display = 'none'

    const optContainer = document.getElementById('puzzle-options')!
    optContainer.innerHTML = card.options.map((opt: string) => `
      <button class="puzzle-option-btn" onclick="window.checkPuzzleAnswer('${opt}')">
        ${opt}
      </button>
    `).join('')
  }

  ;(window as any).checkPuzzleAnswer = function(chosen: string) {
    const card = puzzleQuestions[puzzleIndex]
    const isRight = chosen === card.answer
    if (isRight) puzzleScore++

    document.querySelectorAll('.puzzle-option-btn').forEach((btn: any) => {
      btn.disabled = true
      if (btn.innerText.trim() === card.answer) btn.classList.add('correct')
      else if (btn.innerText.trim() === chosen && !isRight) btn.classList.add('wrong')
    })

    const fb = document.getElementById('puzzle-feedback')!
    fb.style.display = 'block'
    if (isRight) {
      fb.className = 'puzzle-feedback correct'
      fb.innerHTML = `🎉 答对啦！${card.praise}`
    } else {
      fb.className = 'puzzle-feedback wrong'
      fb.innerHTML = `💡 差点就猜对啦！正确答案是【${card.answer}】。${card.praise}`
    }

    const nextBtn = document.getElementById('btn-next-puzzle')!
    nextBtn.style.display = 'block'
    if (puzzleIndex === puzzleQuestions.length - 1) {
      nextBtn.innerText = `查看拼图闯关战果 🏆`
    } else {
      nextBtn.innerText = `下一关 ➔`
    }
  }

  ;(window as any).nextPuzzleRound = function() {
    puzzleIndex++
    if (puzzleIndex < puzzleQuestions.length) {
      renderCurrentPuzzle()
    } else {
      // 拼图闯关完成结算
      const total = puzzleQuestions.length
      let honorBadge = '🌟 华夏拼图小探险家'
      let starEmojis = '⭐⭐⭐'
      if (puzzleScore === 5) {
        honorBadge = '👑 华夏象形拼图地理大宗师 (满分卓越)'
        starEmojis = '⭐⭐⭐⭐⭐'
      } else if (puzzleScore >= 3) {
        honorBadge = '🚀 华夏象形拼图博学小明星'
        starEmojis = '⭐⭐⭐⭐'
      }

      const container = document.getElementById('puzzle-container')!
      container.innerHTML = `
        <div style="text-align:center;padding:1.5rem 0;">
          <div style="font-size:3.2rem;margin-bottom:0.5rem;">🎉</div>
          <h4 style="font-size:1.35rem;font-weight:900;color:#1e293b;margin:0 0 0.5rem;">恭喜完成华夏象形拼图大闯关！</h4>
          <div style="font-size:1.5rem;margin: 0.5rem 0;">${starEmojis}</div>
          <p style="font-size:1.1rem;color:#7c3aed;font-weight:bold;margin:0.25rem 0;">
            乐乐与月亮总共闯过 ${puzzleScore} / ${total} 关！(总分: ${puzzleScore * 20} 分)
          </p>
          <div style="display:inline-block;background:#f5f3ff;border:1px solid #ddd6fe;padding:0.4rem 1rem;border-radius:9999px;font-size:0.9rem;font-weight:800;color:#6d28d9;margin:0.75rem 0;">
            ${honorBadge}
          </div>
          <p style="font-size:0.85rem;color:#64748b;line-height:1.6;">
            看象形识华夏，34 省轮廓特征已经牢牢印在脑海中啦！
          </p>
          <div style="display:flex;gap:0.75rem;justify-content:center;margin-top:1.25rem;">
            <button class="btn-quiz-next" style="background:#7c3aed;width:auto;padding:0.6rem 1.5rem;" onclick="window.restartPuzzleGame()">再来一轮 🔄</button>
            <button class="btn-quiz-next" style="background:#0284c7;width:auto;padding:0.6rem 1.5rem;" onclick="window.closePuzzleModal()">返回地图 🇨🇳</button>
          </div>
        </div>
      `
    }
  }

  ;(window as any).restartPuzzleGame = function() {
    const container = document.getElementById('puzzle-container')!
    container.innerHTML = `
      <div class="puzzle-progress-bar-wrap">
        <div class="puzzle-progress-fill" id="puzzle-progress-fill" style="width: 20%;"></div>
      </div>
      <div class="puzzle-round-indicator">
        <span id="puzzle-round-txt">第 1 / 5 关</span>
        <span id="puzzle-score-txt">得分: 0 分</span>
      </div>

      <div class="puzzle-card-body">
        <div class="puzzle-metaphor-banner">
          <span class="puzzle-metaphor-icon" id="puzzle-icon">🦢</span>
          <div class="puzzle-metaphor-title" id="puzzle-metaphor">展翅天鹅 / 金鸡王冠</div>
        </div>
        <div class="puzzle-riddle-text" id="puzzle-riddle">
          正在生成题目...
        </div>
        <div class="puzzle-clue-box">
          <span class="clue-tag">💡 地理特征提示</span>
          <p id="puzzle-clue" class="clue-content">线索提示...</p>
        </div>
        <div class="puzzle-options-grid" id="puzzle-options"></div>
        <div id="puzzle-feedback" class="puzzle-feedback" style="display:none;"></div>
      </div>

      <div class="puzzle-footer">
        <button id="btn-next-puzzle" class="btn-puzzle-next" style="display:none;" onclick="window.nextPuzzleRound()">下一关 ➔</button>
      </div>
    `
    startPuzzleGame()
  }

  // 页面启动绑定
  document.addEventListener('DOMContentLoaded', () => {
    (window as any).siteBase = import.meta.env.BASE_URL || '/'

    // 初始化 ECharts 地图
    initChart()

    // 默认渲染四川
    const defaultProv = chinaGeographyData.find(p => p.id === currentProvinceId) || chinaGeographyData[0]
    renderProvinceDetail(defaultProv)

    // 检查 URL 参数或 Hash 是否指定了专题图层 (例如 #qinling_huaihe 或 ?theme=lianghu_divide)
    const urlParams = new URLSearchParams(window.location.search)
    const urlHash = window.location.hash.replace('#', '')
    const targetLayer = urlParams.get('layer') || urlParams.get('theme') || urlHash
    if (['qinling_huaihe', 'lianghu_divide', 'liangguang_divide', 'major_lakes', 'yangtze', 'yellow', 'mountains'].includes(targetLayer)) {
      document.querySelectorAll('.layer-pill').forEach(p => {
        if (p.getAttribute('data-layer') === targetLayer) p.classList.add('active')
        else p.classList.remove('active')
      })
      switchLayer(targetLayer)
    }

    // 大区切换胶囊
    document.querySelectorAll('.region-tab-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.region-tab-pill').forEach(p => p.classList.remove('active'))
        pill.classList.add('active')
        currentRegionFilter = pill.getAttribute('data-region') || '全部大区'
        filterProvinces()
      })
    })

    // 图层胶囊切换事件
    document.querySelectorAll('.layer-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.layer-pill').forEach(p => p.classList.remove('active'))
        pill.classList.add('active')
        const layer = pill.getAttribute('data-layer') || 'provinces'
        switchLayer(layer)
      })
    })

    // 图层重置按钮
    const btnLayerReset = document.getElementById('btn-layer-reset')
    btnLayerReset?.addEventListener('click', () => {
      document.querySelectorAll('.layer-pill').forEach(p => {
        if (p.getAttribute('data-layer') === 'provinces') p.classList.add('active')
        else p.classList.remove('active')
      })
      switchLayer('provinces')
    })

    // 搜索输入
    const searchInput = document.getElementById('geo-search-input') as HTMLInputElement
    const searchClear = document.getElementById('btn-geo-search-clear')!

    searchInput.addEventListener('input', () => {
      searchClear.style.display = searchInput.value ? 'inline-block' : 'none'
      filterProvinces()
    })

    searchClear.addEventListener('click', () => {
      searchInput.value = ''
      searchClear.style.display = 'none'
      filterProvinces()
    })

    // 视图模式切换
    document.querySelectorAll('.mode-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.mode-pill').forEach(p => p.classList.remove('active'))
        pill.classList.add('active')
        const mode = pill.getAttribute('data-mode') || 'all'
        applyViewMode(mode)
      })
    })
  })
</script>
