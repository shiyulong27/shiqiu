            <span>📜</span> 文史万年长卷
          </a>
          <a href="#section-science" class="dock-btn dock-btn-sci" data-target="section-science">
            <span>🚀</span> 自然科学探索
          </a>
          <a href="#section-growth" class="dock-btn dock-btn-grow" data-target="section-growth">
            <span>🌱</span> 青少美育成长
          </a>
        </nav>
      </div>
    </header>

