---
import Base from '../layouts/Base.astro'
import '../styles/learning.css'

const base = import.meta.env.BASE_URL

// 学科启蒙板块
const subjectModules = [
  {
    id: 'chinese-curriculum',
    title: '🌳 语文 · 小学1-6年级全景知识脑图',
    sub: '新课标统编版 · 可拖拽缩放脑图 · 识3000写2500 · 75+必背诗文',
    tag: '基础学科 · 语文全景',
    status: 'ready',
    link: `${base}chinese/grade1/`,
    badge: '🌟 1-6年级全景脑图',
    desc: '基于 ECharts 交互式脑图引擎，支持鼠标自由平移、滚轮缩放与分支折叠。全景呈现一年级拼音筑基、二年级部首写话、三年级修辞起步，至四年级文言启蒙、五年级名著精读、六年级小升初总复习的完整小学语文体系。',
    cardClass: 'card-chinese',
    icon: '🗺️',
    btnText: '🚀 打开 1~6 年级语文脑图 ➔',
    tags: ['1-6年级直达', '可拖拽脑图', '识3000写2500', '75+必背诗文', '小升初达标']
  },
  {
    id: 'math-curriculum',
    title: '📐 数学 · 小学1-6年级全景知识与思维导图',
    sub: '新课标2022版 · 等式方程思想 · 画图建模 · 除法深度辨析 · 割补极限化归',
    tag: '基础学科 · 数学全景',
    status: 'ready',
    link: `${base}math/grade1/`,
    badge: '🌟 1-6年级全景脑图',
    desc: '基于 ECharts 交互式脑图引擎，支持鼠标自由平移、滚轮缩放与分支折叠。深度融入等式与方程思想（天平平衡模型）、画图思想（线段图解和差倍/相遇追及）、割补拼摆转化、微积分极限割圆术，以及“除与除以”、等分除/包含除、商不变性质深度辨析。',
    cardClass: 'card-math',
    icon: '🗺️',
    btnText: '🚀 打开 1~6 年级数学脑图 ➔',
    tags: ['1-6年级直达', '可拖拽脑图', '等式天平', '线段图建模', '除与除以', '割补极限']
  },
  {
    id: 'english-curriculum',
    title: '🌍 英语 · 小学1-6年级全景知识脑图',
    sub: '新课标2022版 · 可拖拽缩放脑图 · 词汇/句型/四大时态/读写总复习',
    tag: '基础学科 · 英语全景',
    status: 'ready',
    link: `${base}english/grade1/`,
    badge: '🌟 1-6年级全景脑图',
    desc: '基于 ECharts 交互式脑图引擎，支持鼠标自由平移、滚轮缩放与分支折叠。全景呈现一年级拼读筑基、二年级日常语感、三年级Be动词语法，至四年级进行时、五年级过去将来时、六年级小升初四大时态大成与满分读写的完整小学英语体系。',
    cardClass: 'card-english',
    icon: '🗺️',
    btnText: '🚀 打开 1~6 年级英语脑图 ➔',
    tags: ['1-6年级直达', '可拖拽脑图', '四大时态', '原声点读', '小升初读写']
  },
  {
    id: 'chinese-poems',
    title: '🎙️ 国学古诗 · 童声沉浸点读台',
    sub: '小学1~6年级全12册必背127篇 · 经典绝句与文言小古文 · 律动节拍 · 挖空背诵',
    tag: '基础学科 · 语文古诗',
    status: 'ready',
    link: `${base}chinese/poems/`,
    badge: '🌟 127篇大满贯',
    desc: '面向小学1~6年级小朋友与家庭晨读。带调拼音、律动节拍断句、逐句逐字语音点读、单字田字格发音、诗眼挖空背诵挑战与全屏大字晨读投影模式。',
    cardClass: 'card-chinese',
    icon: '🎙️',
    btnText: '📖 进入古诗点读台 ➔',
    tags: ['全12册大满贯', '统编必背', '带调拼音', '节奏断句', '逐字点读', '挖空挑战', '全屏晨读']
  },
  {
    id: 'chinese',
    title: '📖 语文 · 语言与拼音启蒙',
    sub: '从零开始学拼音 · 象形字识字 · 经典童谣诵读',
    tag: '基础学科 · 语文',
    status: 'ready',
    link: `${base}chinese/pinyin/`,
    portalLink: `${base}chinese/`,
    badge: '🌟 拼音专页已上线',
    desc: '面向零基础小朋友与幼小衔接，超详细收录23声母、24韵母、16整体认读，配备顺口溜口诀、四线三格规范、发音点读与拼读合成魔法台。',
    cardClass: 'card-chinese',
    icon: '📖',
    btnText: '🎯 进入拼音王国 ➔',
    tags: ['汉语拼音', '四线三格', '顺口溜', '拼读魔法台', '听音闯关']
  },
  {
    id: 'math',
    title: '📐 数学 · 数感与逻辑思维',
    sub: '认识数字 0-100 · 10/20以内加减法 · 几何图形与时钟',
    tag: '基础学科 · 数学',
    status: 'ready',
    link: `${base}math/`,
    badge: '🧮 算术乐园已上线',
    desc: '通过数字双语点读、可视化小圆点算盘和趣味算式，培养孩子初步数感、逻辑思维与几何空间认知。',
    cardClass: 'card-math',
    icon: '📐',
    btnText: '🧮 进入数学乐园 ➔',
    tags: ['数字点读', '可视化算盘', '加减法', '几何形状']
  },
  {
    id: 'english',
    title: '🔤 英语 · 自然拼读与启蒙',
    sub: '26个英文字母 · Phonics 自然拼读 · 萌趣单词卡片',
    tag: '基础学科 · 英语',
    status: 'ready',
    link: `${base}english/`,
    badge: '🌍 自然拼读已上线',
    desc: '纯正语音互动点读，带小朋友轻松掌握 A-Z 26个字母发音规律、动物颜色高频词汇及日常礼貌问候。',
    cardClass: 'card-english',
    icon: '🔤',
    btnText: '🚀 进入英语乐园 ➔',
    tags: ['26个字母', '自然拼读', '单词图卡', '日常问候']
  }
]

// 青少成长与美育时光胶囊板块
const growthModules = [
  {
    id: 'growth-guide',
    title: '📚 青少文育全景进阶指南（一至高三）',
    sub: '文字铸骨（书籍）· 光影拓界（电影）· 旋律润心（音乐）',
    tag: '12年美育 · 书影音全景',
    status: 'ready',
    link: `${base}growth/guide/`,
    badge: '🌟 12年体系已上线',
    desc: '从小学低/中/高段、初中到高中的12年精神书架：覆盖世界殿堂级文学名著、传世经典电影与大师级交响与诗意童谣，附小学一年级10首金曲与赏析。',
    cardClass: 'card-guide',
    icon: '📚',
    btnText: '📖 进入文育精神书架 ➔',
    tags: ['12年书单', '大师影单', '经典音乐', '五大进阶期', '一年级金曲']
  },
  {
    id: 'growth-questionnaire',
    title: '📝 成长喜好与心智变化档案（年度问卷）',
    sub: '72道全景提问 · 多子女手足灵魂题 · 冲突应对场景 · 金钱压岁钱观',
    tag: '心智档案 · 动态时光胶囊',
    status: 'ready',
    link: `${base}growth/questionnaire/`,
    badge: '🎉 72题全景版已上线',
    desc: '专为小学一年级男孩及多子女家庭量身定制。涵盖吃喝、玩乐、恐惧(打针/挨打/大人言语恐吓)、一年级特质、手足偏心感受、学校冲突四大实战场景、花钱观与压岁钱管理。支持交互作答、本地暂存与一键打印装订。',
    cardClass: 'card-questionnaire',
    icon: '📝',
    btnText: '✍️ 填写问卷 / 一键打印 ➔',
    tags: ['72道精选题', '9大维度', '四类冲突应对', '手足与偏心', '压岁钱管理', '一键打印']
  }
]

// 原有通识与历史模块
const modules = [
  {
    id: 'history',
    title: '📜 上下五千年 · 历史长卷',
    sub: '中国历史长卷与世界文明平行对照，三栏中轴沉浸式展现',
    tag: '历史 / 纪年',
    status: 'ready',
    link: `${base}timeline/`,
    badge: '已上线',
    desc: '覆盖先秦至 2026 年中外重大历史事件、朝代演进、文明色带与历史人物，支持多级重要度筛选。',
  },
  {
    id: 'groups',
    title: '🌟 华夏历史天团 · 经典并称',
    sub: '从三皇五帝到唐宋八大家，历代巨擘天团、成团定位与历史羁绊全景长卷',
    tag: '历史 / 组合',
    status: 'ready',
    link: `${base}groups/`,
    badge: '🔥 专题已上线',
    desc: '收录三皇五帝、战国四公子、汉初三杰、竹林七贤、唐宋八大家等 17 组经典天团，全景展现成团定位、时代羁绊与代表巨作。',
  },
  {
    id: 'shanhaijing',
    title: '🦚 山海经 · 上古神兽与奇幻大荒',
    sub: '35 种异兽神禽 · 8 大创世史诗 · 十八卷全景导读与视频考据',
    tag: '典籍 / 志怪',
    status: 'ready',
    link: `${base}shanhaijing/`,
    badge: '🔥 重磅已上线',
    desc: '全景呈现先秦志怪之源《山海经》：生僻字拼音点读、九尾狐与烛龙等 35 种神兽图鉴、女娲夸父刑天等创世神话，支持多维筛选与音视频考据。',
  },
  {
    id: 'poets',
    title: '✍️ 千古风流 · 诗词名家',
    sub: '汇聚历代诗人作家的生平年谱、名篇佳作与人文足迹',
    tag: '诗文 / 年谱',
    status: 'ready',
    link: `${base}figures/`,
    badge: '🌟 人物详卷已上线',
    desc: '从屈原、李白、杜甫到龚自珍，43 位历史人物全景详卷：人生年谱、情境作品、足迹路线、关系网络与历代接受史。',
  },
  {
    id: 'astronomy',
    title: '🌌 浩瀚星图 · 天文历法',
    sub: '追溯天象记录、二十四节气演变、古今航天与宇宙观测',
    tag: '天文 / 历法',
    status: 'upcoming',
    link: '#',
    badge: '规划中',
    desc: '收录古天象记载、星图演变及现代商业航天与深空探索里程碑。',
  },
  {
    id: 'geography',
    title: '🗺️ 山川风物 · 地理图志',
    sub: '历代疆域演进 · 古今都城对照 · 丝路与运河长卷',
    tag: '地理 / 舆图',
    status: 'ready',
    link: `${base}geography/`,
    badge: '🌟 历代舆图已上线',
    desc: '系统呈现夏朝至1999年澳门回归各历史时期疆域变迁与古都演进，支持双地名考证、朝代版图对比与动态时间轴。',
  },
  {
    id: 'ai',
    title: '🤖 人工智能 · 大模型与 Agent 工程实战',
    sub: 'Embedding 向量 · RAG 全链路 · Re-rank 精排 · Memory 记忆 · Dify 工作流与面试题库',
    tag: 'AI / 智能体工程',
    status: 'ready',
    link: `${base}ai/`,
    badge: '🔥 重磅已上线',
    desc: '专为程序员、Agent 开发者与 Dify 工作流工程师打造：深度拆解向量索引、父子分块、RRF 排名融合、Harness 自动化评测与 10+ 道高频大厂硬核面试题。',
  },
  {
    id: 'science',
    title: '💡 科技与文明 · 发明突破',
    sub: '从古代四大发明到现代AI、量子计算与深海科考',
    tag: '科技 / 发明',
    status: 'upcoming',
    link: '#',
    badge: '规划中',
    desc: '记录人类科技文明演进史上最具颠覆性的发明与科学突破。',
  },
]
---

<Base title="十丘 (TenQiu) · 越九入十 · 全景知识与学科启蒙门户" wide={true}>
  <div class="tenqiu-portal">
    {/* 卷首 Hero 区域 */}
    <header class="portal-hero">
      <div class="hero-brand">
        <h1 class="hero-title">十 丘</h1>
        <span class="hero-en">TENQIU CODEX</span>
      </div>
      <p class="hero-tagline">越九入十 · 通识百科与学科启蒙全景平台</p>
    </header>

    {/* 🌟 核心新增：基础学科启蒙专区（语文·数学·英语） */}
    <section class="portal-subjects-section">
      <div class="portal-subjects-head">
        <h2 class="portal-subjects-title">🌱 基础学科启蒙 · 幼小衔接乐园</h2>
        <p class="portal-subjects-desc">从 0 开始系统启蒙 · 互动点读 · 声画同步 · 激发学习兴趣</p>
      </div>

      <div class="subjects-cards-grid">
        {subjectModules.map((sub) => (
          <div class={`subject-portal-card ${sub.cardClass}`}>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
              <span class="subject-card-icon">{sub.icon}</span>
              <span class="sub-tag tag-featured">{sub.badge}</span>
            </div>

            <h3 class="subject-card-title">{sub.title}</h3>
            <div class="subject-card-sub">{sub.sub}</div>

            <div class="subject-card-tags">
              {sub.tags.map((t) => (
                <span class="sub-tag">{t}</span>
              ))}
            </div>

            <p class="subject-card-desc">{sub.desc}</p>

            <div class="subject-card-foot">
              <a href={sub.link} class="subject-enter-btn">
                {sub.btnText}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 🌟 核心专区：青少成长与美育时光胶囊 */}
    <section class="portal-subjects-section" style="margin-top: 2.5rem; margin-bottom: 2.5rem;">
      <div class="portal-subjects-head">
        <h2 class="portal-subjects-title">🌱 青少成长与美育时光胶囊</h2>
        <p class="portal-subjects-desc">12年书影音美育进阶蓝图 · 年度心智喜好动态档案 · 专属儿童采访时光胶囊</p>
      </div>

      <div class="subjects-cards-grid">
        {growthModules.map((sub) => (
          <div class={`subject-portal-card ${sub.cardClass}`}>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
              <span class="subject-card-icon">{sub.icon}</span>
              <span class="sub-tag tag-featured" style="background: linear-gradient(135deg, #059669 0%, #2563eb 100%);">{sub.badge}</span>
            </div>

            <h3 class="subject-card-title">{sub.title}</h3>
            <div class="subject-card-sub">{sub.sub}</div>

            <div class="subject-card-tags">
              {sub.tags.map((t) => (
                <span class="sub-tag">{t}</span>
              ))}
            </div>

            <p class="subject-card-desc">{sub.desc}</p>

            <div class="subject-card-foot">
              <a href={sub.link} class="subject-enter-btn">
                {sub.btnText}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 通识与历史模块矩阵 Grid */}
    <div style="margin-bottom: 1.5rem; text-align: center;">
      <h2 style="font-size: 1.6rem; font-weight: 800; color: #1e293b; margin: 0 0 0.5rem;">📜 通识与历史长卷</h2>
      <p style="color: #64748b; font-size: 0.95rem; margin: 0;">穿越千年历史长河，纵览华夏文明与世界风物</p>
    </div>

    <main class="portal-modules-grid">
      {modules.map((m) => (
        <div class={`module-card module-${m.status}`}>
          <div class="module-head">
            <span class="module-tag">{m.tag}</span>
            <span class={`module-badge badge-${m.status}`}>{m.badge}</span>
          </div>

          <h3 class="module-title">{m.title}</h3>
          <p class="module-sub">{m.sub}</p>
          <p class="module-desc">{m.desc}</p>

          <div class="module-foot">
            {m.status === 'ready' ? (
              <a href={m.link} class="module-btn btn-primary">
                进入长卷 ➔
              </a>
            ) : (
              <span class="module-btn btn-disabled">规划建置中</span>
            )}
          </div>
        </div>
      ))}
    </main>

    <footer class="portal-footer">
      <p class="foot-text">【十丘】知识门户 · 纯静态构建 · 欢迎共同建设万象知识库</p>
      <p class="foot-text">
        <a href={`${base}growth/guide/`} style="color: #2563eb; font-weight: 600; text-decoration: none; margin-right: 1rem;">🌱 青少文育指南</a>
        <a href={`${base}growth/questionnaire/`} style="color: #059669; font-weight: 600; text-decoration: none; margin-right: 1rem;">📝 成长心智问卷</a>
        <a href={`${base}chinese/poems/`} style="color: #d97706; font-weight: 600; text-decoration: none; margin-right: 1rem;">🎙️ 国学古诗点读台</a>
        <a href={`${base}shanhaijing/`} style="color: #8b261e; font-weight: 600; text-decoration: none; margin-right: 1rem;">🦚 山海经大荒专页</a>
        <a href={`${base}ai/`} style="color: #2563eb; font-weight: 600; text-decoration: none; margin-right: 1rem;">🤖 AI & Agent 核心指南</a>
        <a href={`${base}chinese/pinyin/`} style="color: #e11d48; font-weight: 600; text-decoration: none; margin-right: 1rem;">🎯 汉语拼音专页</a>
        <a href={`${base}math/`} style="color: #059669; font-weight: 600; text-decoration: none; margin-right: 1rem;">📐 数学启蒙</a>
        <a href={`${base}english/`} style="color: #d97706; font-weight: 600; text-decoration: none; margin-right: 1rem;">🔤 英语自然拼读</a>
        <a href={`${base}1950/`} style="color: var(--muted); text-decoration: none;">1950年历史专页</a>
      </p>
    </footer>
  </div>
</Base>
