---
import Base from '../../layouts/Base.astro'
import '../../styles/learning.css'
import modulesData from '../../data/growthQuestionnaireData.json'

const base = import.meta.env.BASE_URL
const totalQuestions = modulesData.reduce((acc, m) => acc + m.questions.length, 0)
---

<Base title="成长喜好与心智变化档案（年度问卷 · 百题全景版）· 十丘" wide={true}>
  <div class="questionnaire-page">
    
    <!-- 顶部面包屑与操作栏 -->
    <header class="no-print q-top-bar">
      <nav class="q-breadcrumb">
        <a href={base} class="brand-link">十丘门户</a>
        <span>/</span>
        <a href={`${base}growth/guide/`} class="guide-link">青少文育指南</a>
        <span>/</span>
        <span class="curr-node">成长心智问卷（百题全景版）</span>
      </nav>
      <div class="q-actions">
        <button id="btnPrint" class="action-btn btn-print" title="打开系统打印对话框">
          打印问卷
        </button>
        <button id="btnSave" class="action-btn btn-save" title="本地暂存已填内容">
          保存草稿
        </button>
        <button id="btnReset" class="action-btn btn-reset" title="清空已填答案">
          重置
        </button>
      </div>
    </header>

    <!-- 顶部时光胶囊 Banner -->
    <section class="q-hero-card">
      <div class="hero-badge">时光胶囊 · 动态成长档案袋</div>
      <h1 class="hero-title">【我的成长时光胶囊】年度喜好与心智变化档案</h1>
      <p class="hero-subtitle">
        全景双轨架构（公共多选 58 题 + 学段多选 26 题 + 终章心智单选 16 题）· 整整 100 道全景提问 · 一年一测
      </p>

      <!-- 档案基础信息登记栏 -->
      <div class="child-info-bar">
        <div class="info-field">
          <label>孩子姓名：</label>
          <input type="text" id="infoName" placeholder="如：可乐 / 辰辰" />
        </div>
        <div class="info-field">
          <label>记录日期：</label>
          <input type="text" id="infoDate" placeholder="如：2026年9月20日" />
        </div>
        <div class="info-field">
          <label>年龄与年级：</label>
          <input type="text" id="infoAge" placeholder="如：7岁3个月 / 一年级" />
        </div>
        <div class="info-field">
          <label>记录节点：</label>
          <select id="infoNode">
            <option value="birthday">生日记录</option>
            <option value="school">新学年开学</option>
            <option value="newyear">跨年 / 春节除夕</option>
            <option value="other">其他特别日子</option>
          </select>
        </div>
      </div>

      <!-- 采访与使用提示 -->
      <div class="interview-tips no-print">
        <strong>采访提示</strong>：建议家长化身专访记者，在轻松自如的氛围中向孩子提问并记录真实心声。完成后点击右上角【打印问卷】或按 Ctrl+P 即可直接打印存档！
      </div>

      <!-- 实时完成度进度条 -->
      <div class="progress-container no-print">
        <div class="progress-info">
          <span>填写进度：<strong id="answeredCount">0</strong> / {totalQuestions} 题</span>
          <span id="progressPercent">0%</span>
        </div>
        <div class="progress-bar-track">
          <div class="progress-bar-fill" id="progressBarFill" style="width: 0%;"></div>
        </div>
      </div>
    </section>

    <!-- 问卷主体大类遍历 -->
    <main class="q-content-main">
      {modulesData.map((mod, index) => {
        const isFirstOfTrack = index === 0 || modulesData[index - 1].track !== mod.track
        return (
          <>
            {isFirstOfTrack && (
              <div class={`track-section-banner track-${mod.track}`}>
                <div class="track-header">
                  <span class="track-pill">
                    {mod.track === 'common'
                      ? '第一主轴 · 全周期公共类'
                      : mod.track === 'stage'
                      ? '第二主轴 · 学段周期类'
                      : '全卷终章 · 心智天平（单选专区）'}
                  </span>
                  <span class="track-scope-tag">
                    {mod.track === 'common'
                      ? '全年龄通用 · 跨阶段追踪'
                      : mod.track === 'stage'
                      ? '小学一年级专属包 · 阶段性切片'
                      : '核心性格 · 底层安全感与价值抉择'}
                  </span>
                </div>
                <p class="track-lead">
                  {mod.track === 'common'
                    ? '涵盖饮食、兴趣、心智、家庭、品格与未来等长效主题，每年一测，见证纵向成长轨迹。（第 1~58 题）'
                    : mod.track === 'stage'
                    ? '聚焦当前小学生活实景：课堂专注、书写日常、同伴相处七大微冲突实战与个性特质。（第 59~84 题）'
                    : '16 道单选关键心智抉择：必须且只能选一项最本能的真实倾向，洞察底层性格、安全感与人生底色。（第 85~100 题）'}
                </p>
              </div>
            )}
            <section class="module-group-card" id={`mod-${mod.id}`}>
              <div class="module-group-head">
                <div class="module-title-box">
                  <h2 class="module-title">{mod.title}</h2>
                  <p class="module-desc">{mod.desc}</p>
                </div>
              </div>

              <div class="questions-list">
                {mod.questions.map((item) => {
                  const isSingle = item.type === 'single'
                  return (
                    <div class="question-item" data-qid={item.id}>
                      <div class="q-title-row">
                        <span class="q-num-tag">Q{item.id}</span>
                        <h3 class="q-text">{item.q}</h3>
                      </div>

                      <div class="options-container">
                        {item.options.map((opt, optIdx) => {
                          const optKey = `q_${item.id}_opt_${optIdx}`
                          return (
                            <label class="option-label" for={optKey}>
                              <input
                                type={isSingle ? "radio" : "checkbox"}
                                name={`q_${item.id}`}
                                id={optKey}
                                value={opt}
                                class={isSingle ? "q-radio" : "q-checkbox"}
                              />
                              <span class="opt-text">{opt}</span>
                            </label>
                          )
                        })}
                      </div>

                      {item.hasInput && (
                        <div class="custom-input-box">
                          <span class="custom-input-prefix">补充说明 / 真实想法：</span>
                          <input
                            type="text"
                            name={`q_${item.id}_custom`}
                            class="custom-answer-input"
                            placeholder="写下孩子在此题的原话或补充想法..."
                          />
                        </div>
                      )}
                    </div>
                  )
                })}
              </div>
            </section>
          </>
        )
      })}
    </main>

    <!-- 底部操作与签名区 -->
    <footer class="q-bottom-card">
      <div class="print-signatures print-only">
        <div class="sig-line">受访孩子签名：__________________</div>
        <div class="sig-line">记录家长签名：__________________</div>
        <div class="sig-line">归档封存日期：_____年____月____日</div>
      </div>

      <div class="bottom-actions no-print">
        <button id="btnPrintBottom" class="action-btn btn-print-big">
          打印装订这份成长时光胶囊
        </button>
        <a href={`${base}growth/guide/`} class="action-btn btn-guide-big">
          前往 12年文育全景进阶指南 ➔
        </a>
      </div>
    </footer>
  </div>
</Base>

<style>
  .questionnaire-page {
    max-width: 1060px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    color: #1e293b;
    line-height: 1.6;
  }

  /* 顶部操作条 */
  .q-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .q-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: #64748b;
  }

  .q-breadcrumb a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
  }

  .q-breadcrumb a:hover {
    text-decoration: underline;
  }

  .q-breadcrumb .curr-node {
    font-weight: 700;
    color: #0f172a;
  }

  .q-actions {
    display: flex;
    gap: 0.6rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .btn-print {
    background: #059669;
    color: #ffffff;
    box-shadow: 0 2px 4px rgba(5, 150, 105, 0.2);
  }
  .btn-print:hover {
    background: #047857;
  }

  .btn-save {
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
  }
  .btn-save:hover {
    background: #1d4ed8;
  }

  .btn-reset {
    background: #f1f5f9;
    color: #64748b;
    border-color: #cbd5e1;
  }
  .btn-reset:hover {
    background: #fee2e2;
    color: #dc2626;
    border-color: #fca5a5;
  }

  /* 顶部 Hero Banner */
  .q-hero-card {
    background: linear-gradient(135deg, #f0fdf4 0%, #eff6ff 100%);
    border: 1px solid #bbf7d0;
    border-radius: 16px;
    padding: 2rem 1.8rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 16px rgba(5, 150, 105, 0.06);
  }

  .hero-badge {
    display: inline-block;
    padding: 0.25rem 0.8rem;
    background: #dcfce7;
    color: #15803d;
    font-size: 0.82rem;
    font-weight: 700;
    border-radius: 20px;
    margin-bottom: 0.8rem;
  }

  .hero-title {
    font-size: 1.85rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 0.5rem;
    line-height: 1.35;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: #475569;
    margin: 0 0 1.5rem;
  }

  .child-info-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    background: #ffffff;
    padding: 1.2rem;
    border-radius: 12px;
    border: 1px solid #cbd5e1;
    margin-bottom: 1.2rem;
  }

  .info-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .info-field label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #334155;
  }

  .info-field input,
  .info-field select {
    padding: 0.45rem 0.65rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.9rem;
    color: #1e293b;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .info-field input:focus,
  .info-field select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
  }

  .interview-tips {
    background: #fffbeb;
    border: 1px solid #fef3c7;
    border-left: 4px solid #f59e0b;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.88rem;
    color: #92400e;
    margin-bottom: 1.2rem;
    line-height: 1.55;
  }

  /* 进度条 */
  .progress-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.8rem 1rem;
  }

  .progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    font-weight: 700;
    color: #334155;
    margin-bottom: 0.4rem;
  }

  .progress-bar-track {
    height: 8px;
    background: #e2e8f0;
    border-radius: 4px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981 0%, #059669 100%);
    border-radius: 4px;
    transition: width 0.3s ease;
  }

  /* 主轴大分组横幅 */
  .track-section-banner {
    margin: 2.2rem 0 1.2rem;
    padding: 1.1rem 1.4rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .track-section-banner.track-common {
    background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
    border: 1px solid #a7f3d0;
    border-left: 5px solid #059669;
  }
  .track-section-banner.track-stage {
    background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
    border: 1px solid #bfdbfe;
    border-left: 5px solid #2563eb;
  }
  .track-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .track-pill {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
  }
  .track-scope-tag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
  }
  .track-common .track-scope-tag {
    background: #d1fae5;
    color: #065f46;
  }
  .track-stage .track-scope-tag {
    background: #dbeafe;
    color: #1e40af;
  }
  .track-lead {
    font-size: 0.88rem;
    color: #475569;
    margin: 0;
    line-height: 1.5;
  }

  /* 模块组卡片 */
  .module-group-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.6rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
  }

  .module-group-head {
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .module-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.35rem;
  }

  .module-desc {
    font-size: 0.9rem;
    color: #64748b;
    margin: 0;
  }

  /* 题目项 */
  .questions-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .question-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .question-item:hover {
    border-color: #cbd5e1;
  }

  .question-item.answered {
    background: #f0fdf4;
    border-color: #86efac;
  }

  .q-title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .q-num-tag {
    display: inline-block;
    background: #e2e8f0;
    color: #334155;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    margin-top: 0.15rem;
    white-space: nowrap;
  }

  .question-item.answered .q-num-tag {
    background: #10b981;
    color: #ffffff;
  }

  .q-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
    line-height: 1.45;
  }

  /* 选项列表（自适应网格复选框） */
  .options-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.55rem;
    margin-bottom: 0.8rem;
  }

  .option-label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.55rem 0.8rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #334155;
    user-select: none;
  }

  .option-label:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }

  .option-label input[type="checkbox"],
  .option-label input[type="radio"] {
    margin-top: 0.18rem;
    cursor: pointer;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: #2563eb;
    flex-shrink: 0;
  }

  .option-label.checked-opt {
    background: #eff6ff;
    border-color: #3b82f6;
    color: #1d4ed8;
    font-weight: 600;
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.12);
  }

  /* 自选填写框 */
  .custom-input-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
  }

  .custom-input-prefix {
    font-size: 0.85rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
  }

  .custom-answer-input {
    flex: 1;
    min-width: 240px;
    padding: 0.4rem 0.7rem;
    border: 1px dashed #94a3b8;
    background: #ffffff;
    border-radius: 6px;
    font-size: 0.9rem;
    outline: none;
    transition: border 0.2s;
  }

  .custom-answer-input:focus {
    border-color: #2563eb;
    border-style: solid;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
  }

  /* 底部操作卡片 */
  .q-bottom-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .bottom-actions {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .btn-print-big {
    padding: 0.8rem 1.8rem;
    background: #059669;
    color: #ffffff;
    font-size: 1.05rem;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(5, 150, 105, 0.25);
  }
  .btn-print-big:hover {
    background: #047857;
  }

  .btn-guide-big {
    padding: 0.8rem 1.8rem;
    background: #ffffff;
    color: #2563eb;
    border-color: #bfdbfe;
    font-size: 1.05rem;
    border-radius: 10px;
  }
  .btn-guide-big:hover {
    background: #eff6ff;
  }

  /* 打印专属显示与隐藏 */
  .print-only {
    display: none;
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .print-only {
      display: block !important;
    }

    /* 页面基底：白底纯黑字，打印专属紧凑比例 */
    body {
      background: #ffffff !important;
      color: #000000 !important;
    }
    .questionnaire-page {
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      color: #000000 !important;
      font-size: 10pt !important;
      line-height: 1.35 !important;
    }

    /* 顶部标题区 */
    .q-hero-card {
      background: none !important;
      border: 1.5px solid #000000 !important;
      box-shadow: none !important;
      padding: 0.6rem 0.8rem !important;
      margin-bottom: 0.8rem !important;
      page-break-after: avoid;
    }
    .hero-badge {
      display: none !important;
    }
    .hero-title {
      font-size: 1.25rem !important;
      font-weight: bold !important;
      color: #000000 !important;
      margin: 0 0 0.2rem !important;
      text-align: center !important;
    }
    .hero-subtitle {
      font-size: 0.8rem !important;
      color: #333333 !important;
      margin-bottom: 0.5rem !important;
      text-align: center !important;
    }

    /* 档案信息栏：四列横排单行 */
    .child-info-bar {
      border: 1px solid #000000 !important;
      background: none !important;
      padding: 0.4rem 0.6rem !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 0.5rem !important;
    }
    .info-field label {
      font-size: 0.82rem !important;
      font-weight: bold !important;
      color: #000000 !important;
      white-space: nowrap !important;
    }
    .info-field input, .info-field select {
      border: none !important;
      border-bottom: 1px solid #000000 !important;
      background: none !important;
      border-radius: 0 !important;
      font-size: 0.82rem !important;
      padding: 1px 2px !important;
      color: #000000 !important;
      width: 100% !important;
    }

    /* 主轴分区横幅 */
    .track-section-banner {
      background: none !important;
      border-top: 2px solid #000000 !important;
      border-bottom: 1px solid #000000 !important;
      border-left: none !important;
      border-right: none !important;
      box-shadow: none !important;
      padding: 0.4rem 0 !important;
      margin: 1rem 0 0.6rem !important;
      page-break-after: avoid;
    }
    .track-pill {
      background: #000000 !important;
      color: #ffffff !important;
      font-size: 0.82rem !important;
      font-weight: bold !important;
      padding: 1px 6px !important;
    }
    .track-scope-tag {
      font-size: 0.78rem !important;
      color: #333333 !important;
      font-weight: bold !important;
    }
    .track-lead {
      font-size: 0.78rem !important;
      color: #444444 !important;
      margin-top: 0.2rem !important;
    }

    /* 模块大类卡片：不整体避免断页，避免跨页大片留白 */
    .module-group-card {
      background: none !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin-bottom: 0.8rem !important;
      page-break-inside: auto !important;
    }
    .module-group-head {
      border-bottom: 1px solid #333333 !important;
      padding-bottom: 0.2rem !important;
      margin-bottom: 0.5rem !important;
      page-break-after: avoid;
    }
    .module-title {
      font-size: 1.02rem !important;
      font-weight: bold !important;
      color: #000000 !important;
      margin: 0 !important;
    }
    .module-desc {
      font-size: 0.78rem !important;
      color: #555555 !important;
      margin: 0.15rem 0 0 !important;
    }

    /* 题目单项：紧凑边框、题目不被中途腰斩跨页 */
    .question-item {
      background: none !important;
      border: 1px solid #cccccc !important;
      box-shadow: none !important;
      padding: 0.45rem 0.6rem !important;
      margin-bottom: 0.45rem !important;
      page-break-inside: avoid !important;
    }
    .q-title-row {
      margin-bottom: 0.25rem !important;
      gap: 0.4rem !important;
    }
    .q-num-tag {
      background: #000000 !important;
      color: #ffffff !important;
      font-size: 0.75rem !important;
      padding: 1px 5px !important;
      font-weight: bold !important;
      border-radius: 2px !important;
    }
    .q-text {
      font-size: 0.9rem !important;
      font-weight: 600 !important;
      color: #000000 !important;
    }

    /* 紧凑选项横排流式排版（类似纸质测验方框） */
    .options-container {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 0.25rem 0.9rem !important;
      margin-top: 0.25rem !important;
    }
    .option-label {
      background: none !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.3rem !important;
      font-size: 0.84rem !important;
      color: #000000 !important;
      cursor: default !important;
    }
    .option-label:hover {
      background: none !important;
      border: none !important;
    }
    .option-label input[type="checkbox"] {
      appearance: none !important;
      -webkit-appearance: none !important;
      width: 11px !important;
      height: 11px !important;
      border: 1.2px solid #000000 !important;
      border-radius: 2px !important;
      margin: 0 !important;
      vertical-align: middle !important;
      position: relative !important;
      background: #ffffff !important;
    }
    .option-label input[type="checkbox"]:checked {
      background-color: #000000 !important;
    }
    .option-label input[type="checkbox"]:checked::after {
      content: '✓' !important;
      color: #ffffff !important;
      font-size: 9px !important;
      position: absolute !important;
      top: -3px !important;
      left: 1px !important;
    }
    .option-label input[type="radio"] {
      appearance: none !important;
      -webkit-appearance: none !important;
      width: 11px !important;
      height: 11px !important;
      border: 1.2px solid #000000 !important;
      border-radius: 50% !important;
      margin: 0 !important;
      vertical-align: middle !important;
      position: relative !important;
      background: #ffffff !important;
    }
    .option-label input[type="radio"]:checked {
      background-color: #000000 !important;
    }
    .option-label input[type="radio"]:checked::after {
      content: '' !important;
      width: 5px !important;
      height: 5px !important;
      border-radius: 50% !important;
      background: #ffffff !important;
      position: absolute !important;
      top: 2px !important;
      left: 2px !important;
    }

    /* 自定义补充输入（横线下划线供手写） */
    .custom-input-box {
      margin-top: 0.3rem !important;
      padding-top: 0.2rem !important;
      border-top: 1px dotted #dddddd !important;
      display: flex !important;
      align-items: center !important;
      gap: 0.3rem !important;
    }
    .custom-input-prefix {
      font-size: 0.78rem !important;
      color: #444444 !important;
      white-space: nowrap !important;
    }
    .custom-answer-input {
      border: none !important;
      border-bottom: 1px solid #333333 !important;
      background: none !important;
      border-radius: 0 !important;
      font-size: 0.8rem !important;
      padding: 1px 3px !important;
      height: 18px !important;
      flex: 1 !important;
      color: #000000 !important;
    }

    /* 纸质问卷专属底部签字与评定栏 */
    .print-signatures {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      margin-top: 1.5rem !important;
      padding-top: 1rem !important;
      border-top: 1.5px solid #000000 !important;
      font-size: 0.88rem !important;
      font-weight: 600 !important;
      page-break-inside: avoid !important;
    }
  }
</style>

<script>
  // 本地存储键名
  const STORAGE_KEY = 'tenqiu_growth_questionnaire_v3'

  function updateProgress() {
    const total = document.querySelectorAll(".question-item").length || 100
    const answeredItems = document.querySelectorAll('.question-item.answered').length
    const countEl = document.getElementById('answeredCount')
    const percentEl = document.getElementById('progressPercent')
    const fillEl = document.getElementById('progressBarFill')

    const percent = Math.round((answeredItems / total) * 100)

    if (countEl) countEl.innerText = String(answeredItems)
    if (percentEl) percentEl.innerText = `${percent}%`
    if (fillEl) fillEl.style.width = `${percent}%`
  }

  function checkQuestionStatus(qItem: HTMLElement) {
    const checked = qItem.querySelectorAll('input[type="checkbox"]:checked, input[type="radio"]:checked')
    const customInput = qItem.querySelector('.custom-answer-input') as HTMLInputElement | null
    const hasCustomText = customInput && customInput.value.trim().length > 0

    if (checked.length > 0 || hasCustomText) {
      qItem.classList.add('answered')
    } else {
      qItem.classList.remove('answered')
    }
  }

  function saveToLocal() {
    const data: Record<string, any> = {
      name: (document.getElementById('infoName') as HTMLInputElement)?.value || '',
      date: (document.getElementById('infoDate') as HTMLInputElement)?.value || '',
      age: (document.getElementById('infoAge') as HTMLInputElement)?.value || '',
      node: (document.getElementById('infoNode') as HTMLSelectElement)?.value || '',
      answers: {},
      customs: {}
    }

    // 收集复选框选项（支持多选）
    const answersMap: Record<string, string[]> = {}
    document.querySelectorAll('.question-item').forEach((qItem) => {
      const qId = qItem.getAttribute('data-qid')
      if (!qId) return
      const checkedList = Array.from(qItem.querySelectorAll('input[type="checkbox"]:checked, input[type="radio"]:checked'))
        .map((el) => (el as HTMLInputElement).value)
      if (checkedList.length > 0) {
        answersMap[`q_${qId}`] = checkedList
      }
    })
    data.answers = answersMap

    // 收集输入框
    document.querySelectorAll('.custom-answer-input').forEach((inp) => {
      const input = inp as HTMLInputElement
      if (input.value.trim()) {
        data.customs[input.name] = input.value.trim()
      }
    })

    localStorage.setItem(STORAGE_KEY, JSON.stringify(data))
  }

  function loadFromLocal() {
    try {
      const savedStr = localStorage.getItem(STORAGE_KEY)
      if (!savedStr) return

      const data = JSON.parse(savedStr)
      if (data.name) (document.getElementById('infoName') as HTMLInputElement).value = data.name
      if (data.date) (document.getElementById('infoDate') as HTMLInputElement).value = data.date
      if (data.age) (document.getElementById('infoAge') as HTMLInputElement).value = data.age
      if (data.node) (document.getElementById('infoNode') as HTMLSelectElement).value = data.node

      if (data.answers) {
        Object.keys(data.answers).forEach((name) => {
          const val = data.answers[name]
          const valList = Array.isArray(val) ? val : [val]
          valList.forEach((v) => {
            const input = document.querySelector(`input[name="${name}"][value="${CSS.escape(v)}"]`) as HTMLInputElement
            if (input) {
              input.checked = true
              const parentLabel = input.closest('.option-label')
              if (parentLabel) parentLabel.classList.add('checked-opt')
            }
          })
        })
      }

      if (data.customs) {
        Object.keys(data.customs).forEach((name) => {
          const inp = document.querySelector(`input[name="${name}"]`) as HTMLInputElement
          if (inp) {
            inp.value = data.customs[name]
          }
        })
      }

      document.querySelectorAll('.question-item').forEach((q) => {
        checkQuestionStatus(q as HTMLElement)
      })

      updateProgress()
    } catch (e) {
      console.warn('Failed to load questionnaire draft', e)
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // 选项变更监听（复选框支持独立多选与反选）
    document.querySelectorAll('.question-item').forEach((qItem) => {
      const inputs = qItem.querySelectorAll('input[type="checkbox"], input[type="radio"]')
      inputs.forEach((input) => {
        input.addEventListener('change', () => {
          const parentLabel = input.closest('.option-label')
          if ((input as HTMLInputElement).checked) {
            parentLabel?.classList.add('checked-opt')
          } else {
            parentLabel?.classList.remove('checked-opt')
          }
          checkQuestionStatus(qItem as HTMLElement)
          updateProgress()
          saveToLocal()
        })
      })

      const customInput = qItem.querySelector('.custom-answer-input')
      if (customInput) {
        customInput.addEventListener('input', () => {
          checkQuestionStatus(qItem as HTMLElement)
          updateProgress()
          saveToLocal()
        })
      }
    })

    // 基本信息字段监听
    ;['infoName', 'infoDate', 'infoAge', 'infoNode'].forEach((id) => {
      const el = document.getElementById(id)
      if (el) {
        el.addEventListener('input', saveToLocal)
        el.addEventListener('change', saveToLocal)
      }
    })

    // 按钮动作
    const handlePrint = () => window.print()
    document.getElementById('btnPrint')?.addEventListener('click', handlePrint)
    document.getElementById('btnPrintBottom')?.addEventListener('click', handlePrint)

    document.getElementById('btnSave')?.addEventListener('click', () => {
      saveToLocal()
      alert('问卷草稿已成功保存到当前浏览器本地！随时刷新不会丢失。')
    })

    document.getElementById('btnReset')?.addEventListener('click', () => {
      if (confirm('确定要清空所有填写的答案并重置问卷吗？')) {
        localStorage.removeItem(STORAGE_KEY)
        window.location.reload()
      }
    })

    // 初次加载草稿
    loadFromLocal()
  })
</script>
