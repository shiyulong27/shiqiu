    outline: none;
    transition: border 0.2s;
  }

  .custom-answer-input:focus {
    border-color: #2563eb;
    border-style: solid;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
  }

  /* 底部操作卡片 */
  .q-bottom-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .bottom-actions {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .btn-print-big {
    padding: 0.8rem 1.8rem;
    background: #059669;
    color: #ffffff;
    font-size: 1.05rem;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(5, 150, 105, 0.25);
  }
  .btn-print-big:hover {
    background: #047857;
  }

  .btn-guide-big {
    padding: 0.8rem 1.8rem;
    background: #ffffff;
    color: #2563eb;
    border-color: #bfdbfe;
    font-size: 1.05rem;
    border-radius: 10px;
  }
  .btn-guide-big:hover {
    background: #eff6ff;
  }

  /* 打印专属显示与隐藏 */
  .print-only {
    display: none;
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .print-only {
      display: block !important;
    }
    .questionnaire-page {
      max-width: 100% !important;
      padding: 0 !important;
      color: #000000 !important;
    }
    .q-hero-card {
      background: none !important;
      border: 1px solid #000 !important;
      box-shadow: none !important;
      padding: 1rem !important;
      page-break-after: avoid;
    }
    .hero-title {
      font-size: 1.5rem !important;
      color: #000 !important;
    }
    .child-info-bar {
      border: 1px solid #333 !important;
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .module-group-card {
      box-shadow: none !important;
      border: 1px solid #999 !important;
      page-break-inside: avoid;
      margin-bottom: 1.5rem !important;
      padding: 1rem !important;
    }
    .question-item {
      background: none !important;
      border: 1px solid #ccc !important;
      page-break-inside: avoid;
      margin-bottom: 0.8rem !important;
    }
    .option-label {
      border: 1px solid #ddd !important;
      background: none !important;
    }
    .custom-answer-input {
      border-bottom: 1px solid #000 !important;
      border-top: none !important;
      border-left: none !important;
      border-right: none !important;
      border-radius: 0 !important;
    }
    .print-signatures {
      display: flex;
      justify-content: space-between;
      margin-top: 2rem;
      padding-top: 1rem;
      font-size: 0.95rem;
      font-weight: 700;
    }
  }
</style>

<script>
  // 本地存储键名
  const STORAGE_KEY = 'tenqiu_growth_questionnaire_v1'

  function updateProgress() {
    const total = 72
    const answeredItems = document.querySelectorAll('.question-item.answered').length
    const countEl = document.getElementById('answeredCount')
    const percentEl = document.getElementById('progressPercent')
    const fillEl = document.getElementById('progressBarFill')

    const percent = Math.round((answeredItems / total) * 100)

    if (countEl) countEl.innerText = String(answeredItems)
    if (percentEl) percentEl.innerText = `${percent}%`
    if (fillEl) fillEl.style.width = `${percent}%`
  }

  function checkQuestionStatus(qItem: HTMLElement) {
    const radios = qItem.querySelectorAll('input[type="radio"]:checked')
    const customInput = qItem.querySelector('.custom-answer-input') as HTMLInputElement | null
    const hasCustomText = customInput && customInput.value.trim().length > 0

    if (radios.length > 0 || hasCustomText) {
      qItem.classList.add('answered')
    } else {
      qItem.classList.remove('answered')
    }
  }

  function saveToLocal() {
    const data: Record<string, any> = {
      name: (document.getElementById('infoName') as HTMLInputElement)?.value || '',
      date: (document.getElementById('infoDate') as HTMLInputElement)?.value || '',
      age: (document.getElementById('infoAge') as HTMLInputElement)?.value || '',
      node: (document.getElementById('infoNode') as HTMLSelectElement)?.value || '',
      answers: {},
      customs: {}
    }

    // 收集选项
    document.querySelectorAll('input[type="radio"]:checked').forEach((radio) => {
      const r = radio as HTMLInputElement
      data.answers[r.name] = r.value
    })

    // 收集输入框
    document.querySelectorAll('.custom-answer-input').forEach((inp) => {
      const input = inp as HTMLInputElement
      if (input.value.trim()) {
        data.customs[input.name] = input.value.trim()
      }
    })

    localStorage.setItem(STORAGE_KEY, JSON.stringify(data))
  }

  function loadFromLocal() {
    try {
      const savedStr = localStorage.getItem(STORAGE_KEY)
      if (!savedStr) return

      const data = JSON.parse(savedStr)
      if (data.name) (document.getElementById('infoName') as HTMLInputElement).value = data.name
      if (data.date) (document.getElementById('infoDate') as HTMLInputElement).value = data.date
      if (data.age) (document.getElementById('infoAge') as HTMLInputElement).value = data.age
      if (data.node) (document.getElementById('infoNode') as HTMLSelectElement).value = data.node

      if (data.answers) {
        Object.keys(data.answers).forEach((name) => {
          const val = data.answers[name]
          const radio = document.querySelector(`input[name="${name}"][value="${CSS.escape(val)}"]`) as HTMLInputElement
          if (radio) {
            radio.checked = true
            const parentLabel = radio.closest('.option-label')
            if (parentLabel) parentLabel.classList.add('checked-opt')
          }
        })
      }

      if (data.customs) {
        Object.keys(data.customs).forEach((name) => {
          const inp = document.querySelector(`input[name="${name}"]`) as HTMLInputElement
          if (inp) {
            inp.value = data.customs[name]
          }
        })
      }

      document.querySelectorAll('.question-item').forEach((q) => {
        checkQuestionStatus(q as HTMLElement)
      })

      updateProgress()
    } catch (e) {
      console.warn('Failed to load questionnaire draft', e)
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // 选项变更监听
    document.querySelectorAll('.question-item').forEach((qItem) => {
      const radios = qItem.querySelectorAll('input[type="radio"]')
      radios.forEach((r) => {
        r.addEventListener('change', () => {
          // 清除同组其他 label checked-opt
          const qName = (r as HTMLInputElement).name
          document.querySelectorAll(`input[name="${qName}"]`).forEach((sib) => {
            sib.closest('.option-label')?.classList.remove('checked-opt')
          })
          r.closest('.option-label')?.classList.add('checked-opt')
          checkQuestionStatus(qItem as HTMLElement)
          updateProgress()
          saveToLocal()
        })
      })

      const customInput = qItem.querySelector('.custom-answer-input')
      if (customInput) {
        customInput.addEventListener('input', () => {
          checkQuestionStatus(qItem as HTMLElement)
          updateProgress()
          saveToLocal()
        })
      }
    })

    // 基本信息字段监听
    ;['infoName', 'infoDate', 'infoAge', 'infoNode'].forEach((id) => {
      const el = document.getElementById(id)
      if (el) {
        el.addEventListener('input', saveToLocal)
        el.addEventListener('change', saveToLocal)
      }
    })

    // 按钮动作
    const handlePrint = () => window.print()
    document.getElementById('btnPrint')?.addEventListener('click', handlePrint)
    document.getElementById('btnPrintBottom')?.addEventListener('click', handlePrint)

    document.getElementById('btnSave')?.addEventListener('click', () => {
      saveToLocal()
      alert('✅ 问卷草稿已成功保存到当前浏览器本地！随时刷新不会丢失。')
    })

    document.getElementById('btnReset')?.addEventListener('click', () => {
      if (confirm('确定要清空所有填写的答案并重置问卷吗？')) {
        localStorage.removeItem(STORAGE_KEY)
        window.location.reload()
      }
    })

    // 初次加载草稿
    loadFromLocal()
  })
</script>
