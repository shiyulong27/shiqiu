<Base title="成长喜好与心智变化档案（年度问卷 · 72题全景版）· 十丘" wide={true}>
  <div class="questionnaire-page">
    
    <!-- 顶部面包屑与操作栏 -->
    <header class="no-print q-top-bar">
      <nav class="q-breadcrumb">
        <a href={base} class="brand-link">🏛️ 十丘门户</a>
        <span>/</span>
        <a href={`${base}growth/guide/`} class="guide-link">🌱 青少文育指南</a>
        <span>/</span>
        <span class="curr-node">📝 成长心智问卷（72题）</span>
      </nav>
      <div class="q-actions">
        <button id="btnPrint" class="action-btn btn-print" title="打开系统打印对话框">
          🖨️ 打印问卷
        </button>
        <button id="btnSave" class="action-btn btn-save" title="本地暂存已填内容">
          💾 保存草稿
        </button>
        <button id="btnReset" class="action-btn btn-reset" title="清空已填答案">
          🔄 重置
        </button>
      </div>
    </header>

    <!-- 顶部时光胶囊 Banner -->
    <section class="q-hero-card">
      <div class="hero-badge">🌱 时光胶囊 · 动态成长档案袋</div>
      <h1 class="hero-title">【我的成长时光胶囊】年度喜好与心智变化档案</h1>
      <p class="hero-subtitle">
        专为小学一年级小男孩及多子女家庭量身定制 · 72 道全景灵魂提问 · 一年一测
      </p>

      <!-- 档案基础信息登记栏 -->
      <div class="child-info-bar">
        <div class="info-field">
          <label>👦 孩子姓名：</label>
          <input type="text" id="infoName" placeholder="如：可乐 / 辰辰" />
        </div>
        <div class="info-field">
          <label>📅 记录日期：</label>
          <input type="text" id="infoDate" placeholder="如：2026年9月20日" />
        </div>
        <div class="info-field">
          <label>🎂 当前年龄与年级：</label>
          <input type="text" id="infoAge" placeholder="如：7岁3个月 / 一年级" />
        </div>
        <div class="info-field">
          <label>🎯 记录节点：</label>
          <select id="infoNode">
            <option value="birthday">🎂 生日专属记录</option>
            <option value="school">🎒 新学年开学</option>
            <option value="newyear">🧧 跨年 / 春节除夕</option>
            <option value="other">⭐ 其他特别日子</option>
          </select>
        </div>
      </div>

      <!-- 采访与使用提示 -->
      <div class="interview-tips no-print">
        💡 <strong>采访小贴士</strong>：建议爸爸妈妈化身“电视台专访小记者”，一边录像/录音，一边带着微笑把选项念给孩子听。让孩子在轻松自如的氛围中表达真实心声。完成后点击右上角【🖨️ 打印问卷】可直接存档进成长档案袋！
      </div>

      <!-- 实时完成度进度条 -->
      <div class="progress-container no-print">
        <div class="progress-info">
          <span>📝 填写进度：<strong id="answeredCount">0</strong> / 72 题</span>
          <span id="progressPercent">0%</span>
        </div>
        <div class="progress-bar-track">
          <div class="progress-bar-fill" id="progressBarFill" style="width: 0%;"></div>
        </div>
      </div>
    </section>

    <!-- 问卷主体大类遍历 -->
    <main class="q-content-main">
      {modulesData.map((mod) => (
        <section class="module-group-card" id={`mod-${mod.id}`}>
          <div class="module-group-head">
            <div class="module-title-box">
              <h2 class="module-title">{mod.title}</h2>
              <p class="module-desc">{mod.desc}</p>
            </div>
          </div>

          <div class="questions-list">
            {mod.questions.map((item) => (
              <div class="question-item" data-qid={item.id}>
                <div class="q-title-row">
                  <span class="q-num-tag">Q{item.id}</span>
                  <h3 class="q-text">{item.q}</h3>
                </div>

                <div class="options-container">
                  {item.options.map((opt, optIdx) => {
                    const optKey = `q_${item.id}_opt_${optIdx}`
                    const isLast = optIdx === item.options.length - 1
                    return (
                      <label class="option-label" for={optKey}>
                        <input
                          type="radio"
                          name={`q_${item.id}`}
                          id={optKey}
                          value={opt}
                          class="q-radio"
                        />
                        <span class="opt-custom-radio"></span>
                        <span class="opt-text">{opt}</span>
                      </label>
                    )
                  })}
                </div>

                {item.hasInput && (
                  <div class="custom-input-box">
                    <span class="custom-input-prefix">✍️ 自选/补充/真实童语：</span>
                    <input
                      type="text"
                      name={`q_${item.id}_custom`}
                      class="custom-answer-input"
                      placeholder="写下孩子在此题的原话或补充想法..."
                    />
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      ))}
    </main>

    <!-- 底部操作与签名区 -->
    <footer class="q-bottom-card">
      <div class="print-signatures print-only">
        <div class="sig-line">孩子签名/手印：__________________</div>
        <div class="sig-line">采访人（爸爸/妈妈）签名：__________________</div>
        <div class="sig-line">归档封存日期：_____年____月____日</div>
      </div>

      <div class="bottom-actions no-print">
        <button id="btnPrintBottom" class="action-btn btn-print-big">
          🖨️ 打印装订这份成长时光胶囊
        </button>
        <a href={`${base}growth/guide/`} class="action-btn btn-guide-big">
          📚 前往 12年文育全景进阶指南 ➔
        </a>
      </div>
    </footer>
  </div>
</Base>

