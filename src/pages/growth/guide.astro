---
import Base from '../../layouts/Base.astro'
import '../../styles/learning.css'

const base = import.meta.env.BASE_URL
---

<Base title="青少文育全景进阶指南（小学一年级至高三）· 书籍 · 电影 · 音乐 · 十丘" wide={true}>
  <div class="growth-guide-page" style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; color: #1e293b;">
    
    <!-- 顶部面包屑与快捷导航 -->
    <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
      <nav style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; color: #64748b;">
        <a href={base} style="color: #2563eb; text-decoration: none; font-weight: 600;">🏛️ 十丘门户</a>
        <span>/</span>
        <span style="color: #0f172a; font-weight: 700;">🌱 青少文育全景进阶指南</span>
      </nav>
      <div style="display: flex; gap: 0.75rem;">
        <a href={base} style="padding: 0.4rem 0.9rem; background: #f1f5f9; color: #475569; border-radius: 8px; text-decoration: none; font-size: 0.88rem; font-weight: 600;">🏠 门户首页</a>
        <a href={`${base}growth/questionnaire/`} style="padding: 0.4rem 0.9rem; background: #059669; color: #ffffff; border-radius: 8px; text-decoration: none; font-size: 0.88rem; font-weight: 600; box-shadow: 0 2px 4px rgba(5,150,105,0.2);">📝 成长心智问卷 ➔</a>
      </div>
    </header>

    <!-- 顶部 Hero Banner -->
    <section style="background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%); border: 1px solid #bfdbfe; border-radius: 16px; padding: 2.5rem 2rem; margin-bottom: 2.5rem; text-align: center; box-shadow: 0 4px 12px rgba(37,99,235,0.05);">
      <span style="display: inline-block; padding: 0.3rem 0.9rem; background: #dbeafe; color: #1d4ed8; font-size: 0.85rem; font-weight: 700; border-radius: 20px; margin-bottom: 1rem;">
        🌱 12年家庭美育体系 · 完整进阶蓝图
      </span>
      <h1 style="font-size: 2.3rem; font-weight: 900; color: #0f172a; margin: 0 0 1rem; line-height: 1.3;">
        青少文育全景进阶指南
      </h1>
      <p style="font-size: 1.1rem; color: #475569; max-width: 800px; margin: 0 auto 1.5rem; line-height: 1.6;">
        <strong>文字铸骨</strong>（书籍） · <strong>光影拓界</strong>（电影） · <strong>旋律润心</strong>（音乐）。为孩子小学一年级至高三毕业打造的殿堂级美育精神书架。
      </p>

      <!-- 快捷阶段跳转锚点 -->
      <div style="display: flex; justify-content: center; gap: 0.6rem; flex-wrap: wrap;">
        <a href="#stage-1" style="padding: 0.4rem 0.8rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 20px; font-size: 0.85rem; color: #334155; text-decoration: none; font-weight: 600;">① 小学低段 (1~2年级)</a>
        <a href="#stage-2" style="padding: 0.4rem 0.8rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 20px; font-size: 0.85rem; color: #334155; text-decoration: none; font-weight: 600;">② 小学中段 (3~4年级)</a>
        <a href="#stage-3" style="padding: 0.4rem 0.8rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 20px; font-size: 0.85rem; color: #334155; text-decoration: none; font-weight: 600;">③ 小学高段 (5~6年级)</a>
        <a href="#stage-4" style="padding: 0.4rem 0.8rem; background: #fef2f2; border: 1px solid #fecaca; border-radius: 20px; font-size: 0.85rem; color: #dc2626; text-decoration: none; font-weight: 700;">④ 初中阶段 (7~9年级) ★黄金期</a>
        <a href="#stage-5" style="padding: 0.4rem 0.8rem; background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 20px; font-size: 0.85rem; color: #7e22ce; text-decoration: none; font-weight: 700;">⑤ 高中阶段 (10~12年级) ★少而精</a>
      </div>
    </section>

    <!-- 第一篇：小学低段 -->
    <section id="stage-1" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2rem; margin-bottom: 2.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;">
        <span style="font-size: 2rem;">🌱</span>
        <div>
          <h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin: 0;">第一篇：小学低段（1~2年级）· 纯真、想象力与天籁启蒙</h2>
          <p style="color: #64748b; font-size: 0.95rem; margin: 0.25rem 0 0;">拼音转文字破冰，建立善良同理心，用清亮诗意的童谣爱上音乐</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <!-- 书籍卡片 -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
          <h3 style="color: #2563eb; font-size: 1.15rem; margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
            <span>📚</span> 精神书架
          </h3>
          <ul style="padding-left: 1.2rem; color: #334155; line-height: 1.8; font-size: 0.95rem;">
            <li><strong>《中国神话故事》（注音版）</strong>：盘古、精卫、大禹，英雄主义起点</li>
            <li><strong>《夏洛的网》（美·怀特）</strong>：友谊、生命与承诺的初体验</li>
            <li><strong>《小猪唏哩呼噜》《没头脑和不高兴》</strong>：原创幽默文学，自主阅读破冰</li>
            <li><strong>《安徒生童话》（叶君健 译）</strong>：同情弱者与善良的心灵底色</li>
          </ul>
        </div>

        <!-- 电影卡片 -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
          <h3 style="color: #059669; font-size: 1.15rem; margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
            <span>🎬</span> 经典电影
          </h3>
          <ul style="padding-left: 1.2rem; color: #334155; line-height: 1.8; font-size: 0.95rem;">
            <li><strong>《音乐之声》</strong>：影史歌舞第一片，家庭歌声与乐观风骨</li>
            <li><strong>《小鞋子》</strong>：贫穷却极具尊严自爱的奔跑，顶级同理心教育</li>
            <li><strong>《机器人总动员 WALL-E》</strong>：极致孤独与纯爱，环保反思</li>
            <li><strong>《龙猫》《寻梦环游记》《狮子王》</strong>：童年温情与大自然精灵</li>
          </ul>
        </div>

        <!-- 音乐卡片（一年级10首金曲） -->
        <div style="background: #fdf4ff; border: 1px solid #f5d0fe; border-radius: 12px; padding: 1.25rem; grid-column: 1 / -1;">
          <h3 style="color: #a21caf; font-size: 1.15rem; margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
            <span>🎵</span> 一年级专属 · 10 首中文经典金曲（首首经典，朗朗上口）
          </h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; font-size: 0.92rem;">
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">1. 《让我们荡起双桨》（乔羽词）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">2. 《童年》（罗大佑）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">3. 《兰花草》（胡适诗）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">4. 《蜗牛与黄鹂鸟》（童真幽默）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">5. 《小燕子》（春之赞歌）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">6. 《小螺号》（海风与欢快律动）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">7. 《快乐的节日》（小鸟在前面带路）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">8. 《踏浪》（轻盈如跳绳）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">9. 《卖报歌》（聂耳·清脆朝气）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #f0abfc;">10. 《鲁冰花》（深沉母爱摇篮曲）</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 第二篇：小学中段 -->
    <section id="stage-2" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2rem; margin-bottom: 2.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;">
        <span style="font-size: 2rem;">🧭</span>
        <div>
          <h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin: 0;">第二篇：小学中段（3~4年级）· 历史通识、少年探索与自然律动</h2>
          <p style="color: #64748b; font-size: 0.95rem; margin: 0.25rem 0 0;">建立历史大格局，懂得独立勇气与自我审视，体味田园与自然之美</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
          <h3 style="color: #2563eb; font-size: 1.15rem; margin-top: 0;">📚 精神书架</h3>
          <ul style="padding-left: 1.2rem; color: #334155; line-height: 1.8; font-size: 0.95rem;">
            <li><strong>《林汉达中国历史故事集》</strong>：春秋至三国，通俗口语化历史神作</li>
            <li><strong>《汤姆·索亚历险记》</strong>：少年正义感与机智冒险天性</li>
            <li><strong>《小王子》《鲁滨逊漂流记》</strong>：荒岛生存、责任与守护</li>
            <li><strong>《法布尔昆虫记》</strong>：自然科学与生命敬畏</li>
          </ul>
        </div>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
          <h3 style="color: #059669; font-size: 1.15rem; margin-top: 0;">🎬 经典电影</h3>
          <ul style="padding-left: 1.2rem; color: #334155; line-height: 1.8; font-size: 0.95rem;">
            <li><strong>★《怦然心动》（美·2010）</strong>：三观与人格奠基，“斯人若彩虹”</li>
            <li><strong>《千与千寻》</strong>：不忘初心，贪婪会变成猪</li>
            <li><strong>《奇迹男孩》</strong>：反校园霸凌，“在正确和善良之间选善良”</li>
            <li><strong>《忠犬八公的故事》《哈利·波特与魔法石》</strong></li>
          </ul>
        </div>

        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 1.25rem; grid-column: 1 / -1;">
          <h3 style="color: #15803d; font-size: 1.15rem; margin-top: 0;">🎵 音乐天地（山野清风与梦幻童话）</h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; font-size: 0.92rem;">
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #86efac;">★《樱花草》（唯美浪漫童话）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #86efac;">★《红山果》（生机勃勃山野律动）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #86efac;">《乡间的小路》《外婆的澎湖湾》</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #86efac;">《虫儿飞》（空灵合唱） / 《蜗牛》（周杰伦）</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 第三篇：小学高段 -->
    <section id="stage-3" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2rem; margin-bottom: 2.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;">
        <span style="font-size: 2rem;">🔬</span>
        <div>
          <h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin: 0;">第三篇：小学高段（5~6年级）· 逻辑推理、崇高榜样与心力沉淀</h2>
          <p style="color: #64748b; font-size: 0.95rem; margin: 0.25rem 0 0;">驾驭大部头阅读，树立纯粹人格偶像，沉淀自律与拼搏的精神厚度</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
          <h3 style="color: #2563eb; font-size: 1.15rem; margin-top: 0;">📚 精神书架</h3>
          <ul style="padding-left: 1.2rem; color: #334155; line-height: 1.8; font-size: 0.95rem;">
            <li><strong>★《福尔摩斯探案集》</strong>：逻辑推演天花板，长篇吸铁石</li>
            <li><strong>★《居里夫人传》</strong>：棚屋提炼镭、淡泊名利的纯粹榜样</li>
            <li><strong>《三国演义》《西游记》</strong>：四大名著先导，文言语感</li>
            <li><strong>《世说新语》《城南旧事》</strong>：名士风度与纯美中文</li>
          </ul>
        </div>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem;">
          <h3 style="color: #059669; font-size: 1.15rem; margin-top: 0;">🎬 经典电影</h3>
          <ul style="padding-left: 1.2rem; color: #334155; line-height: 1.8; font-size: 0.95rem;">
            <li><strong>《放牛班的春天》</strong>：音乐与爱对少年的救赎</li>
            <li><strong>《摔跤吧！爸爸》</strong>：自律与汗水，打破性别偏见</li>
            <li><strong>《星际穿越》</strong>：硬核物理学与穿越时空的父爱</li>
            <li><strong>《当幸福来敲门》《天堂电影院》</strong></li>
          </ul>
        </div>

        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 1.25rem; grid-column: 1 / -1;">
          <h3 style="color: #1d4ed8; font-size: 1.15rem; margin-top: 0;">🎵 音乐天地（大爱希望与少年热血）</h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; font-size: 0.92rem;">
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #93c5fd;">★《明天会更好》（群星公益大爱）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #93c5fd;">《隐形的翅膀》《奔跑》</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #93c5fd;">《风吹麦浪》《贝加尔湖畔》（李健）</div>
            <div style="background: #fff; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #93c5fd;">肖邦夜曲 / 汉斯·季默《星际穿越》原声</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 第四篇：初中阶段 -->
    <section id="stage-4" style="background: #fffaf0; border: 2px solid #fed7aa; border-radius: 16px; padding: 2rem; margin-bottom: 2.5rem; box-shadow: 0 4px 12px rgba(234,88,12,0.08);">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;">
        <span style="font-size: 2rem;">⚔️</span>
        <div>
          <h2 style="font-size: 1.6rem; font-weight: 800; color: #9a3412; margin: 0;">第四篇：初中阶段（7~9年级）· 现实认知、钢铁意志与家国血性【黄金期】</h2>
          <p style="color: #c2410c; font-size: 0.95rem; margin: 0.25rem 0 0;">三观定型分水岭！直面现实复杂，注入顶天立地的骨气、克制尊严与自强韧性</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <div style="background: #ffffff; border: 1px solid #fdba74; border-radius: 12px; padding: 1.25rem;">
          <h3 style="color: #c2410c; font-size: 1.15rem; margin-top: 0;">📚 精神书架</h3>
          <ul style="padding-left: 1.2rem; color: #334155; line-height: 1.8; font-size: 0.95rem;">
            <li><strong>★《平凡的世界》（路遥）</strong>：孙少平奋斗自尊，普通人最好成人礼</li>
            <li><strong>★《活着》（余华）</strong>：敬畏生命韧性，人是为活着本身而活</li>
            <li><strong>★《亮剑》（都梁）</strong>：军人血性与逢敌必亮剑的气魄</li>
            <li><strong>★《钢铁是怎样炼成的》</strong>：保尔钢铁意志，初二必考</li>
            <li><strong>★《基督山伯爵》</strong>：叙事天花板，正义与等待希望</li>
            <li><strong>《朝花夕拾》《明朝那些事儿》《三体》《简·爱》《老人与海》</strong></li>
            <li style="color: #b45309;"><em>课外长卷（限假期）：《剑来》《雪中悍刀行》《泡沫之夏》</em></li>
          </ul>
        </div>

        <div style="background: #ffffff; border: 1px solid #fdba74; border-radius: 12px; padding: 1.25rem;">
          <h3 style="color: #ea580c; font-size: 1.15rem; margin-top: 0;">🎬 殿堂电影</h3>
          <ul style="padding-left: 1.2rem; color: #334155; line-height: 1.8; font-size: 0.95rem;">
            <li><strong>★《触不可及》（法）</strong>：平视与尊重，幽默救赎生活苦难</li>
            <li><strong>★《绿皮书》（美）</strong>：“尊严始于克制”，反偏见教科书</li>
            <li><strong>★《肖申克的救赎》（美）</strong>：影史第一，希望永不磨灭</li>
            <li><strong>★《闻香识女人》</strong>：宁死不出卖朋友，领袖风骨</li>
            <li><strong>★《横空出世》</strong>：原子弹马兰基地，中国脊梁战魂</li>
            <li><strong>《高山下的花环》《海上钢琴师》《死亡诗社》《活着》</strong></li>
          </ul>
        </div>

