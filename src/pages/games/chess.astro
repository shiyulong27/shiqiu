---
import Base from '../../layouts/Base.astro'
import { chessGamesData } from '../../data/chessGamesData.js'

const base = import.meta.env.BASE_URL
const { meta, games, quiz } = chessGamesData
---

<Base title="智慧博弈 · 华夏与世界经典棋类通识 · 十丘万象" wide={true}>
  <div class="chess-container">
    <!-- 顶部全景导航与导言 -->
    <header class="chess-header">
      <div class="chess-nav-bar">
        <a href={base} class="chess-back-btn">← 返回【十丘】知识总门户</a>
        <div class="chess-nav-links">
          <a href={`${base}math/rubik/`} class="chess-sub-nav">🎲 空间魔方乐园</a>
          <a href={`${base}math/games/`} class="chess-sub-nav">🧮 数学思维乐园</a>
          <a href={`${base}astronomy/`} class="chess-sub-nav">🌌 浩瀚星空</a>
          <a href={`${base}biology/`} class="chess-sub-nav">🌿 生物与动物</a>
          <a href={`${base}knowledge/commonsense/`} class="chess-sub-nav">🛡️ 生活常识</a>
        </div>
      </div>

      <div class="chess-hero">
        <div class="chess-title-wrap">
          <span class="chess-badge">♟️ 棋盘上的乾坤 · 策略思维与棋道文化</span>
          <h1 class="chess-main-title">{meta.title}</h1>
          <p class="chess-subtitle">{meta.subtitle}</p>
        </div>

        <div class="chess-top-actions">
          <button id="btn-open-chess-quiz" class="chess-btn chess-btn-indigo">
            <span class="btn-icon">🏆</span> 棋类通识小院士挑战
          </button>
        </div>
      </div>

      <!-- 棋种过滤条 -->
      <div class="chess-controls-deck">
        <div class="chess-game-tabs">
          <button class="chess-game-tab active" data-game="all">
            <span class="tab-icon">🌟</span>
            <span>全部棋种</span>
          </button>
          {games.map((g) => (
            <button class="chess-game-tab" data-game={g.id}>
              <span class="tab-icon">♟️</span>
              <span>{g.name.split(' ')[0]}</span>
            </button>
          ))}
        </div>
      </div>
    </header>

    <!-- 棋类内容主体长卷 -->
    <main class="chess-main-content">
      <div class="chess-section-title">
        <h2>⚔️ 华夏与世界经典棋类全图谱</h2>
        <p class="chess-section-sub">精析棋盘规则、兵法口诀、行棋禁忌与千百年来蕴含的深厚棋道文化</p>
      </div>

      <div class="chess-cards-list">
        {games.map((g) => (
          <article class="chess-game-card" data-id={g.id}>
            <div class="game-card-header">
              <div class="game-title-row">
                <span class="game-badge">{g.badge}</span>
                <h3 class="game-name">{g.name}</h3>
                <span class="game-en">{g.englishName}</span>
              </div>
              <div class="game-origin">
                <span class="origin-icon">📜</span>
                <span>渊源历史：{g.origin}</span>
              </div>
            </div>

            <div class="game-specs-grid">
              <div class="spec-box">
                <span class="spec-label">📐 棋盘规格：</span>
                <span class="spec-val">{g.board}</span>
              </div>
              <div class="spec-box">
                <span class="spec-label">⚪ 棋子配置：</span>
                <span class="spec-val">{g.pieces}</span>
              </div>
            </div>

            <!-- 核心规则 -->
            <div class="game-rules-section">
              <h4>🎯 核心对弈规则：</h4>
              <ul class="rules-list">
                {g.coreRules.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>

            <!-- 经典走法与口诀 -->
            <div class="game-chants-section">
              <h4>🗣️ 传世走法口诀与战术秘籍 <small>（点击朗读口诀）</small>：</h4>
              <div class="chants-grid">
                {g.classicChants.map((c) => (
                  <div class="chess-chant-item">
                    <span class="chant-sound-icon">🔊</span>
                    <div class="chant-text">"{c.chant}"</div>
                    <div class="chant-meaning">{c.meaning}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- 棋道与文化故事 -->
            <div class="game-culture-box">
              <span class="culture-icon">🏮</span>
              <div>
                <b>棋道启迪与哲学智慧：</b>
                <p>{g.cultureStory}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </main>

    <!-- 弹窗：亲子棋类通识问答挑战 -->
    <div id="chess-quiz-modal" class="chess-modal-backdrop">
      <div class="chess-modal-container quiz-modal-container">
        <button id="btn-close-chess-quiz" class="chess-modal-close" aria-label="关闭">&times;</button>
        <div class="quiz-modal-header">
          <span class="quiz-icon">🏆</span>
          <div>
            <h2>♟️ 华夏棋道与博弈智慧 · 亲子挑战赛</h2>
            <p>共 8 道围棋、象棋、五子棋、军棋、国象规则与历史口诀题，测测你的博弈智商！</p>
          </div>
        </div>

        <div id="chess-quiz-score-card" class="quiz-score-card" style="display: none;"></div>

        <div class="quiz-questions-list">
          {quiz.map((q, qIndex) => (
            <div class="chess-quiz-card" data-correct={q.answerIndex} data-expl={q.explanation}>
              <div class="quiz-q-title">
                <span class="quiz-q-num">{qIndex + 1}.</span>
                <span>{q.question}</span>
              </div>
              <div class="quiz-options-grid">
                {q.options.map((opt, oIndex) => (
                  <button class="chess-quiz-opt" data-index={oIndex}>
                    <span class="opt-letter">{['A', 'B', 'C', 'D'][oIndex]}.</span>
                    <span class="opt-text">{opt}</span>
                  </button>
                ))}
              </div>
              <div class="chess-quiz-feedback" style="display: none;"></div>
            </div>
          ))}
        </div>

        <div class="quiz-modal-actions">
          <button id="btn-submit-chess-quiz" class="chess-btn chess-btn-indigo">提交答卷测评成绩</button>
          <button id="btn-reset-chess-quiz" class="chess-btn chess-btn-gray">重新开始挑战</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script src="../../client/chess-ui.js"></script>

<style>
  .chess-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    color: #1e293b;
  }

  .chess-header {
    margin-bottom: 2.5rem;
    background: linear-gradient(135deg, #312e81 0%, #3730a3 50%, #4338ca 100%);
    color: #fff;
    border-radius: 20px;
    padding: 2rem 2.5rem;
    box-shadow: 0 12px 36px rgba(49, 46, 129, 0.25);
  }

  .chess-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding-bottom: 1rem;
  }

  .chess-back-btn {
    color: #c7d2fe;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .chess-back-btn:hover {
    color: #ffffff;
  }

  .chess-nav-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .chess-sub-nav {
    color: #e0e7ff;
    text-decoration: none;
    font-size: 0.85rem;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.35rem 0.8rem;
    border-radius: 20px;
    transition: all 0.2s;
  }
  .chess-sub-nav:hover {
    background: rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .chess-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .chess-badge {
    display: inline-block;
    background: rgba(199, 210, 254, 0.25);
    color: #c7d2fe;
    font-size: 0.85rem;
    padding: 0.25rem 0.8rem;
    border-radius: 12px;
    margin-bottom: 0.6rem;
    font-weight: 600;
  }

  .chess-main-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0.2rem 0;
  }

  .chess-subtitle {
    font-size: 1.05rem;
    color: #e0e7ff;
    max-width: 720px;
    line-height: 1.6;
    margin: 0;
  }

  .chess-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .chess-btn-indigo {
    background: #6366f1;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
  }
  .chess-btn-indigo:hover {
    background: #4f46e5;
    transform: translateY(-2px);
  }
  .chess-btn-gray {
    background: #e2e8f0;
    color: #334155;
  }

  .chess-controls-deck {
    background: rgba(0, 0, 0, 0.2);
    padding: 0.8rem 1.2rem;
    border-radius: 16px;
  }

  .chess-game-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .chess-game-tab {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e0e7ff;
    padding: 0.45rem 0.9rem;
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.2s;
  }
  .chess-game-tab:hover {
    background: rgba(255, 255, 255, 0.25);
    color: #fff;
  }
  .chess-game-tab.active {
    background: #ffffff;
    color: #3730a3;
    font-weight: 700;
    border-color: #ffffff;
  }

  /* 主体标题 */
  .chess-section-title {
    margin-bottom: 1.8rem;
  }
  .chess-section-title h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.3rem 0;
  }
  .chess-section-sub {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0;
  }

  /* 棋类卡片列表 */
  .chess-cards-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .chess-game-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    padding: 2rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .game-card-header {
    margin-bottom: 1.2rem;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 1rem;
  }
  .game-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .game-badge {
    background: #ede9fe;
    color: #5b21b6;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 12px;
  }
  .game-name {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }
  .game-en {
    font-size: 0.9rem;
    color: #64748b;
    font-style: italic;
  }
  .game-origin {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #475569;
  }

  .game-specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    background: #f8fafc;
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 1.4rem;
  }
  .spec-box {
    font-size: 0.88rem;
  }
  .spec-label {
    font-weight: 700;
    color: #334155;
  }
  .spec-val {
    color: #475569;
  }

  .game-rules-section {
    margin-bottom: 1.5rem;
  }
  .game-rules-section h4, .game-chants-section h4 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.8rem 0;
  }
  .rules-list {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    color: #334155;
    line-height: 1.7;
  }

  /* 口诀卡片 */
  .chants-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .chess-chant-item {
    background: #fffbeb;
    border: 1px solid #fef3c7;
    border-radius: 12px;
    padding: 1rem;
    cursor: pointer;
    position: relative;
    transition: all 0.2s;
  }
  .chess-chant-item:hover {
    background: #fef3c7;
    transform: translateY(-2px);
  }
  .chant-sound-icon {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    font-size: 0.9rem;
    color: #d97706;
  }
  .chant-text {
    font-size: 1.05rem;
    font-weight: 800;
    color: #92400e;
    margin-bottom: 0.3rem;
  }
  .chant-meaning {
    font-size: 0.82rem;
    color: #78350f;
    line-height: 1.5;
  }

  .game-culture-box {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 1rem 1.2rem;
    display: flex;
    gap: 0.8rem;
    font-size: 0.88rem;
    color: #166534;
    line-height: 1.6;
  }
  .culture-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .game-culture-box b {
    display: block;
    margin-bottom: 0.2rem;
  }
  .game-culture-box p {
    margin: 0;
  }

  /* 弹窗通用样式 */
  .chess-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1.5rem;
  }
  .chess-modal-backdrop.active {
    display: flex;
  }
  .chess-modal-container {
    background: #ffffff;
    border-radius: 20px;
    max-width: 800px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 2rem;
    position: relative;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.2);
  }
  .chess-modal-close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    background: #f1f5f9;
    border: none;
    font-size: 1.5rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
  }

  .quiz-modal-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 1.2rem;
  }
  .quiz-icon {
    font-size: 2.8rem;
  }
  .quiz-modal-header h2 {
    font-size: 1.4rem;
    margin: 0 0 0.3rem 0;
    color: #0f172a;
  }
  .quiz-modal-header p {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
  }

  .quiz-score-card {
    background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
    border: 1px solid #c4b5fd;
    border-radius: 14px;
    padding: 1.2rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .score-badge {
    font-size: 1.3rem;
    font-weight: 800;
    color: #5b21b6;
    margin-bottom: 0.4rem;
  }
  .score-honor {
    font-size: 0.95rem;
    color: #4c1d95;
    font-weight: 600;
    margin: 0;
  }

  .quiz-questions-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-bottom: 2rem;
  }
  .chess-quiz-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.2rem;
  }
  .chess-quiz-card.correct {
    border-color: #10b981;
    background: #f0fdf4;
  }
  .chess-quiz-card.wrong {
    border-color: #ef4444;
    background: #fef2f2;
  }

  .quiz-q-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.8rem;
  }
  .quiz-options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .chess-quiz-opt {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    text-align: left;
    font-size: 0.85rem;
    color: #334155;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.2s;
  }
  .chess-quiz-opt:hover {
    border-color: #6366f1;
    background: #eef2ff;
  }
  .chess-quiz-opt.selected {
    border-color: #6366f1;
    background: #e0e7ff;
    color: #3730a3;
    font-weight: 700;
  }
  .chess-quiz-feedback {
    margin-top: 0.8rem;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    font-size: 0.82rem;
    line-height: 1.4;
    background: #ffffff;
    border: 1px solid #e2e8f0;
  }
  .quiz-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    border-top: 1px solid #f1f5f9;
    padding-top: 1.2rem;
  }

  @media (max-width: 768px) {
    .chess-container {
      padding: 1rem;
    }
    .chess-header {
      padding: 1.5rem;
    }
    .chess-main-title {
      font-size: 1.6rem;
    }
    .game-specs-grid {
      grid-template-columns: 1fr;
    }
    .quiz-options-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
