</style>

<script is:inline define:vars={{ poemsData }}>
  // 全局响应式状态
  let currentPoemId = poemsData[0].id
  let currentViewMode = 'pinyin' // 'pinyin' | 'rhythm' | 'text'
  let currentReciteMode = 'study' // 'study' | 'blank' | 'mask'
  let isPlaying = false
  let isLoop = false
  let speechRate = 0.85 // 适速 0.85x 适合儿童跟读
  let currentReadingLineIdx = -1

  // 本地背诵打卡记录缓存
  function getCheckedInPoems() {
    try {
      return JSON.parse(localStorage.getItem('shiqiu_poem_checkin') || '{}')
    } catch {
      return {}
    }
  }

  function setCheckedInPoem(id) {
    try {
      const data = getCheckedInPoems()
      data[id] = Date.now()
      localStorage.setItem('shiqiu_poem_checkin', JSON.stringify(data))
    } catch {}
  }

  // ── 语音播放引擎 ──
  window.speakText = function(text, rate = speechRate, onEndCallback = null) {
    if (!('speechSynthesis' in window)) {
      alert('您的浏览器暂不支持语音合成，推荐使用 Chrome / Safari / Edge 体验互动朗读！')
      return
    }
    window.speechSynthesis.cancel()
    const utterance = new SpeechSynthesisUtterance(text)
    utterance.lang = 'zh-CN'
    utterance.rate = rate
    utterance.pitch = 1.05
    if (onEndCallback) {
      utterance.onend = onEndCallback
      utterance.onerror = onEndCallback
    }
    window.speechSynthesis.speak(utterance)
  }

  window.stopSpeaking = function() {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel()
    }
    isPlaying = false
    currentReadingLineIdx = -1
    updatePlayButtonUI()
    highlightReadingLine(-1)
  }

  // ── 全诗朗读与呼吸停顿 ──
  window.togglePlayPoem = function() {
    if (isPlaying) {
      window.stopSpeaking()
    } else {
      const poem = poemsData.find(p => p.id === currentPoemId)
      if (!poem) return
      isPlaying = true
      updatePlayButtonUI()

      // 逐句朗读带呼吸停顿与高亮
      let lineIdx = 0
      function playNextLine() {
        if (!isPlaying) return
        if (lineIdx >= poem.lines.length) {
          // 朗读完毕
          if (isLoop) {
            lineIdx = 0
            setTimeout(playNextLine, 1200) // 循环等待 1.2 秒
          } else {
            window.stopSpeaking()
          }
          return
        }

        currentReadingLineIdx = lineIdx
        highlightReadingLine(lineIdx)
        const line = poem.lines[lineIdx]
        lineIdx++

        // 读完当前句后稍作停顿读下一句
        window.speakText(line.text, speechRate, () => {
          if (isPlaying) {
            setTimeout(playNextLine, 400) // 句间呼吸停顿 400ms
          }
        })
      }

      // 先报诗名作者
      const intro = `${poem.title}，${poem.dynasty}，${poem.author}`
      window.speakText(intro, speechRate, () => {
        setTimeout(playNextLine, 500)
      })
    }
  }

  function updatePlayButtonUI() {
    const playIcon = document.getElementById('play-icon')
    const playText = document.getElementById('play-text')
    const btn = document.getElementById('btn-play-all')
    if (isPlaying) {
      playIcon.innerText = '⏸️'
      playText.innerText = '暂停朗读'
      btn.style.background = '#dc2626'
    } else {
      playIcon.innerText = '▶️'
      playText.innerText = '朗读全诗'
      btn.style.background = 'linear-gradient(135deg, #ea580c 0%, #c2410c 100%)'
    }
  }

  function highlightReadingLine(idx) {
    const rows = document.querySelectorAll('.poem-line-row')
    rows.forEach((r, i) => {
      if (i === idx) {
        r.classList.add('reading-active')
      } else {
        r.classList.remove('reading-active')
      }
    })
  }

  window.toggleLoopPlay = function(checked) {
    isLoop = checked
  }

  window.toggleSpeechRate = function(checked) {
    speechRate = checked ? 0.85 : 1.0
  }

  // ── 切换当前展示诗篇 ──
  window.switchPoem = function(id) {
    window.stopSpeaking()
    currentPoemId = id

    // 更新左侧列表激活态
    document.querySelectorAll('.poem-list-card').forEach(card => {
      if (card.getAttribute('data-id') === id) {
        card.classList.add('active')
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      } else {
        card.classList.remove('active')
      }
    })

    renderCurrentPoem()
  }

  // ── 视图模式与挑战模式切换 ──
  window.setViewMode = function(mode) {
    currentViewMode = mode
    document.querySelectorAll('.view-mode-btn').forEach(btn => btn.classList.remove('active'))
    document.getElementById(`btn-view-${mode}`).classList.add('active')

    const sheet = document.getElementById('poem-display-sheet')
    sheet.classList.remove('view-pinyin-mode', 'view-rhythm-mode', 'view-text-mode')
    sheet.classList.add(`view-${mode}-mode`)

    renderPoemLines()
  }

  window.setReciteMode = function(mode) {
    currentReciteMode = mode
    document.querySelectorAll('.challenge-pill').forEach(btn => btn.classList.remove('active'))
    document.getElementById(`btn-mode-${mode}`).classList.add('active')
    renderPoemLines()
  }

  // ── 核心渲染函数 ──
  function renderCurrentPoem() {
    const poem = poemsData.find(p => p.id === currentPoemId) || poemsData[0]

    // 头部元数据
    document.getElementById('poem-grade-tag').innerText = poem.gradeFull
    document.getElementById('poem-theme-tag').innerText = poem.theme
    document.getElementById('poem-title-heading').innerHTML = `<ruby>${poem.title} <rt>${poem.titlePinyin}</rt></ruby>`
    document.getElementById('poem-author-heading').innerText = `〔${poem.dynasty}〕· ${poem.author}`

    // 底部伴读手册
    document.getElementById('poem-translation-text').innerText = poem.translation
    document.getElementById('poem-appreciation-text').innerText = poem.appreciation

    // 重点生字词字典
    const kwGrid = document.getElementById('poem-keywords-grid')
    kwGrid.innerHTML = poem.keywords.map(kw => `
      <div class="keyword-item">
        <span class="keyword-word">${kw.word}：</span>
        <span class="keyword-explain">${kw.explain}</span>
      </div>
    `).join('')

    // 背诵打卡状态
    updateCheckinUI()

    // 渲染诗句
    renderPoemLines()
  }

  function renderPoemLines() {
    const poem = poemsData.find(p => p.id === currentPoemId) || poemsData[0]
    const container = document.getElementById('poem-lines-body')
    container.innerHTML = ''

    poem.lines.forEach((line, lineIdx) => {
      const row = document.createElement('div')
      row.className = 'poem-line-row'
      row.onclick = () => window.speakText(line.text)

      if (currentReciteMode === 'mask') {
        // 遮挡背诵模式
        const maskBar = document.createElement('div')
        maskBar.className = 'poem-mask-bar'
        maskBar.innerText = `🙈 第 ${lineIdx + 1} 句（点击揭开背诵）`
        maskBar.onclick = (e) => {
          e.stopPropagation()
          maskBar.innerText = line.text
          maskBar.style.background = '#dcfce7'
          maskBar.style.color = '#15803d'
          window.speakText(line.text)
        }
        row.appendChild(maskBar)
      } else if (currentReciteMode === 'blank') {
        // 诗眼挖空模式（挖空末尾押韵字或关键词）
        line.tokens.forEach((tk, tkIdx) => {
          const isPunctuation = /[，。？！、]/.test(tk.char)
          const isTargetBlank = (!isPunctuation) && (tkIdx === line.tokens.length - 2 || tkIdx === 1)

          if (isTargetBlank) {
            const blank = document.createElement('span')
            blank.className = 'poem-blank-box'
            blank.innerText = '❓'
            blank.onclick = (e) => {
              e.stopPropagation()
              blank.className = 'poem-blank-box revealed'
              blank.innerText = tk.char
              window.speakText(tk.char)
            }
            row.appendChild(blank)
          } else {
            row.appendChild(createCharTokenElement(tk))
          }
        })
      } else {
        // 点读研习模式：拼音 / 节拍 / 纯字
        if (currentViewMode === 'rhythm') {
          // 节拍模式展示
          const parts = line.rhythm.split('／')
          parts.forEach((pt, pIdx) => {
            const span = document.createElement('span')
            span.style.fontSize = '2.2rem'
            span.style.fontFamily = "'Kaiti', 'STKaiti', serif"
            span.style.fontWeight = 'bold'
            span.innerText = pt
            row.appendChild(span)

            if (pIdx < parts.length - 1) {
              const pause = document.createElement('span')
              pause.className = 'poem-rhythm-pause'
              pause.innerText = '／'
              row.appendChild(pause)
            }
          })
        } else {
          // 拼音对照模式与纯字水墨模式
          line.tokens.forEach(tk => {
            row.appendChild(createCharTokenElement(tk))
          })
        }
      }

      container.appendChild(row)
    })
  }

  function createCharTokenElement(tk) {
    const isPunctuation = /[，。？！、]/.test(tk.char)
    const box = document.createElement('div')
    box.className = 'poem-char-box'

    if (!isPunctuation) {
      box.onclick = (e) => {
        e.stopPropagation()
        window.openCharModal(tk.char, tk.pinyin)
      }
    }

    const py = document.createElement('span')
    py.className = 'poem-char-pinyin'
    py.innerText = tk.pinyin

    const hz = document.createElement('span')
    hz.className = 'poem-char-hanzi'
    hz.innerText = tk.char

    box.appendChild(py)
    box.appendChild(hz)
    return box
  }

  // ── 单字田字格弹窗 ──
  window.openCharModal = function(char, pinyin) {
    document.getElementById('modal-char').innerText = char
    document.getElementById('modal-pinyin').innerText = pinyin
    document.getElementById('modal-explain').innerText = `汉字“${char}”，拼音 ${pinyin}。点击下方按钮可反复朗读。`
    document.getElementById('char-modal').style.display = 'flex'
    window.speakText(`${char}，拼音 ${pinyin}`)
  }

  window.closeCharModal = function() {
    document.getElementById('char-modal').style.display = 'none'
  }

  window.speakModalChar = function() {
    const char = document.getElementById('modal-char').innerText
    const pinyin = document.getElementById('modal-pinyin').innerText
    window.speakText(`${char}，拼音 ${pinyin}`)
  }

  // ── 背诵打卡 ──
  window.checkInPoem = function() {
    setCheckedInPoem(currentPoemId)
    updateCheckinUI()
    window.speakText('恭喜你，背诵成功，获得一颗闪耀国学小星星！')
  }

  function updateCheckinUI() {
    const data = getCheckedInPoems()
    const status = document.getElementById('checkin-status-text')
    const btn = document.getElementById('btn-checkin')
    if (data[currentPoemId]) {
      const date = new Date(data[currentPoemId]).toLocaleDateString()
      status.innerText = `🎉 恭喜！乐乐/月亮已于 ${date} 成功背诵通关！`
      status.style.color = '#059669'
      btn.innerText = '✅ 已背诵通过 (点击可再次打卡)'
      btn.style.background = '#059669'
    } else {
      status.innerText = '✨ 乐乐与月亮，这首诗你背熟了吗？'
      status.style.color = '#9d174d'
      btn.innerText = '⭐ 点击打卡：我已熟练背诵！'
      btn.style.background = 'linear-gradient(135deg, #db2777 0%, #be185d 100%)'
    }
  }

  // ── 全屏晨读模式 ──
  document.getElementById('btn-fullscreen-reader').onclick = function() {
    const poem = poemsData.find(p => p.id === currentPoemId) || poemsData[0]
    document.getElementById('fs-poem-title').innerText = poem.title
    document.getElementById('fs-poem-author').innerText = `〔${poem.dynasty}〕${poem.author}`

    const wrap = document.getElementById('fs-lines-container')
    wrap.innerHTML = poem.lines.map(l => `
      <div class="fs-line-row">${l.text}</div>
    `).join('')

    document.getElementById('fullscreen-reader').style.display = 'flex'
  }

  window.exitFullscreenReader = function() {
    document.getElementById('fullscreen-reader').style.display = 'none'
  }

  // ── 筛选与检索逻辑 ──
  function filterPoems() {
    const activeGradeTab = document.querySelector('.grade-tab-pill.active')?.getAttribute('data-grade') || 'all'
    const activeTheme = document.getElementById('theme-select').value
    const searchText = document.getElementById('poem-search-input').value.trim().toLowerCase()

    let visibleCount = 0
    let firstVisibleId = null

    document.querySelectorAll('.poem-list-card').forEach(card => {
      const cardGrade = card.getAttribute('data-grade')
      const cardTheme = card.getAttribute('data-theme')
      const cardSearch = card.getAttribute('data-search').toLowerCase()
      const id = card.getAttribute('data-id')

      const matchGrade = activeGradeTab === 'all' || cardGrade === activeGradeTab
      const matchTheme = activeTheme === '全部主题' || cardTheme === activeTheme
      const matchSearch = !searchText || cardSearch.includes(searchText)

      if (matchGrade && matchTheme && matchSearch) {
        card.style.display = 'block'
        visibleCount++
        if (!firstVisibleId) firstVisibleId = id
      } else {
        card.style.display = 'none'
      }
    })

    document.getElementById('poem-count-display').innerText = `共 ${visibleCount} 首`

    // 如果当前选中的诗被过滤隐藏了，自动跳到第一个可见的诗
    const currentCard = document.querySelector(`.poem-list-card[data-id="${currentPoemId}"]`)
    if (currentCard && currentCard.style.display === 'none' && firstVisibleId) {
      window.switchPoem(firstVisibleId)
    }
  }

  // 事件监听绑定
  document.addEventListener('DOMContentLoaded', () => {
    // 学段胶囊切换
    document.querySelectorAll('.grade-tab-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.grade-tab-pill').forEach(b => b.classList.remove('active'))
        btn.classList.add('active')
        filterPoems()
      })
    })

    // 主题下拉
    document.getElementById('theme-select').addEventListener('change', filterPoems)

    // 搜索框
    const searchInput = document.getElementById('poem-search-input')
    const clearBtn = document.getElementById('btn-search-clear')

    searchInput.addEventListener('input', () => {
      clearBtn.style.display = searchInput.value ? 'inline-block' : 'none'
      filterPoems()
    })

    clearBtn.addEventListener('click', () => {
      searchInput.value = ''
      clearBtn.style.display = 'none'
      filterPoems()
    })

    // 初始化渲染首篇
    renderCurrentPoem()
  })
</script>
