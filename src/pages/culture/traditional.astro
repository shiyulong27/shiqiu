---
import Base from '../../layouts/Base.astro';
import CultureExplainer from '../../components/CultureExplainer.astro';
import { traditionalChapters as chapters, publishedTraditionalEntries as entries, traditionalVisuals as visuals, traditionalSources as sources, traditionalQuiz as quiz } from '../../data/traditionalCultureData.js';
import { searchText } from '../../utils/traditionalCulture.js';
const base = import.meta.env.BASE_URL;
const sourceMap = new Map(sources.map(s => [s.id, s]));
---

<Base title="生活里的文化 · 从零开始的传统文化与民俗常识" wide={true}>
  <main class="culture-book">
    <nav class="book-top" aria-label="专题导航">
      <a href={base}>← 十丘知识门户</a>
      <div><a href={`${base}knowledge/commonsense/`}>生活常识</a><a href={`${base}chinese/solar-terms/`}>二十四节气</a><a href={`${base}culture/tea/`}>茶文化</a></div>
    </nav>
    <header class="book-hero">
      <div class="hero-copy">
        <p class="eyebrow">生活观察手册 · 从零开始</p>
        <h1>原来，<br/>文化就在<span>生活里。</span></h1>
        <p class="hero-intro">六亲是哪六亲？地图转过来，北方还在上面吗？<br class="desktop-break"/>从一个小问题开始，用图、故事和观察，把熟悉的生活读懂。</p>
        <div class="hero-actions"><a class="primary-link" href="#chapters">翻开八篇 →</a><button id="open-culture-quiz" type="button">试试八道情境题</button></div>
        <p class="book-meta">八个主题 · {entries.length} 个入门问题 · 图解与来源随文可查</p>
      </div>
      <figure class="hero-figure">
        <span class="figure-index">观察 01 / 方向</span>
        <picture><source media="(max-width: 700px)" srcset={`${base}images/traditional/sample-direction-mobile.svg`}/><img src={`${base}images/traditional/sample-direction.svg`} alt="整张地图转半圈，北箭头跟着转；学校仍在公园北面" width="640" height="420" fetchpriority="high"/></picture>
        <figcaption>纸可以转，方向关系不会因此改变。<a href="#TC02-01">去看这个问题 ↗</a></figcaption>
      </figure>
    </header>

    <section class="reading-guide" aria-label="从哪里开始">
      <p><b>不用先背名词。</b>先读一句短答，看图或对照；好奇时再展开解释。</p>
      <p><b>也可以带着疑问读。</b>这里会标明哪些是习俗、传统观念，哪些需要科学证据。</p>
    </section>

    <div class="book-layout" id="chapters">
      <aside class="book-contents">
        <p class="eyebrow">这本手册的八篇</p>
        <nav aria-label="篇章目录">{chapters.map((c, i) => <a href={`#chapter-${c.id}`} data-chapter-jump={c.id}><span>{String(i + 1).padStart(2, '0')}</span>{c.title}</a>)}</nav>
        <a class="side-link" href={`${base}knowledge/commonsense/`}>再看安全、健康与日常生活 ↗</a>
      </aside>
      <div class="book-body">
        <form class="book-filters" role="search" onsubmit="return false">
          <label class="query-label" for="culture-query">今天想弄懂什么？</label>
          <input id="culture-query" type="search" placeholder="试试：六亲、地图、堂亲、五行……" autocomplete="off"/>
          <div class="filter-row">
            <label>主题<select id="culture-chapter"><option value="all">全部八篇</option>{chapters.map(c => <option value={c.id}>{c.title}</option>)}</select></label>
            <label>场景<select id="culture-scenario"><option value="all">所有场景</option>{chapters.map(c => <option value={c.scenario}>{c.scenario}</option>)}</select></label>
            <button id="clear-culture-filters" type="button">清除筛选</button>
          </div>
          <p id="culture-result-count" role="status" aria-live="polite">显示 {entries.length} 个问题</p>
        </form>
        <p id="culture-empty" hidden>这次没有找到。试试更短的词，或清除主题、场景筛选。</p>
        {chapters.map((chapter, index) => {
          const visual = visuals.find(v => v.chapterId === chapter.id);
          const chapterEntries = entries.filter(e => e.chapterId === chapter.id);
          return <section class="book-chapter" id={`chapter-${chapter.id}`} data-chapter-section={chapter.id}>
            <header class="chapter-heading"><span class="chapter-number">{String(index + 1).padStart(2, '0')}</span><div><p class="eyebrow">{chapter.scenario} · {chapterEntries.length} 个问题</p><h2>{chapter.title}</h2><p>{chapter.intro}</p></div></header>
            {visual && <figure class="chapter-visual"><picture><source media="(max-width: 700px)" srcset={`${base}${visual.mobilePath}`}/><img src={`${base}${visual.path}`} alt={visual.alt} width="640" height="420" loading="lazy" decoding="async"/></picture><figcaption>{visual.title} · {visual.caption}</figcaption></figure>}
            <div class="entry-list">{chapterEntries.map(entry => <article class="knowledge-entry" id={entry.id} data-entry data-chapter={entry.chapterId} data-scenarios={JSON.stringify(entry.scenarioTags)} data-search={searchText(entry)}>
              <div class="entry-label"><span>{entry.id.replace('TC', '')}</span><span>{entry.claimKind}</span><a href={`#${entry.id}`} aria-label={`定位：${entry.title}`}>#</a></div>
              <h3>{entry.title}</h3><p class="short-answer">{entry.shortAnswer}</p>
              <details><summary>展开：解释、对照与出处 <span aria-hidden="true">＋</span></summary>
                <div class="entry-explanation">{entry.explanation.map(p => <p>{p}</p>)}</div>
                {entry.compare?.length > 0 && <dl class="comparison">{entry.compare.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
                <CultureExplainer entryId={entry.id} />
                <p class="try-it"><b>想一想 / 试一试</b>{entry.example.replace(/^教学情境：/, '')}</p>
                {entry.challenge && <details class="little-challenge"><summary>{entry.challenge.question}</summary><p>{entry.challenge.answer}</p></details>}
                <p class="scope-note"><b>多想一步</b>{entry.scopeNote}</p>
                <ul class="entry-sources" aria-label="来源">{entry.sourceIds.map(id => {const s = sourceMap.get(id); return s && <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.publisher} · {s.title} ↗</a><small>{s.supports}</small></li>;})}</ul>
              </details>
            </article>)}</div>
          </section>;
        })}
        <footer class="book-end"><p class="eyebrow">继续保持好奇</p><h2>读懂一个问题，<br/>就多一双观察生活的眼睛。</h2><p>教学情境与关系图由本项目编写、绘制。查阅日期：2026-10-14。地方习俗与具体版本可能不同，欢迎沿出处继续读。</p><div><a href={`${base}knowledge/commonsense/`}>生活常识 ↗</a><a href={`${base}astronomy/`}>星空与月亮 ↗</a><a href={`${base}games/chess/`}>棋类世界 ↗</a></div></footer>
      </div>
    </div>
    <dialog id="culture-quiz-dialog" aria-labelledby="culture-quiz-title">
      <div class="quiz-heading"><div><p class="eyebrow">每篇一个问题</p><h2 id="culture-quiz-title">把刚刚的发现，用起来</h2></div><button id="close-culture-quiz" type="button" aria-label="关闭答题">×</button></div>
      <p>不计时，可以回看正文。答完再一起看解析。</p>
      <form id="culture-quiz-form">
        {quiz.map((q, i) => <fieldset id={q.id}><legend>{i + 1}. {q.question}</legend>{q.options.map((option, optionIndex) => <label><input type="radio" name={q.id} value={optionIndex}/><span>{option}</span></label>)}<p class="quiz-explanation" data-answer-for={q.id} hidden>{q.explanation} <a href={`#${q.entryId}`} data-review-entry>回看正文 ↗</a></p></fieldset>)}
        <p id="culture-quiz-result" role="status" aria-live="polite"></p>
        <div class="quiz-actions"><button class="primary-link" type="submit">看看我的发现</button><button id="retry-culture-quiz" type="button">重新试一遍</button></div>
      </form>
    </dialog>
  </main>
</Base>

<script>
  import { traditionalQuiz as quiz } from '../../data/traditionalCultureQuiz.js';
  import { gradeCultureQuiz } from '../../utils/traditionalCulture.js';
  const query = document.querySelector<HTMLInputElement>('#culture-query')!;
  const chapter = document.querySelector<HTMLSelectElement>('#culture-chapter')!;
  const scenario = document.querySelector<HTMLSelectElement>('#culture-scenario')!;
  const articles = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
  function filter() {
    const terms = query.value.trim().toLocaleLowerCase().split(/\s+/);
    let count = 0;
    articles.forEach(article => {
      const scenarios = JSON.parse(article.dataset.scenarios || '[]');
      const match = (chapter.value === 'all' || article.dataset.chapter === chapter.value)
        && (scenario.value === 'all' || scenarios.includes(scenario.value))
        && terms.every(term => article.dataset.search!.includes(term));
      article.hidden = !match; if (match) count++;
    });
    document.querySelectorAll<HTMLElement>('[data-chapter-section]').forEach(section => { section.hidden = !section.querySelector('[data-entry]:not([hidden])'); });
    document.querySelector('#culture-result-count')!.textContent = `显示 ${count} 个问题`;
    (document.querySelector('#culture-empty') as HTMLElement).hidden = count !== 0;
  }
  function clear() { query.value = ''; chapter.value = 'all'; scenario.value = 'all'; filter(); }
  query.addEventListener('input', filter); chapter.addEventListener('change', filter); scenario.addEventListener('change', filter);
  document.querySelector('#clear-culture-filters')!.addEventListener('click', () => { clear(); query.focus(); });
  document.querySelectorAll('[data-chapter-jump]').forEach(link => link.addEventListener('click', clear));
  // 带稳定锚点的链接与浏览器前后退仍可找到被筛选隐藏的条目。
  function revealHash() { const id = decodeURIComponent(location.hash.slice(1)); const article = document.getElementById(id); if (article?.matches('[data-entry]')) { clear(); requestAnimationFrame(() => article.scrollIntoView()); } }
  window.addEventListener('hashchange', revealHash); revealHash();
  const dialog = document.querySelector<HTMLDialogElement>('#culture-quiz-dialog')!;
  const opener = document.querySelector<HTMLButtonElement>('#open-culture-quiz')!;
  const form = document.querySelector<HTMLFormElement>('#culture-quiz-form')!;
  const result = document.querySelector<HTMLElement>('#culture-quiz-result')!;
  opener.addEventListener('click', () => dialog.showModal());
  document.querySelector('#close-culture-quiz')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => opener.focus());
  form.addEventListener('submit', event => {
    event.preventDefault(); const data = new FormData(form);
    const answers = Object.fromEntries(quiz.map(q => [q.id, data.has(q.id) ? Number(data.get(q.id)) : null]));
    const grade = gradeCultureQuiz(quiz, answers);
    if (!grade.complete) { result.textContent = `还有 ${grade.missing.length} 题没有选择，可以慢慢想。`; document.querySelector<HTMLInputElement>(`#${grade.missing[0]} input`)?.focus(); return; }
    result.textContent = `答对 ${grade.score} / ${quiz.length} 题。看看解析，找到新的发现。`;
    document.querySelectorAll<HTMLElement>('[data-answer-for]').forEach(p => { p.hidden = false; });
  });
  document.querySelector('#retry-culture-quiz')!.addEventListener('click', () => { form.reset(); result.textContent = ''; document.querySelectorAll<HTMLElement>('[data-answer-for]').forEach(p => { p.hidden = true; }); form.querySelector('input')?.focus(); });
  document.querySelectorAll('[data-review-entry]').forEach(link => link.addEventListener('click', () => { clear(); dialog.close(); }));
</script>

<style>
  .culture-book{--ink:#263b32;--muted:#657167;--green:#285c43;--line:#dedfd3;--paper:#faf8f2;--accent:#aa653e;max-width:1220px;margin:auto;padding:0 30px 70px;color:var(--ink);font-family:'Noto Sans SC','Microsoft YaHei',sans-serif;font-size:17px;line-height:1.85}
  .book-top{display:flex;justify-content:space-between;gap:20px;padding:24px 0;border-bottom:1px solid var(--line);font-size:14px}.book-top div{display:flex;gap:22px}a{color:var(--green);text-decoration:none}a:hover{text-decoration:underline;text-underline-offset:5px}button,input,select{font:inherit}button,a,input,select,summary{touch-action:manipulation}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #ad6b32;outline-offset:4px}
  .book-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:42px;align-items:center;padding:68px 0 42px}.eyebrow{color:var(--muted);font-size:13px;letter-spacing:.12em;margin:0 0 14px}.book-hero h1,.book-end h2{font-family:'Noto Serif SC','SimSun',serif;font-weight:500;letter-spacing:.015em;font-size:clamp(38px,4.5vw,62px);line-height:1.38;margin:0 0 22px}.book-hero h1 span{color:var(--green)}.hero-intro{font-size:17px;line-height:1.95;color:#526257;margin:0}.hero-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin:28px 0 16px}.primary-link{display:inline-block;border:1px solid var(--green);border-radius:3px;background:var(--green);color:#fff;padding:10px 20px;font-size:15px;text-decoration:none}.hero-actions button{border:0;background:none;color:var(--green);padding:10px 0;border-bottom:1px solid #7d9b88;font-size:15px}.book-meta{font-size:12px;color:var(--muted)}figure{margin:0}.hero-figure{border:1px solid var(--line);background:#f1f2e8;padding:16px;border-radius:3px}.figure-index{font-size:12px;letter-spacing:.1em;color:var(--muted)}img{width:100%;height:auto;display:block}figcaption{font-size:12px;color:#5a675d;line-height:1.7}figcaption a{display:block;margin-top:5px}.reading-guide{display:grid;grid-template-columns:1fr 1fr;gap:36px;padding:22px 0 28px;border-block:1px solid var(--line);font-size:14px}.reading-guide p{margin:0}.reading-guide b{display:block;font-weight:600;margin-bottom:3px}
  .book-layout{display:grid;grid-template-columns:215px minmax(0,1fr);gap:54px;padding-top:42px;scroll-margin-top:20px}.book-contents{position:sticky;top:24px;align-self:start}.book-contents nav{display:flex;flex-direction:column;gap:3px}.book-contents nav a{padding:8px 0;font-size:14px}.book-contents nav span{display:inline-block;width:30px;color:#9b7c52;font-size:12px}.side-link{display:block;font-size:12px;margin-top:24px;border-top:1px solid var(--line);padding-top:18px}.book-body{min-width:0}.book-filters{padding-bottom:26px;border-bottom:1px solid var(--line)}.query-label{display:block;font-size:20px;font-weight:600;margin-bottom:10px}.book-filters input{box-sizing:border-box;width:100%;padding:13px 16px;border:1px solid #a9b8a7;border-radius:3px;background:#fffef9;color:var(--ink);font-size:16px}.filter-row{display:flex;gap:14px;align-items:end;flex-wrap:wrap;margin-top:14px}.filter-row label{font-size:12px;color:var(--muted);display:grid;gap:4px}.filter-row select{max-width:210px;border:1px solid #c9d0c3;border-radius:3px;background:var(--paper);color:var(--ink);font-size:14px;padding:8px}.filter-row button{font-size:13px;color:var(--green);border:0;background:none;padding:10px}#culture-result-count{font-size:12px;color:var(--muted);margin:12px 0 0}#culture-empty{padding:36px 0}
  .book-chapter{scroll-margin-top:20px;padding:40px 0 8px}.chapter-heading{display:flex;gap:20px;align-items:start;margin-bottom:24px}.chapter-number{font-family:Georgia,serif;font-size:44px;color:#a98d60;line-height:1.2}.chapter-heading h2{font-family:'Noto Serif SC','SimSun',serif;font-size:29px;font-weight:600;margin:0 0 8px;line-height:1.4}.chapter-heading .eyebrow{font-size:11px;margin:0 0 8px}.chapter-heading p:last-child{font-size:14px;color:var(--muted);margin:0}.chapter-visual{background:#f1f2e8;border:1px solid var(--line);padding:14px 18px;margin-bottom:12px}.chapter-visual img{max-width:640px;margin:auto}.chapter-visual figcaption{text-align:center;margin-top:8px}.knowledge-entry{padding:27px 0 25px;border-bottom:1px solid var(--line);scroll-margin-top:25px}.knowledge-entry:target{background:#f4f0df;box-shadow:0 0 0 12px #f4f0df}.entry-label{display:flex;align-items:center;gap:12px;font-size:11px;color:var(--muted);letter-spacing:.04em}.entry-label a{margin-left:auto;font-size:16px}.knowledge-entry h3{font-size:21px;line-height:1.5;font-weight:600;margin:7px 0 10px}.short-answer{margin:0 0 13px;color:#324a3b}.knowledge-entry summary{list-style:none;cursor:pointer;font-size:13px;color:var(--green);padding:8px 0}.knowledge-entry summary::-webkit-details-marker{display:none}.knowledge-entry summary span{float:right}.knowledge-entry details[open]>summary span{transform:rotate(45deg)}.entry-explanation{color:#4a594f;font-size:15px}.comparison{margin:18px 0;background:#f1f3e9;border-left:3px solid #819b72}.comparison>div{display:grid;grid-template-columns:minmax(100px,1fr) 2fr;gap:14px;padding:12px 16px;border-bottom:1px solid #dfe5d5;font-size:14px}.comparison>div:last-child{border-bottom:0}.comparison dt{font-weight:600}.comparison dd{margin:0}.try-it{font-size:14px;border:1px dashed #c6ccb6;padding:14px 16px}.try-it b,.scope-note b{display:block;font-size:12px;letter-spacing:.04em;margin-bottom:5px}.scope-note{font-size:13px;color:#6e614b;background:#f5efdf;padding:14px 16px}.entry-sources{list-style:none;padding:0;margin:20px 0 0;font-size:12px}.entry-sources li{margin:10px 0}.entry-sources small{display:block;color:var(--muted);font-size:11px}.little-challenge{border-block:1px solid var(--line);font-size:14px}.book-end{padding:50px 0 0}.book-end h2{font-size:30px}.book-end p:not(.eyebrow){font-size:13px;color:var(--muted)}.book-end>div{display:flex;gap:25px;flex-wrap:wrap;font-size:14px}
  dialog{box-sizing:border-box;max-width:740px;width:calc(100% - 32px);max-height:90vh;overflow:auto;border:1px solid #b8c5b0;border-radius:5px;padding:30px;background:var(--paper);color:var(--ink);font:inherit}dialog::backdrop{background:#172b22a8}.quiz-heading{display:flex;justify-content:space-between;gap:15px;align-items:start}.quiz-heading h2{font-size:25px;margin:0;line-height:1.5}.quiz-heading button{border:1px solid var(--line);background:transparent;color:var(--green);border-radius:50%;width:44px;height:44px;flex-shrink:0;font-size:28px;line-height:1}dialog>p{font-size:14px}fieldset{border:0;border-top:1px solid var(--line);padding:20px 0;margin:20px 0}legend{font-size:16px;font-weight:600;padding-right:10px}fieldset label{display:flex;align-items:start;gap:10px;padding:10px 12px;background:#f0f1e7;margin:8px 0;border:1px solid transparent;font-size:15px;cursor:pointer}fieldset label:has(input:checked){border-color:#638569;background:#e7efdf}fieldset input{margin-top:6px;accent-color:var(--green)}.quiz-explanation{font-size:14px;color:#38503d;padding:14px;background:#e7efdf}.quiz-actions{display:flex;gap:18px;align-items:center}.quiz-actions button:last-child{border:0;background:none;color:var(--green);font-size:14px;padding:12px}#culture-quiz-result{font-weight:600;font-size:15px}[hidden]{display:none!important}
  @media(max-width:900px){.book-hero{gap:24px}.book-layout{grid-template-columns:180px minmax(0,1fr);gap:30px}.book-hero h1{font-size:45px}.desktop-break{display:none}}
  @media(max-width:700px){.culture-book{padding:0 20px 50px;font-size:16px}.book-top{font-size:12px;padding:18px 0;gap:12px}.book-top div{gap:12px;flex-wrap:wrap;justify-content:end}.book-top div a:last-child{display:none}.book-hero{display:block;padding:36px 0 26px}.book-hero h1{font-size:42px}.hero-intro{font-size:15px}.hero-figure{margin-top:26px;padding:12px}.hero-actions{gap:18px}.book-meta{line-height:1.8}.reading-guide{grid-template-columns:1fr;gap:14px;padding:20px 0;font-size:13px}.book-layout{display:block;padding-top:28px}.book-contents{position:static;margin-bottom:25px}.book-contents nav{display:grid;grid-template-columns:1fr 1fr;gap:1px 12px}.book-contents nav a{font-size:12px;padding:6px 0}.book-contents nav span{width:23px}.side-link{margin-top:15px;padding-top:12px}.query-label{font-size:19px}.filter-row{gap:10px}.filter-row select{max-width:166px;font-size:12px;padding:8px 5px}.filter-row button{font-size:12px}.book-chapter{padding-top:30px}.chapter-heading{gap:14px}.chapter-heading h2{font-size:26px}.chapter-number{font-size:34px}.chapter-heading p:last-child{font-size:13px}.chapter-visual{padding:12px 0}.chapter-visual figcaption{padding:0 12px;text-align:left;font-size:11px}.knowledge-entry h3{font-size:20px}.comparison>div{grid-template-columns:1fr;gap:4px;font-size:14px}.knowledge-entry:target{box-shadow:0 0 0 7px #f4f0df}dialog{padding:20px}.quiz-heading h2{font-size:21px}.quiz-actions{gap:10px}.primary-link{font-size:14px;padding:10px 15px}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
