---
import Base from '../../layouts/Base.astro'
import {
  alphabetPhonics,
  shortVowelFamilies,
  magicERules,
  consonantDigraphs,
  sightWords50
} from '../../data/englishPhonicsData.js'

const base = import.meta.env.BASE_URL
---

<Base title="小学英语自然拼读与趣味单词王国 · 亲子英语启蒙乐园" wide={true}>
  <div class="phonics-container">
    <!-- 顶部导航与品牌区 -->
    <header class="phonics-header">
      <div class="phonics-nav-bar">
        <a href={base} class="phonics-back-btn">← 返回【十丘】知识总门户</a>
        <div class="phonics-nav-links">
          <a href={`${base}english/`} class="phonics-sub-nav">📚 小学英语 1~6 年级课程</a>
          <a href={`${base}math/games/`} class="phonics-sub-nav">🧮 数学思维乐园</a>
          <a href={`${base}astronomy/`} class="phonics-sub-nav">🌌 浩瀚星空长卷</a>
          <a href={`${base}science/`} class="phonics-sub-nav">🚀 华夏科学探索</a>
          <a href={`${base}chinese/poems/`} class="phonics-sub-nav">🎙️ 国学古诗点读</a>
        </div>
      </div>

      <div class="phonics-hero">
        <div class="phonics-title-wrap">
          <span class="phonics-badge">🔤 见词能读 · 听音能写 · 零基础自然拼读乐园</span>
          <h1 class="phonics-main-title">小学英语自然拼读与趣味单词王国</h1>
          <p class="phonics-subtitle">26 字母自然发音 · 5 大短元音词族 · Magic E 魔法长元音 · 复合辅音 · 50 高频词 · 互动拼词实验室</p>
        </div>

        <div class="phonics-top-actions">
          <button id="btn-open-phonics-quiz" class="phonics-btn phonics-btn-purple">
            <span class="btn-icon">🏆</span> 自然拼读趣味闯关
          </button>
        </div>
      </div>

      <!-- 四重视角切换控制器 -->
      <div class="phonics-controls-deck">
        <div class="phonics-view-switcher">
          <button id="tab-alphabet" class="phonics-view-tab active" data-view="alphabet">
            <span class="tab-icon">🔤</span> 26 字母发音律
          </button>
          <button id="tab-families" class="phonics-view-tab" data-view="families">
            <span class="tab-icon">🧩</span> 5 大短元音词族 & 拼词台
          </button>
          <button id="tab-magice" class="phonics-view-tab" data-view="magice">
            <span class="tab-icon">✨</span> Magic E 魔法 & 复合辅音
          </button>
          <button id="tab-sightwords" class="phonics-view-tab" data-view="sightwords">
            <span class="tab-icon">🚀</span> 50 个核心高频词 (Sight Words)
          </button>
        </div>
      </div>
    </header>

    <!-- 视角一：26 字母自然发音律 (Alphabet View) -->
    <section id="view-alphabet" class="phonics-section view-pane active">
      <div class="section-intro-banner">
        <h2>🔤 26 个英文字母自然拼读发音口诀与纯正音律</h2>
        <p>英语每个字母都有两个属性：<strong>Letter Name（字母名）</strong>和 <strong>Letter Sound（字母音/自然发音）</strong>。学会字母音，80% 的英文单词都能直接拼读出来！点击卡片听纯正原声发音：</p>
      </div>

      <div class="alphabet-grid">
        {alphabetPhonics.map(item => (
          <div class="letter-card" data-letter={item.letter}>
            <div class="letter-top">
              <span class="letter-big">{item.letter}</span>
              <span class="letter-icon">{item.icon}</span>
            </div>
            <div class="letter-sounds">
              <span class="sound-chip name-chip">名: {item.name}</span>
              <span class="sound-chip phonics-chip">音: {item.sound}</span>
            </div>
            <div class="letter-word-row">
              <strong class="target-word">{item.word}</strong>
              <span class="word-zh">{item.zh}</span>
            </div>
            <p class="letter-chant">🎵 {item.chant}</p>
            <button class="btn-speak-word speak-mini-btn" data-word={`${item.word}. ${item.chant}`}>
              🔊 点击发音
            </button>
          </div>
        ))}
      </div>
    </section>

    <!-- 视角二：5 大短元音词族与互动拼词实验室 (Families & Word Builder View) -->
    <section id="view-families" class="phonics-section view-pane hidden">
      <div class="section-intro-banner">
        <h2>🧩 5 大短元音词族 (Word Families) 与互动拼词实验室</h2>
        <p>短元音 a, e, i, o, u 是英语音标的基石。通过更换开头的首辅音（Onset），保留相同的词尾（Rime），就能如拼积木般轻松掌握整组单词！</p>
      </div>

      <!-- 互动拼词实验室 (Interactive Word Builder) -->
      <div class="word-builder-lab">
        <div class="lab-head">
          <span class="lab-badge">🛠️ 互动拼词积木实验室</span>
          <h3>动动小手，拼出新单词！</h3>
          <p>从左边选一个【首辅音】，右边选一个【短元音词尾】，看看会组合出什么神奇的单词：</p>
        </div>

        <div class="builder-interactive-stage">
          <div class="builder-columns-row">
            <!-- 左侧辅音选区 -->
            <div class="builder-column">
              <div class="col-title">① 选择首辅音 (Onset)</div>
              <div class="builder-buttons-wrap">
                {['b', 'c', 'd', 'f', 'h', 'm', 'p', 'r', 's', 't', 'w'].map((c, i) => (
                  <button class={`builder-onset-btn ${c === 'c' ? 'active' : ''}`} data-onset={c}>
                    {c}
                  </button>
                ))}
              </div>
            </div>

            <!-- 加号 -->
            <div class="builder-plus">+</div>

            <!-- 右侧词族选区 -->
            <div class="builder-column">
              <div class="col-title">② 选择词尾族 (Rime)</div>
              <div class="builder-buttons-wrap">
                {['-at', '-an', '-ap', '-en', '-et', '-ig', '-in', '-op', '-ot', '-ug', '-un'].map((r, i) => (
                  <button class={`builder-rime-btn ${r === '-at' ? 'active' : ''}`} data-rime={r}>
                    {r}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- 拼装成果展示区 -->
          <div class="builder-result-deck">
            <div class="result-left">
              <span id="builder-result-icon" class="result-icon">🐱</span>
              <div>
                <h4 id="builder-result-word" class="result-word">cat</h4>
                <div id="builder-result-meaning" class="result-meaning">✨ 释义：小猫</div>
              </div>
            </div>
            <button id="builder-btn-speak" class="builder-speak-btn">🔊 朗读拼词</button>
          </div>
        </div>
      </div>

      <!-- 5 大短元音词族清单 -->
      <div class="sub-block-title" style="margin-top: 3.5rem;">
        <span class="block-num">01</span>
        <h3>5 大短元音词族全谱系</h3>
      </div>
      <div class="vowels-families-deck">
        {shortVowelFamilies.map(v => (
          <div class="vowel-family-group" style={`--vowel-color: ${v.color}`}>
            <div class="vowel-head-row">
              <div class="vowel-title-box">
                <span class="vowel-name">{v.vowel}</span>
                <span class="vowel-sound-badge">发音: {v.sound}</span>
              </div>
            </div>

            <div class="families-sub-grid">
              {v.families.map(fam => (
                <div class="family-card">
                  <div class="family-pattern-head">{fam.pattern} 家族</div>
                  <div class="family-words-list">
                    {fam.words.map(w => (
                      <div class="fam-word-chip">
                        <span class="fam-word-icon">{w.icon}</span>
                        <strong class="fam-word-en">{w.en}</strong>
                        <span class="fam-word-zh">({w.zh})</span>
                        <button class="btn-speak-word speak-tiny-btn" data-word={w.en} title="发音">🔊</button>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 视角三：Magic E 魔法长元音与复合辅音 (Magic E & Digraphs) -->
    <section id="view-magice" class="phonics-section view-pane hidden">
      <div class="section-intro-banner">
        <h2>✨ 长元音 Magic E 变身魔法与核心复合辅音</h2>
        <p>静音 e 悄悄飞到单词末尾，前面的短元音立刻被注入魔力，变身成发字母名的高傲长元音！辅音小伙伴两两牵手（如 sh, ch, th），发出全新独特的奇妙声音：</p>
      </div>

      <!-- 1. Magic E 展台 -->
      <div class="sub-block-title">
        <span class="block-num">02</span>
        <h3>Magic E 魔法变身实验室 (点击开关见证蜕变)</h3>
      </div>
      <div class="magice-grid">
        {magicERules.map(rule => (
          <div class="magice-rule-card">
            <div class="magice-rule-head">
              <span class="magice-pattern">{rule.pattern} 魔法</span>
              <span class="magice-sound-shift">{rule.shortSound} ➔ {rule.longSound}</span>
            </div>
            <p class="magice-rule-desc">💡 {rule.ruleDesc}</p>

            <div class="magice-pairs-deck">
              {rule.pairs.map(p => (
                <div class="magic-e-card" data-short={p.shortWord} data-long={p.longWord}>
                  <div class="pair-state short-state">
                    <span class="pair-icon">{p.shortIcon}</span>
                    <span class="pair-word">{p.shortWord}</span>
                    <span class="pair-zh">{p.shortZh}</span>
                  </div>
                  <div class="pair-arrow">➔</div>
                  <div class="pair-state long-state">
                    <span class="pair-icon">{p.longIcon}</span>
                    <span class="pair-word">{p.longWord}</span>
                    <span class="pair-zh">{p.longZh}</span>
                  </div>
                  <button class="magic-e-toggle-btn">✨ 施展 Magic E</button>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- 2. 复合辅音展台 -->
      <div class="sub-block-title" style="margin-top: 3.5rem;">
        <span class="block-num">03</span>
        <h3>核心复合辅音 (Consonant Digraphs)</h3>
      </div>
      <div class="digraphs-grid">
        {consonantDigraphs.map(d => (
          <div class="digraph-card">
            <div class="digraph-head">
              <span class="digraph-letters">{d.digraph}</span>
              <span class="digraph-sound">{d.sound}</span>
            </div>
            <div class="digraph-action">动作联想：{d.action}</div>
            <div class="digraph-words-grid">
              {d.words.map(w => (
                <div class="digraph-word-chip">
                  <span class="chip-icon">{w.icon}</span>
                  <strong>{w.en}</strong>
                  <span class="chip-zh">{w.zh}</span>
                  <button class="btn-speak-word speak-tiny-btn" data-word={w.en}>🔊</button>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 视角四：50 个核心高频词 (Sight Words View) -->
    <section id="view-sightwords" class="phonics-section view-pane hidden">
      <div class="section-intro-banner">
        <h2>🚀 小学必备 50 个高频词 (Sight Words) 翻转记忆墙</h2>
        <p>Sight Words 是英语儿童读物中占据 50% 以上版面的基石词汇。无需拆分拼读，一眼看去即可脱口而出！点击卡片听纯正原声与实用例句：</p>
      </div>

      <!-- 等级筛选栏 -->
      <div class="sight-filter-bar">
        <button class="sight-level-btn active" data-level="all">全部 50 词</button>
        <button class="sight-level-btn" data-level="1">Level 1 (极高频启蒙)</button>
        <button class="sight-level-btn" data-level="2">Level 2 (基础句型)</button>
        <button class="sight-level-btn" data-level="3">Level 3 (日常交际)</button>
        <button class="sight-level-btn" data-level="4">Level 4 (进阶叙事)</button>
        <button class="sight-level-btn" data-level="5">Level 5 (连贯表达)</button>
      </div>

      <!-- 50 词卡片网格 -->
      <div class="sight-words-grid">
        {sightWords50.map(sw => (
          <div class="sight-word-card" data-level={String(sw.level)}>
            <div class="sw-top">
              <span class="sw-level-badge">L{sw.level}</span>
              <button class="btn-speak-word sw-speak-btn" data-word={`${sw.word}. ${sw.sentence}`}>🔊</button>
            </div>
            <h3 class="sw-word">{sw.word}</h3>
            <div class="sw-zh">{sw.zh}</div>
            <div class="sw-sentence-box">
              <p class="sw-sentence-en">"{sw.sentence}"</p>
              <p class="sw-sentence-zh">{sw.sentenceZh}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 模态弹窗：自然拼读趣味闯关 (Quiz Modal) -->
    <div id="phonics-quiz-modal" class="phonics-modal hidden">
      <div class="modal-overlay"></div>
      <div class="modal-card">
        <div class="modal-header">
          <div>
            <span class="modal-tag">英语通关</span>
            <h3 class="modal-title">🏆 自然拼读趣味大闯关</h3>
          </div>
          <button id="phonics-quiz-close" class="modal-close-btn">&times;</button>
        </div>
        <div id="phonics-quiz-body" class="modal-body"></div>
      </div>
    </div>
  </div>

  <script src="../../client/english-phonics-ui.js"></script>
</Base>

<style>
  .phonics-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 1.5rem 1rem 5rem;
    color: #f8fafc;
  }

  /* 顶部导航与品牌栏 */
  .phonics-header {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.95));
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid rgba(244, 114, 182, 0.2);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.5);
    margin-bottom: 2.5rem;
  }

  .phonics-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 2rem;
  }

  .phonics-back-btn {
    font-size: 0.95rem;
    color: #f472b6;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }
  .phonics-back-btn:hover {
    color: #fbcfe8;
  }

  .phonics-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .phonics-sub-nav {
    font-size: 0.85rem;
    color: #cbd5e1;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    transition: all 0.2s;
  }
  .phonics-sub-nav:hover {
    background: rgba(244, 114, 182, 0.2);
    color: #fff;
  }

  /* 英雄区 */
  .phonics-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .phonics-badge {
    display: inline-block;
    background: rgba(244, 114, 182, 0.2);
    border: 1px solid rgba(244, 114, 182, 0.4);
    color: #f472b6;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  .phonics-main-title {
    font-size: 2.3rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #ffffff 30%, #f472b6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .phonics-subtitle {
    font-size: 1rem;
    color: #94a3b8;
    margin: 0;
  }

  .phonics-top-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .phonics-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }
  .phonics-btn-purple {
    background: linear-gradient(135deg, #db2777, #9333ea);
    color: #fff;
    box-shadow: 0 4px 14px rgba(219, 39, 119, 0.3);
  }
  .phonics-btn-purple:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }

  /* 视窗切换栏 */
  .phonics-controls-deck {
    display: flex;
    justify-content: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.5rem;
  }

  .phonics-view-switcher {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    background: rgba(15, 23, 42, 0.7);
    padding: 0.4rem;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .phonics-view-tab {
    background: transparent;
    border: none;
    color: #94a3b8;
    padding: 0.7rem 1.3rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .phonics-view-tab:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.06);
  }
  .phonics-view-tab.active {
    background: linear-gradient(135deg, #ec4899, #8b5cf6);
    color: #fff;
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.4);
  }

  /* 通栏介绍 */
  .section-intro-banner {
    background: rgba(30, 41, 59, 0.6);
    border-left: 4px solid #f472b6;
    border-radius: 12px;
    padding: 1.2rem 1.5rem;
    margin-bottom: 2rem;
  }
  .section-intro-banner h2 {
    font-size: 1.35rem;
    margin: 0 0 0.4rem;
    color: #e2e8f0;
  }
  .section-intro-banner p {
    margin: 0;
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .sub-block-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }
  .block-num {
    background: linear-gradient(135deg, #ec4899, #8b5cf6);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 8px;
  }
  .sub-block-title h3 {
    font-size: 1.3rem;
    margin: 0;
    color: #f1f5f9;
  }

  /* 26 字母网格 */
  .alphabet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.2rem;
    margin-bottom: 2.5rem;
  }
  .letter-card {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.4rem;
    transition: all 0.2s;
  }
  .letter-card:hover {
    border-color: #f472b6;
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }
  .letter-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }
  .letter-big {
    font-size: 2rem;
    font-weight: 800;
    color: #f472b6;
  }
  .letter-icon {
    font-size: 2rem;
  }
  .letter-sounds {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .sound-chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-weight: 600;
  }
  .name-chip {
    background: rgba(59, 130, 246, 0.2);
    color: #93c5fd;
  }
  .phonics-chip {
    background: rgba(16, 185, 129, 0.2);
    color: #6ee7b7;
  }
  .letter-word-row {
    margin-bottom: 0.5rem;
  }
  .target-word {
    font-size: 1.2rem;
    color: #fff;
    margin-right: 0.4rem;
  }
  .word-zh {
    font-size: 0.9rem;
    color: #94a3b8;
  }
  .letter-chant {
    font-size: 0.85rem;
    color: #cbd5e1;
    margin: 0 0 1rem;
    line-height: 1.4;
  }
  .speak-mini-btn {
    width: 100%;
    background: rgba(244, 114, 182, 0.15);
    border: 1px solid rgba(244, 114, 182, 0.3);
    color: #fbcfe8;
    padding: 0.5rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .speak-mini-btn:hover {
    background: #ec4899;
    color: #fff;
