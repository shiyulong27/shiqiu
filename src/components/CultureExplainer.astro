---
const { entryId } = Astro.props;
const hours = ['23:00—次日01:00','01:00—03:00','03:00—05:00','05:00—07:00','07:00—09:00','09:00—11:00','11:00—13:00','13:00—15:00','15:00—17:00','17:00—19:00','19:00—21:00','21:00—23:00'];
const branches = ['子','丑','寅','卯','辰','巳','午','未','申','酉','戌','亥'];
const branchReadings = ['zǐ','chǒu','yín','mǎo','chén','sì','wǔ','wèi','shēn','yǒu','xū','hài'];
const animals = ['鼠','牛','虎','兔','龙','蛇','马','羊','猴','鸡','狗','猪'];
const points = [[160,60],[270,145],[230,275],[90,275],[50,145]];
const labels = ['木','火','土','金','水'];
const order = entryId === 'TC06-04' ? [0,2,4,1,3] : [0,1,2,3,4];
const titleId = `explainer-${entryId}`;
const arrowId = `arrow-${entryId}`;
const supported = ['TC01-06','TC02-01','TC02-07','TC02-10','TC03-13','TC04-09','TC05-01','TC06-03','TC06-04','TC06-05','TC06-09','TC07-10','TC07-15','TC08-07','TC08-11'];
---
{supported.includes(entryId) && <figure class="culture-explainer">
  {entryId==='TC02-01' && <div class="turn-map"><h4>你来转一转整张地图</h4><button type="button" data-turn-map-button aria-pressed="false">整图转半圈</button><svg viewBox="0 0 320 320" data-turn-map role="img" aria-label="有北箭头的地图：学校在公园北面；整图旋转不会改变两地地理关系"><circle cx="160" cy="160" r="112" fill="#e4ecd9"/><path d="M160 66V254M66 160H254" stroke="#718566" stroke-width="2"/><g font-size="18" fill="#2f4c37" text-anchor="middle"><text x="160" y="35">北 ↑</text><text x="160" y="300">南</text><text x="25" y="167">西</text><text x="295" y="167">东</text></g><rect x="118" y="83" width="84" height="40" rx="8" fill="#dcc184"/><rect x="118" y="197" width="84" height="40" rx="8" fill="#b9cfab"/><g font-size="19" fill="#2f4c37" text-anchor="middle"><text x="160" y="110">学校</text><text x="160" y="224">公园</text></g></svg><p data-turn-map-status role="status">北在画面上方；学校在公园北面。</p></div>}
  {entryId==='TC02-07' && <><h4>十二时辰 · 常用钟表对照</h4><p class="hint">从子时起，依次向后读。子时跨过午夜。</p><ol class="time-grid">{branches.map((b,i)=><li><b>{b}时</b><small>{branchReadings[i]}</small><span>{hours[i]}</span>{i===0&&<small>跨日的这一格</small>}</li>)}</ol></>}
  {entryId==='TC02-10' && <><h4>两种日历，关注的周期不同</h4><div class="concept-grid"><div><b>公历 · 阳历</b><p>主要协调一年的时序<br/>闰年多一天</p></div><div><b>中国农历 · 阴阳合历</b><p>月相安排月份<br/>也协调节气与季节</p></div><div><b>农历置闰月</b><p>某些年份增加一个月<br/>不是公历多一天</p></div></div><p class="hint">“朔→上弦附近→望→下弦附近→再到朔”只表示月相顺序，不是每月固定日期换算表。</p></>}
  {['TC06-03','TC06-04'].includes(entryId) && <><h4>五行{entryId==='TC06-04'?'相克':'相生'} · 传统观念图</h4><svg viewBox="0 0 320 350" role="img" aria-labelledby={titleId}><title id={titleId}>{order.map(i=>labels[i]).join('、')}，最后回到木；箭头表示传统相{entryId==='TC06-04'?'克':'生'}，不是科学因果</title><defs><marker id={arrowId} markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0L7 3.5L0 7Z" fill="#6d805b"/></marker></defs>{order.map((from,i)=>{const to=order[(i+1)%5];const [x1,y1]=points[from];const[x2,y2]=points[to];const len=Math.hypot(x2-x1,y2-y1);return <line x1={x1+(x2-x1)*34/len} y1={y1+(y2-y1)*34/len} x2={x2-(x2-x1)*38/len} y2={y2-(y2-y1)*38/len} stroke="#6d805b" stroke-width="2.5" marker-end={`url(#${arrowId})`}/>})}{points.map(([x,y],i)=><g><circle cx={x} cy={y} r="29" fill="#e3ead4" stroke="#a6b48f"/><text x={x} y={y+8} text-anchor="middle" font-size="24" fill="#2f4c37">{labels[i]}</text></g>)}<text x="160" y="336" text-anchor="middle" font-size="13" fill="#5e684f">箭头：{order.map(i=>labels[i]).join(' → ')} → 木</text></svg><p class="hint">箭头有方向；不用于判断身体、颜色、属相或命运。</p></>}
  {entryId==='TC06-05' && <><h4>四方与四象 · 北向朝上示意</h4><div class="four-directions"><div class="north">北 ↑<b>玄武</b></div><div class="west">西<b>白虎</b></div><div class="east">东<b>青龙</b></div><div class="south">南<b>朱雀</b></div></div><p class="hint">文字关系图，不是实际动物或现代星空照片。</p></>}
  {entryId==='TC06-09' && <><h4>十二地支与生肖 · 文化对应</h4><ol class="zodiac-grid">{branches.map((b,i)=><li><span>{b}</span><b>{animals[i]}</b></li>)}</ol><p class="hint">龙是传说形象；这套对应不预测人的性格与命运。</p></>}
  {entryId==='TC07-10' && <><h4>先找中央庭院 · 简化平面图</h4><svg viewBox="0 0 320 320" role="img" aria-labelledby={titleId}><title id={titleId}>北向朝上，四面房屋围合中央庭院，示意门放在下边；不是具体古建复原</title><rect x="55" y="40" width="210" height="65" fill="#d9dfcb"/><rect x="55" y="215" width="210" height="60" fill="#d9dfcb"/><rect x="20" y="115" width="65" height="90" fill="#e8dcbf"/><rect x="235" y="115" width="65" height="90" fill="#e8dcbf"/><rect x="100" y="120" width="120" height="85" fill="#f8f6e7" stroke="#b9c6a1" stroke-dasharray="5 4"/><g text-anchor="middle" font-size="17" fill="#2f4c37"><text x="160" y="25">北 ↑</text><text x="160" y="79">房屋</text><text x="160" y="252">房屋</text><text x="52" y="165">房屋</text><text x="268" y="165">房屋</text><text x="160" y="166">庭院</text></g><path d="M145 275H175" stroke="#a36e37" stroke-width="7"/><text x="160" y="307" text-anchor="middle" font-size="14" fill="#5e684f">门位仅为本教学图示例，不按比例</text></svg></>}
  {entryId==='TC04-09' && <><h4>九族两说，各自怎样数？</h4><div class="concept-grid"><div><b>九代关系示意</b><p>高祖 → 曾祖 → 祖 → 父<br/>→ 我 → 子 → 孙 → 曾孙 → 玄孙</p></div><div><b>另一种分类思路</b><p>父族四 ＋ 母族三 ＋ 妻族二</p></div></div><p class="hint">两类历史解释，不是现代家庭必须长成的样子；图中旧称只用于理解文献。</p></>}
  {entryId==='TC01-06' && <><h4>从古名到熟悉的食材</h4><div class="grain-grid"><div><svg viewBox="0 0 100 80" aria-hidden="true"><path d="M50 70V10M50 25L25 15M50 35L76 25M50 48L26 38" stroke="#869768" stroke-width="3" fill="none"/><g fill="#d5b16d"><ellipse cx="24" cy="16" rx="7" ry="12" transform="rotate(-35 24 16)"/><ellipse cx="76" cy="27" rx="7" ry="12" transform="rotate(35 76 27)"/><ellipse cx="26" cy="40" rx="7" ry="12" transform="rotate(-35 26 40)"/></g></svg><b>稻 → 米</b></div><div><svg viewBox="0 0 100 80" aria-hidden="true"><path d="M50 75V8" stroke="#869768" stroke-width="3"/>{[20,35,50].map(y=><g fill="#d5b16d"><ellipse cx="40" cy={y} rx="7" ry="12" transform={`rotate(-40 40 ${y})`}/><ellipse cx="60" cy={y} rx="7" ry="12" transform={`rotate(40 60 ${y})`}/></g>)}</svg><b>麦 → 面粉等</b></div><div><svg viewBox="0 0 100 80" aria-hidden="true"><path d="M22 53Q17 17 53 23Q83 21 77 57Q49 77 22 53Z" fill="#d9c590"/><path d="M43 31Q66 41 47 59" stroke="#a58b52" stroke-width="3" fill="none"/></svg><b>菽（shū）→ 豆类</b></div></div><p class="hint">原创概念插画，比例与形态均作简化，不用于植物鉴定。黍、稷的古名对应要结合具体文献；遇不认识的种子不尝、不采食。</p></>}
  {entryId==='TC03-13' && <><h4>看动作，先分手部与身体</h4><div class="concept-grid"><div><b>抱拳</b><p>一手握拳<br/>另一手包住拳头</p><svg viewBox="0 0 160 100" aria-hidden="true"><rect x="67" y="32" width="42" height="42" rx="12" fill="#d6b97c"/><path d="M30 80L52 53Q57 29 72 30L110 45Q125 56 111 76L80 83L61 72" stroke="#6b8062" stroke-width="8" fill="none"/></svg></div><div><b>作揖</b><p>手部致意<br/>配合躬身行礼</p><svg viewBox="0 0 160 100" aria-hidden="true"><circle cx="90" cy="20" r="12" fill="#d6b97c"/><path d="M79 35L60 62L45 90M64 53L97 68L111 58" stroke="#6b8062" stroke-width="8" fill="none"/></svg></div></div><p class="hint">自制动作概念示意，不是某一朝代或武术礼仪的标准动作教学，不规定统一左右手。</p></>}
  {entryId==='TC05-01' && <><h4>年里的一条节期线 · 不按天数比例</h4><ol class="festival-line">{[['腊八','农历十二月初八'],['小年','日期因地而异'],['除夕','旧年最后一晚'],['春节','新年节期与社会实践'],['元宵','农历正月十五']].map(([a,b])=><li><b>{a}</b><span>{b}</span></li>)}</ol><p class="hint">这些名称的范围与活动不完全相同；冬至、清明等节气不应固定到某个农历日号。</p></>}
  {entryId==='TC07-15' && <><h4>遇到古代价格，先补四张信息卡</h4><div class="concept-grid"><div><b>何时、何地</b><p>同名货币跨时代不一定等值</p></div><div><b>什么单位、成色</b><p>计数还是称量，采用哪种制度</p></div><div><b>买什么、收入多少</b><p>具体商品与同一情境的比较</p></div></div><p class="hint">缺少这些证据，不给“一两银子＝固定人民币”的换算结论。</p></>}
  {entryId==='TC08-07' && <><h4>同一片叶 · 两种观察画法</h4><div class="concept-grid art-comparison"><div><svg viewBox="0 0 160 130" role="img" aria-label="左叶细描轮廓和叶脉的原创示意"><path d="M25 112Q0 28 136 12Q140 110 25 112Z" fill="#eef1df" stroke="#5a7759" stroke-width="2"/><path d="M20 120L131 16M48 91L29 59M65 75L55 38M80 59L85 26M48 91L89 99M65 75L109 78M80 59L126 54" stroke="#5a7759" fill="none"/></svg><b>看细节</b><p>细描轮廓、叶脉</p></div><div><svg viewBox="0 0 160 130" role="img" aria-label="右叶以少量宽笔画概括叶形的原创示意"><path d="M31 103Q50 44 123 25Q104 91 31 103" stroke="#68835d" stroke-width="19" stroke-linecap="round" opacity=".7" fill="none"/><path d="M20 118L125 25" stroke="#36563d" stroke-width="4"/></svg><b>抓姿态</b><p>用较少笔墨概括</p></div></div><p class="hint">原创练习示意，帮助比较观察重点；不是历史画作，不代替工笔、写意的完整技法教学。</p></>}
  {entryId==='TC08-11' && <><h4>六种乐器 · 先看形与动作</h4><div class="instrument-grid">
    <div><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M12 39Q42 27 145 40V74Q47 87 12 74Z" fill="#d0b07b"/>{Array.from({length:7},(_,i)=><line x1="18" y1={43+i*4} x2="141" y2={43+i*4} stroke="#5b684b" stroke-width=".8"/>)}{[28,38,48,58,68,78,88,98,108,116,124,132,138].map(x=><circle cx={x} cy="35" r="1.5" fill="#57704a"/>)}</svg><b>古琴 · 弹拨</b><p>看长条琴体、弦与徽</p></div>
    <div><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M10 30Q75 20 149 40V84Q70 96 10 76Z" fill="#d0b07b"/>{[38,47,56,65,74].map((y,i)=><g><line x1="16" y1={y} x2="144" y2={y+4} stroke="#5b684b" stroke-width="1"/><path d={`M${48+i*12} ${y+2}l7 -10l7 10Z`} fill="#57704a"/></g>)}</svg><b>筝 · 弹拨</b><p>看承托琴弦的琴柱</p></div>
    <div><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M75 11H85V45Q120 74 106 96Q80 115 54 96Q40 74 75 45Z" fill="#d0b07b" stroke="#72805a"/>{[76,79,82,85].map(x=><line x1={x} y1="15" x2={x} y2="94" stroke="#5b684b" stroke-width=".8"/>)}</svg><b>琵琶 · 弹拨</b><p>看梨形共鸣箱</p></div>
    <div><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M70 10V92M79 10V92" stroke="#788259" stroke-width="2"/><path d="M67 7H83V17H67ZM56 79L79 73L96 84V102L73 109L56 98Z" fill="#b99b66"/><path d="M27 60L139 88" stroke="#415c40" stroke-width="5"/></svg><b>二胡 · 拉弦</b><p>看琴筒与弓</p></div>
    <div><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M15 46H145V65H15Z" fill="#d0b07b"/>{[37,56,70,84,98,112].map(x=><circle cx={x} cy="55" r="3" fill="#53714c"/>)}</svg><b>笛 · 多为横吹</b><p>观察吹奏姿势</p></div>
    <div><svg viewBox="0 0 160 115" aria-hidden="true"><rect x="72" y="9" width="15" height="100" rx="4" fill="#d0b07b"/>{[34,47,60,73,86].map(y=><circle cx="79" cy={y} r="2.6" fill="#53714c"/>)}</svg><b>箫 · 常见直吹</b><p>观察单管与吹口</p></div>
  </div><p class="hint">原创线索示意，不按比例，弦线、音孔和部件均作简化，不表示实际数量；不是古代实物复原或制作图。</p></>}
  <figcaption>本项目原创教学图；事实边界与出处见本条文字。</figcaption>
</figure>}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-turn-map-button]').forEach(button=>button.addEventListener('click',()=>{
    const turned=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',String(turned));button.textContent=turned?'恢复北向朝上':'整图转半圈';
    const box=button.closest('.turn-map')!;(box.querySelector('[data-turn-map]') as SVGElement).style.transform=turned?'rotate(180deg)':'rotate(0deg)';
    box.querySelector('[data-turn-map-status]')!.textContent=turned?'北在画面下方；学校仍在公园北面。':'北在画面上方；学校在公园北面。';
  }));
</script>
<style>
  .turn-map button{font:inherit;font-size:14px;border:1px solid #8ea47a;border-radius:3px;background:#faf8ee;color:#34563d;padding:9px 14px;cursor:pointer}.turn-map svg{margin:25px auto!important}.turn-map [role=status]{font-size:14px;text-align:center}
  .culture-explainer{background:#f3f4e8;border:1px solid #d7dfc7;padding:20px;margin:20px 0;color:#2f4c37;font:inherit}.culture-explainer h4{font-size:16px;margin:0 0 14px;font-weight:600}.culture-explainer p{font-size:14px;line-height:1.8}.culture-explainer svg{display:block;width:100%;max-width:350px;height:auto;margin:auto}.hint,.culture-explainer figcaption{font-size:12px!important;color:#65735b}.culture-explainer figcaption{margin-top:16px}.concept-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.concept-grid>div{background:#faf8ee;border:1px solid #dce1cf;padding:14px}.concept-grid b{font-size:14px}.concept-grid p{margin:8px 0 0}.time-grid,.zodiac-grid{padding:0;list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.time-grid li,.zodiac-grid li{padding:10px;background:#faf8ee;border:1px solid #dae0cc;text-align:center}.time-grid b,.time-grid span,.time-grid small,.zodiac-grid span,.zodiac-grid b{display:block}.time-grid b{font-size:18px}.time-grid span{font-size:11px;white-space:nowrap}.time-grid small{color:#986a31;font-size:10px}.time-grid li:first-child{border:2px solid #af9150}.zodiac-grid b{font-size:23px}.zodiac-grid span{font-size:13px}.four-directions{max-width:320px;margin:auto;display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-areas:'. north .' 'west . east' '. south .';gap:8px;text-align:center}.four-directions>div{padding:13px;background:#e4ebd7;border:1px solid #cbd8b6;font-size:14px}.four-directions b{display:block;font-size:22px}.north{grid-area:north}.west{grid-area:west}.east{grid-area:east}.south{grid-area:south}.grain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;text-align:center;font-size:13px}.grain-grid>div{background:#faf8ee;padding:10px 5px}.grain-grid svg{max-width:110px}.festival-line{list-style:none;padding:0;margin:0;border-left:2px solid #aab98d}.festival-line li{position:relative;padding:10px 0 10px 22px;display:flex;gap:20px;font-size:14px}.festival-line li:before{content:'';position:absolute;left:-6px;top:20px;width:10px;height:10px;border-radius:50%;background:#a08148}.festival-line b{min-width:45px}.art-comparison svg{max-width:170px}
  .instrument-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.instrument-grid>div{background:#faf8ee;padding:8px;text-align:center}.instrument-grid b{font-size:14px}.instrument-grid p{font-size:11px;margin:4px 0}.instrument-grid svg{max-width:160px}
  @media(max-width:700px){.culture-explainer{padding:14px 10px}.time-grid{grid-template-columns:repeat(2,1fr)}.time-grid span{font-size:12px}.zodiac-grid{grid-template-columns:repeat(3,1fr)}.concept-grid{grid-template-columns:1fr}.grain-grid{grid-template-columns:1fr}.grain-grid svg{max-width:150px}.grain-grid>div{padding:10px}.four-directions{gap:4px}.four-directions>div{padding:9px 4px}.four-directions b{font-size:20px}.festival-line li{display:block}.festival-line span{display:block;font-size:12px}.art-comparison{grid-template-columns:1fr 1fr;gap:8px}.art-comparison>div{padding:10px}.instrument-grid{grid-template-columns:1fr 1fr}}
</style>
